<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Withdrawals | UBR Esports Admin</title>
    <link rel="icon" type="image/png" href="/images/ubrLogo.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/admin/adminLayout.css">
    <link rel="stylesheet" href="/css/admin/dashboard.css">
</head>
<body>
    <div class="admin-layout">
        <%- include("../partials/sidebar") %>

        <div class="admin-main">
            <%- include("../partials/adminNav") %>

            <main class="admin-body">
                <div class="page-title-bar">
                    <div>
                        <h1 class="page-heading">Withdrawals</h1>
                        <p class="page-sub">Review and process user cash payout requests.</p>
                    </div>
                </div>

                <div class="content-card">
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Player</th>
                                    <th>Amount</th>
                                    <th>UPI ID / QR Code</th>
                                    <th>Requested At</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                    <th>Note</th>
                                </tr>
                            </thead>
                            <tbody>

                                <% for ( withdrawal of withdrawals ) { %>
                                <tr>
                                    <td><strong><%= withdrawal.playerName %></strong></td>
                                    <td><strong class="text-green" style="font-size: 1.05rem;">₹<%= withdrawal.amount %></strong></td>
                                    <td>
                                        <% if (withdrawal.payoutMethod === 'qr') { %>
                                            <a href="<%= withdrawal.payoutDetail %>" target="_blank" title="Click to view full image">
                                                <img src="<%= withdrawal.payoutDetail %>" alt="QR Code" style="max-width: 60px; max-height: 60px; border-radius: 4px; border: 1px solid #ccc; cursor: pointer; display: block;" />
                                            </a>
                                        <% } else { %>
                                            <code><%= withdrawal.payoutDetail %></code>
                                        <% } %>
                                    </td>
                                    <td><%= (withdrawal._id && withdrawal._id.getTimestamp) ? withdrawal._id.getTimestamp().toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Kolkata' }) : 'N/A' %></td>
                                    <td><span class="badge badge-yellow"><%= withdrawal.status %></span></td>
                                    <td>
                                         <% if(withdrawal.status === "approved" || withdrawal.status === "rejected") { %>
                                         <div style="display: none; gap: 0.4rem;">
                                             <button class="btn-action btn-approve"><i class="fa-solid fa-check"></i> Approve</button>
                                             <button class="btn-action btn-delete"><i class="fa-solid fa-xmark"></i> Reject</button>
                                         </div>
                                         <% } else { %>
                                          <div style="display: flex; gap: 0.4rem;">
                                             <button class="btn-action btn-approve" onclick="selectOption(this, 'approved', '<%= withdrawal._id %>');"><i class="fa-solid fa-check"></i> Approve</button>
                                             <button class="btn-action btn-delete" onclick="selectOption(this, 'rejected', '<%= withdrawal._id %>')"><i class="fa-solid fa-xmark"></i> Reject</button>
                                         </div>
                                         <% } %>
                                    </td>

                                    <td><code><%= withdrawal.note %></code></td>
                                </tr>
                                <% } %>

                            </tbody>
                        </table>
                    </div>
                </div>
            </main>

            <%- include("../partials/footer") %>
        </div>
    </div>

    <script>
        // const baseurl = 
        async function selectOption(btn, option, id) {
            const actionText = option === 'approved' ? 'approve' : 'reject';
            if (confirm(`Are you sure you want to ${actionText} this withdrawal request?`)) {
                const originalHtml = btn.innerHTML;
                const siblings = btn.parentElement.querySelectorAll('button');
                siblings.forEach(s => s.disabled = true);
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

                try {
                    const res = await fetch("<%= baseurl %>/admin/withdrawalReq", {
                        method:'POST',
                        headers:{
                            "Content-Type":"application/json"
                        },
                        body:JSON.stringify({option, id})
                    });

                    const result = await res.json();
                    alert(result.msg);
                    console.log(result);
                    window.location.reload();
                } catch(err) {
                    console.error("Error processing withdrawal:", err);
                    alert("Something went wrong");
                    siblings.forEach(s => s.disabled = false);
                    btn.innerHTML = originalHtml;
                }
            }
        }
    </script>
</body>
</html>
