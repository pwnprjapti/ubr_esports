<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Withdrawals | UBR Esports Admin</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/admin/adminLayout.css">
    <link rel="stylesheet" href="/css/admin/dashboard.css">
</head>
<body>
    <div class="admin-layout">
        <%- include("../partials/sidebar") %>

        <div class="admin-main">
            <%- include("../partials/adminNav") %>

            <main class="admin-body">
                <div class="page-title-bar">
                    <div>
                        <h1 class="page-heading">Withdrawals</h1>
                        <p class="page-sub">Review and process user cash payout requests.</p>
                    </div>
                </div>

                <div class="content-card">
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Player</th>
                                    <th>Amount</th>
                                    <th>UPI ID</th>
                                    <th>Requested At</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td><strong>Pawan</strong></td>
                                    <td><strong class="text-green" style="font-size: 1.05rem;">₹1,500</strong></td>
                                    <td><code>pawan@oksbi</code></td>
                                    <td>10 mins ago</td>
                                    <td><span class="badge badge-yellow">Pending</span></td>
                                    <td>
                                        <div style="display: flex; gap: 0.4rem;">
                                            <button class="btn-action btn-approve" onclick="this.closest('tr').remove(); alert('Approved!');"><i class="fa-solid fa-check"></i> Approve</button>
                                            <button class="btn-action btn-delete" onclick="this.closest('tr').remove(); alert('Rejected!');"><i class="fa-solid fa-xmark"></i> Reject</button>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Aman</strong></td>
                                    <td><strong class="text-green" style="font-size: 1.05rem;">₹2,000</strong></td>
                                    <td><code>aman@okaxis</code></td>
                                    <td>35 mins ago</td>
                                    <td><span class="badge badge-yellow">Pending</span></td>
                                    <td>
                                        <div style="display: flex; gap: 0.4rem;">
                                            <button class="btn-action btn-approve" onclick="this.closest('tr').remove(); alert('Approved!');"><i class="fa-solid fa-check"></i> Approve</button>
                                            <button class="btn-action btn-delete" onclick="this.closest('tr').remove(); alert('Rejected!');"><i class="fa-solid fa-xmark"></i> Reject</button>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <td><strong>Rahul Sharma</strong></td>
                                    <td><strong class="text-green" style="font-size: 1.05rem;">₹750</strong></td>
                                    <td><code>rahul@paytm</code></td>
                                    <td>1 hour ago</td>
                                    <td><span class="badge badge-yellow">Pending</span></td>
                                    <td>
                                        <div style="display: flex; gap: 0.4rem;">
                                            <button class="btn-action btn-approve" onclick="this.closest('tr').remove(); alert('Approved!');"><i class="fa-solid fa-check"></i> Approve</button>
                                            <button class="btn-action btn-delete" onclick="this.closest('tr').remove(); alert('Rejected!');"><i class="fa-solid fa-xmark"></i> Reject</button>
                                        </div>
                                    </td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>

            <%- include("../partials/footer") %>
        </div>
    </div>
</body>
</html>
