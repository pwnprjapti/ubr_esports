<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Admin Dashboard | UBR Esports</title>
    <link rel="icon" type="image/png" href="/images/ubrLogo.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/admin/adminLayout.css">
    <link rel="stylesheet" href="/css/admin/dashboard.css">
</head>
<body>
    <div class="admin-layout">
        <%- include("../partials/sidebar") %>

        <div class="admin-main">
            <%- include("../partials/adminNav") %>

            <main class="admin-body">
                <div class="page-title-bar">
                    <div>
                        <h1 class="page-heading">Dashboard</h1>
                        <p class="page-sub">Quick overview of tournaments, teams & payouts.</p>
                    </div>
                </div>

                <!-- 3 Simple Key Stats -->
                <div class="stats-row">
                    <div class="stat-card">
                        <div class="stat-icon icon-red">
                            <i class="fa-solid fa-trophy"></i>
                        </div>
                        <div class="stat-content">
                            <span class="stat-label">Categories</span>
                            <span class="stat-num"><%= categories.length %></span>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon icon-blue">
                            <i class="fa-solid fa-shield-halved"></i>
                        </div>
                        <div class="stat-content">
                            <span class="stat-label"> Users</span>
                            <span class="stat-num"><%= users.length %></span>
                        </div>
                    </div>

                    <div class="stat-card">
                        <div class="stat-icon icon-yellow">
                            <i class="fa-solid fa-wallet"></i>
                        </div>
                        <div class="stat-content">
                            <span class="stat-label">Pending Withdrawals</span>
                            <span class="stat-num"><%= withdrawal.length %></span>
                        </div>
                    </div>
                </div>

                <!-- Recent Tournaments Table -->
                <div class="content-card">
                    <div class="card-header-flex">
                        <h2 class="card-title"><i class="fa-solid fa-gamepad"></i> Active Categories</h2>
                        <a href="/admin/categories" class="btn-link">View All</a>
                    </div>

                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Tournament Name</th>
                                    <th>Date</th>
                                    <th>Slots</th>
                                    <th>Prize Pool</th>
                                    <th>IDP timings</th>
                                </tr>
                            </thead>
                            <tbody>
                                  <% for ( category of categories.slice(0, 6) ){ if( category.matches.length > 0){ %>
                                <tr>
                                    <td><strong><%= category.matches[0]?.title %></strong></td>
                                    <td><%= category.matches[0]?.date %></td>
                                    <td><%= category.matches[0].teams.length %> / <%= category.matches[0]?.slots %></td>
                                    <td><span class="text-green">₹<%= category.matches[0]?.prizePool %></span></td>
                                    <td><span class="badge badge-blue"><%= category.matches[0]?.idpTimings %></span></td>
                                </tr>
                                <% }} %>

                                <!-- <tr>
                                    <td><strong>Daily Cash Cup</strong></td>
                                    <td>Miramar</td>
                                    <td>12 / 20</td>
                                    <td><span class="text-green">₹10,000</span></td>
                                    <td><span class="badge badge-blue">Upcoming</span></td>
                                </tr>
                                <tr>
                                    <td><strong>Squad Night Customs</strong></td>
                                    <td>Sanhok</td>
                                    <td>8 / 20</td>
                                    <td><span class="text-green">₹2,500</span></td>
                                    <td><span class="badge badge-blue">Upcoming</span></td>
                                </tr> -->
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Pending Payout Requests -->
                <div class="content-card">
                    <div class="card-header-flex">
                        <h2 class="card-title"><i class="fa-solid fa-money-bill-transfer"></i> Pending Withdrawal Requests</h2>
                        <a href="/admin/withdrawals" class="btn-link">Manage All</a>
                    </div>

                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Player / Team</th>
                                    <th>Amount</th>
                                    <th>UPI ID / QR Code</th>
                                    <th>Note</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(withdrawal.length > 0 ) { for (request of withdrawal.slice(0, 5) ){ %>
                                <tr>
                                    <td><strong><%= request.playerName %></strong></td>
                                    <td><strong class="text-green">₹<%= request.amount %></strong></td>
                                    <td>
                                        <% if (request.payoutMethod === 'qr') { %>
                                            <a href="<%= request.payoutDetail %>" target="_blank" title="Click to view full image">
                                                <img src="<%= request.payoutDetail %>" alt="QR Code" style="max-width: 60px; max-height: 60px; border-radius: 4px; border: 1px solid #ccc; cursor: pointer; display: block;" />
                                            </a>
                                        <% } else { %>
                                            <code><%= request.payoutDetail %></code>
                                        <% } %>
                                    </td>
                                    <td><%= request.note %></td>
                                    <td>
                                        <button class="btn-action btn-approve"> <%= request.status %> </button>
                                    </td>
                                </tr>
                               <% }} %>

                
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>

            <%- include("../partials/footer") %>
        </div>
    </div>
</body>
</html>
