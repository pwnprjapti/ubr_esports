<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Admin Dashboard | UBR Esports</title>
    <link rel="icon" type="image/png" href="/images/ubrLogo.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/admin/adminLayout.css">
    <link rel="stylesheet" href="/css/admin/dashboard.css">
    <style>
        /* Clickable Stat Card */
        .stat-card-clickable {
            cursor: pointer;
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
            user-select: none;
        }
        .stat-card-clickable:hover {
            transform: translateY(-3px);
            border-color: rgba(245, 158, 11, 0.4);
            box-shadow: 0 8px 24px rgba(245, 158, 11, 0.15);
        }
        .stat-card-clickable:focus-visible {
            outline: 2px solid var(--yellow);
        }
        .badge-pulse {
            background: rgba(245, 158, 11, 0.2);
            color: #f59e0b;
            border: 1px solid rgba(245, 158, 11, 0.4);
            font-size: 0.7rem;
            font-weight: 700;
            padding: 0.15rem 0.5rem;
            border-radius: 12px;
            letter-spacing: 0.02em;
            animation: pulseSubtle 2s infinite;
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
        }
        @keyframes pulseSubtle {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.65; }
        }

        /* Modal Styles */
        .modal-backdrop {
            display: none;
            position: fixed;
            z-index: 2000;
            inset: 0;
            background: rgba(0, 0, 0, 0.8);
            backdrop-filter: blur(6px);
            align-items: center;
            justify-content: center;
            padding: 1rem;
            overflow-y: auto;
        }
        .modal-backdrop.open {
            display: flex;
        }
        .modal-card {
            background: #13141f;
            border: 1px solid rgba(255, 255, 255, 0.12);
            border-radius: 18px;
            width: 100%;
            max-width: 840px;
            max-height: 88vh;
            display: flex;
            flex-direction: column;
            box-shadow: 0 25px 60px rgba(0, 0, 0, 0.75);
            overflow: hidden;
            animation: modalPop 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        }
        @keyframes modalPop {
            from { transform: scale(0.95); opacity: 0; }
            to { transform: scale(1); opacity: 1; }
        }
        .modal-header-box {
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.02);
        }
        .modal-close-icon {
            background: transparent;
            border: none;
            color: var(--text-muted);
            font-size: 1.75rem;
            cursor: pointer;
            padding: 0.2rem 0.5rem;
            line-height: 1;
            transition: color 0.2s, transform 0.2s;
            border-radius: 6px;
        }
        .modal-close-icon:hover {
            color: #ffffff;
            transform: rotate(90deg);
        }
        .modal-body-scroll {
            padding: 1.25rem 1.5rem;
            overflow-y: auto;
            flex: 1;
        }
        .modal-footer-box {
            padding: 1rem 1.5rem;
            border-top: 1px solid rgba(255, 255, 255, 0.08);
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: rgba(255, 255, 255, 0.02);
            flex-wrap: wrap;
            gap: 0.75rem;
        }

        /* Pending Request List Cards */
        .pending-requests-list {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }
        .pending-item-card {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 1.1rem 1.25rem;
            transition: border-color 0.2s, box-shadow 0.2s;
        }
        .pending-item-card:hover {
            border-color: rgba(255, 255, 255, 0.16);
            box-shadow: 0 4px 16px rgba(0,0,0,0.3);
        }
        .pending-item-header {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            margin-bottom: 0.9rem;
            gap: 1rem;
            flex-wrap: wrap;
        }
        .player-info-meta {
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }
        .player-avatar-circle {
            width: 42px;
            height: 42px;
            border-radius: 10px;
            background: rgba(59, 130, 246, 0.15);
            color: var(--blue);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.1rem;
        }
        .player-name-text {
            font-size: 1.05rem;
            font-weight: 700;
            color: #ffffff;
        }
        .player-time-text {
            font-size: 0.75rem;
            color: var(--text-muted);
            margin-top: 0.15rem;
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }
        .amount-badge {
            font-size: 1.25rem;
            font-weight: 800;
            color: #22c55e;
            line-height: 1;
        }

        .pending-item-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
            gap: 0.85rem;
            margin-bottom: 0.9rem;
        }
        .detail-box {
            background: rgba(0, 0, 0, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.05);
            border-radius: 8px;
            padding: 0.75rem 0.95rem;
        }
        .detail-box-label {
            font-size: 0.72rem;
            font-weight: 700;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.03em;
            display: flex;
            align-items: center;
            gap: 0.35rem;
        }
        .upi-code-text {
            background: rgba(255, 255, 255, 0.08);
            padding: 0.3rem 0.55rem;
            border-radius: 6px;
            font-family: monospace;
            color: #f1f5f9;
            font-size: 0.88rem;
            word-break: break-all;
        }
        .btn-copy-upi {
            background: rgba(59, 130, 246, 0.15);
            color: var(--blue);
            border: 1px solid rgba(59, 130, 246, 0.3);
            padding: 0.25rem 0.6rem;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 700;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.3rem;
            transition: all 0.2s;
        }
        .btn-copy-upi:hover {
            background: var(--blue);
            color: #ffffff;
        }
        .btn-sm-action {
            background: rgba(255, 255, 255, 0.08);
            color: #e2e8f0;
            border: 1px solid rgba(255, 255, 255, 0.15);
            padding: 0.25rem 0.55rem;
            border-radius: 6px;
            font-size: 0.75rem;
            font-weight: 600;
            cursor: pointer;
            margin-right: 0.35rem;
            margin-bottom: 0.35rem;
            transition: background 0.2s;
        }
        .btn-sm-action:hover {
            background: rgba(255, 255, 255, 0.16);
        }
        .insufficient-alert {
            color: #ef4444;
            font-size: 0.75rem;
            margin-top: 0.3rem;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 0.3rem;
        }
        .pending-note-box {
            background: rgba(245, 158, 11, 0.08);
            border: 1px dashed rgba(245, 158, 11, 0.3);
            border-radius: 8px;
            padding: 0.55rem 0.85rem;
            font-size: 0.8rem;
            color: #fcd34d;
            margin-bottom: 0.85rem;
            display: flex;
            align-items: flex-start;
            gap: 0.45rem;
            line-height: 1.4;
        }
        .pending-item-actions {
            display: flex;
            align-items: center;
            justify-content: flex-end;
            gap: 0.6rem;
            border-top: 1px solid rgba(255, 255, 255, 0.06);
            padding-top: 0.8rem;
        }

        /* Lightbox for QR Code */
        .qr-lightbox {
            display: none;
            position: fixed;
            z-index: 3000;
            inset: 0;
            background: rgba(0, 0, 0, 0.85);
            align-items: center;
            justify-content: center;
            padding: 1.5rem;
        }
        .qr-lightbox.open {
            display: flex;
        }
        .qr-lightbox-content {
            position: relative;
            background: #1a1b26;
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 14px;
            padding: 1.5rem;
            max-width: 380px;
            width: 100%;
            text-align: center;
        }
        .qr-lightbox-content img {
            max-width: 100%;
            max-height: 60vh;
            border-radius: 10px;
            background: #fff;
            padding: 0.5rem;
            display: inline-block;
        }
        .qr-close-btn {
            position: absolute;
            top: 0.6rem;
            right: 0.8rem;
            background: transparent;
            border: none;
            color: #fff;
            font-size: 1.5rem;
            cursor: pointer;
            line-height: 1;
        }

        /* Pending Modal Headings & Responsive Typography */
        .pending-modal-title {
            font-size: clamp(0.9rem, 3.6vw, 1.15rem);
            font-weight: 800;
            color: #fff;
            margin: 0;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            flex-wrap: wrap;
            line-height: 1.3;
        }

        .pending-modal-badge {
            font-size: 0.72rem;
            padding: 0.15rem 0.55rem;
            border-radius: 20px;
        }

        .pending-modal-subtitle {
            font-size: clamp(0.72rem, 2.6vw, 0.8rem);
            color: var(--text-muted);
            margin: 0.2rem 0 0 0;
            line-height: 1.3;
        }

        @media (max-width: 600px) {
            .modal-backdrop {
                padding: 0.85rem 0.65rem;
                align-items: center !important;
                justify-content: center !important;
            }
            .modal-card {
                max-height: 86vh;
                border-radius: 16px !important;
                margin: auto !important;
                width: 100% !important;
                max-width: 95vw !important;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.85);
            }
            .modal-header-box {
                padding: 0.85rem 1rem;
                gap: 0.5rem;
            }
            .pending-modal-header-icon {
                width: 34px !important;
                height: 34px !important;
                min-width: 34px !important;
                font-size: 0.95rem !important;
                border-radius: 8px !important;
            }
            .pending-modal-title {
                font-size: 0.92rem !important;
                gap: 0.35rem;
            }
            .pending-modal-badge {
                font-size: 0.68rem !important;
                padding: 0.12rem 0.45rem !important;
            }
            .pending-modal-subtitle {
                font-size: 0.72rem !important;
            }
            .modal-close-icon {
                font-size: 1.45rem;
                padding: 0.2rem;
            }
            .modal-body-scroll {
                padding: 0.85rem;
            }
            .modal-footer-box {
                padding: 0.75rem 1rem;
            }
            .pending-item-card {
                padding: 0.85rem;
            }
            .pending-item-grid {
                grid-template-columns: 1fr;
                gap: 0.65rem;
            }
            .pending-item-header {
                flex-direction: column;
                align-items: flex-start;
                gap: 0.5rem;
            }
            .pending-item-header > div:last-child {
                text-align: left !important;
                display: flex;
                align-items: center;
                gap: 0.6rem;
            }
            .pending-item-actions {
                justify-content: stretch;
            }
            .pending-item-actions button {
                flex: 1;
                justify-content: center;
            }
        }

        /* ==================== DESKTOP SCREENS (>= 769px) ==================== */
        /* All columns visible together at once, no horizontal scrolling */
        @media (min-width: 769px) {
            .table-wrap {
                overflow-x: hidden !important;
                width: 100% !important;
            }
            .data-table,
            .active-categories-table,
            .pending-withdrawals-table {
                width: 100% !important;
                min-width: 0 !important;
                max-width: 100% !important;
                table-layout: auto !important;
                display: table !important;
            }
            .active-categories-table th,
            .active-categories-table td,
            .pending-withdrawals-table th,
            .pending-withdrawals-table td {
                min-width: 0 !important;
                width: auto !important;
                padding: 0.85rem 0.95rem !important;
                white-space: nowrap !important;
            }
            /* Active Categories Desktop Proportions */
            .active-categories-table th:nth-child(1),
            .active-categories-table td:nth-child(1) {
                width: 32% !important;
            }
            .active-categories-table th:nth-child(2),
            .active-categories-table td:nth-child(2) {
                width: 16% !important;
            }
            .active-categories-table th:nth-child(3),
            .active-categories-table td:nth-child(3) {
                width: 15% !important;
            }
            .active-categories-table th:nth-child(4),
            .active-categories-table td:nth-child(4) {
                width: 16% !important;
            }
            .active-categories-table th:nth-child(5),
            .active-categories-table td:nth-child(5) {
                width: 21% !important;
            }

            /* Pending Withdrawals Desktop Proportions */
            .pending-withdrawals-table th:nth-child(1),
            .pending-withdrawals-table td:nth-child(1) {
                width: 22% !important;
            }
            .pending-withdrawals-table th:nth-child(2),
            .pending-withdrawals-table td:nth-child(2) {
                width: 14% !important;
            }
            .pending-withdrawals-table th:nth-child(3),
            .pending-withdrawals-table td:nth-child(3) {
                width: 26% !important;
            }
            .pending-withdrawals-table th:nth-child(4),
            .pending-withdrawals-table td:nth-child(4) {
                width: 24% !important;
                max-width: 200px !important;
                overflow: hidden !important;
                text-overflow: ellipsis !important;
                white-space: nowrap !important;
            }
            .pending-withdrawals-table th:nth-child(5),
            .pending-withdrawals-table td:nth-child(5) {
                width: 14% !important;
            }
        }

        /* ==================== MOBILE SCREENS (<= 768px) ==================== */
        /* Wide column layout with smooth horizontal swipe and single-line text */
        @media (max-width: 768px) {
            .table-wrap {
                overflow-x: auto !important;
                -webkit-overflow-scrolling: touch;
            }
            .active-categories-table {
                min-width: 840px !important;
                width: max-content !important;
            }
            .active-categories-table th:nth-child(1), 
            .active-categories-table td:nth-child(1) { 
                min-width: 250px !important; /* Scrim Name */
            }
            .active-categories-table th:nth-child(2), 
            .active-categories-table td:nth-child(2) { 
                min-width: 140px !important; /* Date */
            }
            .active-categories-table th:nth-child(3), 
            .active-categories-table td:nth-child(3) { 
                min-width: 120px !important; /* Slots */
            }
            .active-categories-table th:nth-child(4), 
            .active-categories-table td:nth-child(4) { 
                min-width: 140px !important; /* Prize Pool */
            }
            .active-categories-table th:nth-child(5), 
            .active-categories-table td:nth-child(5) { 
                min-width: 190px !important; /* IDP timings */
            }

            .pending-withdrawals-table {
                min-width: 1060px !important;
                width: max-content !important;
            }
            .pending-withdrawals-table th:nth-child(1), 
            .pending-withdrawals-table td:nth-child(1) { 
                min-width: 230px !important; /* Player / Team */
            }
            .pending-withdrawals-table th:nth-child(2), 
            .pending-withdrawals-table td:nth-child(2) { 
                min-width: 130px !important; /* Amount */
            }
            .pending-withdrawals-table th:nth-child(3), 
            .pending-withdrawals-table td:nth-child(3) { 
                min-width: 270px !important; /* UPI ID / QR Code */
            }
            .pending-withdrawals-table th:nth-child(4), 
            .pending-withdrawals-table td:nth-child(4) { 
                min-width: 280px !important; /* Note */
            }
            .pending-withdrawals-table th:nth-child(5), 
            .pending-withdrawals-table td:nth-child(5) { 
                min-width: 150px !important; /* Status */
            }

            .data-table th,
            .data-table td,
            .data-table td *,
            .data-table th * {
                white-space: nowrap !important;
                word-break: keep-all !important;
                overflow-wrap: normal !important;
            }
        }

        .card-title-nowrap {
            white-space: nowrap !important;
            word-break: keep-all !important;
            font-size: clamp(0.84rem, 3.4vw, 1.1rem) !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 0.45rem !important;
            margin: 0 !important;
        }
    </style>
</head>
<body>
    <div class="admin-layout">
        <%- include("../partials/sidebar") %>

        <div class="admin-main">
            <%- include("../partials/adminNav") %>

            <main class="admin-body">
                <div class="page-title-bar">
                    <div>
                        <h1 class="page-heading">Dashboard</h1>
                        <p class="page-sub">Quick overview of scrims, teams & payouts.</p>
                    </div>
                </div>

                <!-- 3 Simple Key Stats -->
                <div class="stats-row">
                    <div class="stat-card">
                        <div class="stat-icon icon-red">
                            <i class="fa-solid fa-trophy"></i>
                        </div>
                        <div class="stat-content">
                            <span class="stat-label">Categories</span>
                            <span class="stat-num"><%= categories.length %></span>
                        </div>
                    </div>

                    <a href="/admin/users" class="stat-card" style="text-decoration: none; cursor: pointer; transition: transform 0.2s ease, box-shadow 0.2s ease;">
                        <div class="stat-icon icon-blue">
                            <i class="fa-solid fa-users"></i>
                        </div>
                        <div class="stat-content">
                            <span class="stat-label">Registered Users</span>
                            <span class="stat-num"><%= users.length %></span>
                        </div>
                    </a>

                    <div class="stat-card stat-card-clickable" onclick="openPendingRequestsModal()" onkeydown="if(event.key==='Enter'||event.key===' '){event.preventDefault();openPendingRequestsModal();}" role="button" tabindex="0" title="Click to view pending requests pop-up">
                        <div class="stat-icon icon-yellow">
                            <i class="fa-solid fa-wallet"></i>
                        </div>
                        <div class="stat-content">
                            <span class="stat-label">Pending Withdrawals</span>
                            <div style="display: flex; align-items: baseline; gap: 0.5rem; flex-wrap: wrap;">
                                <span class="stat-num"><%= withdrawal.length %></span>
                                <% if (withdrawal.length > 0) { %>
                                    <span class="badge-pulse"><i class="fa-solid fa-arrow-pointer"></i> Click to View</span>
                                <% } %>
                            </div>
                        </div>
                        <div class="stat-card-arrow" style="margin-left: auto; color: var(--text-muted); font-size: 0.85rem; padding-left: 0.25rem;">
                            <i class="fa-solid fa-chevron-right"></i>
                        </div>
                    </div>
                </div>

                <!-- Recent Scrims Table -->
                <div class="content-card">
                    <div class="card-header-flex">
                        <h2 class="card-title card-title-nowrap"><i class="fa-solid fa-gamepad"></i> Active Categories</h2>
                        <a href="/admin/categories" class="btn-link" style="white-space: nowrap;">View All</a>
                    </div>

                    <div class="table-wrap">
                        <table class="data-table active-categories-table">
                            <thead>
                                <tr>
                                    <th>Scrim Name</th>
                                    <th>Date</th>
                                    <th>Slots</th>
                                    <th>Prize Pool</th>
                                    <th>IDP timings</th>
                                </tr>
                            </thead>
                            <tbody>
                                  <% for ( category of categories.slice(0, 6) ){ if( category.matches.length > 0){ %>
                                <tr>
                                    <td><strong><%= category.matches.at(-1)?.title %></strong></td>
                                    <td><%= category.matches.at(-1)?.date %></td>
                                    <td><%= category.matches.at(-1)?.teams.length %> / <%= category.matches.at(-1)?.slots %></td>
                                    <td><span class="text-green">₹<%= category.matches.at(-1)?.prizePool %></span></td>
                                    <td><span class="badge badge-blue"><%= category.matches.at(-1)?.idpTimings %></span></td>
                                </tr>
                                <% }} %>
                            </tbody>
                        </table>
                    </div>
                </div>

                <!-- Pending Payout Requests -->
                <div class="content-card">
                    <div class="card-header-flex">
                        <h2 class="card-title card-title-nowrap"><i class="fa-solid fa-money-bill-transfer"></i> Pending Withdrawal Requests</h2>
                        <a href="/admin/withdrawals" class="btn-link" style="white-space: nowrap;">Manage All</a>
                    </div>

                    <div class="table-wrap">
                        <table class="data-table pending-withdrawals-table">
                            <thead>
                                <tr>
                                    <th>Player / Team</th>
                                    <th>Amount</th>
                                    <th>UPI ID / QR Code</th>
                                    <th>Note</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if(withdrawal.length > 0 ) { for (request of withdrawal.slice(0, 5) ){ %>
                                <tr>
                                    <td><strong><%= request.playerName %></strong></td>
                                    <td><strong class="text-green">₹<%= request.amount %></strong></td>
                                    <td>
                                        <% if (request.payoutMethod === 'qr') { %>
                                            <a href="javascript:void(0)" onclick="openQRPreview('<%= request.payoutDetail %>')" title="Click to view full image">
                                                <img src="<%= request.payoutDetail %>" alt="QR Code" style="max-width: 60px; max-height: 60px; border-radius: 4px; border: 1px solid #ccc; cursor: pointer; display: block;" />
                                            </a>
                                        <% } else { %>
                                            <code title="<%= request.payoutDetail %>"><%= request.payoutDetail %></code>
                                        <% } %>
                                    </td>
                                    <td title="<%= request.note %>"><%= request.note || '-' %></td>
                                    <td>
                                        <button class="btn-action btn-approve" onclick="openPendingRequestsModal()" title="Click to view full details in popup"> <%= request.status %> </button>
                                    </td>
                                </tr>
                               <% }} else { %>
                                <tr>
                                    <td colspan="5" style="text-align: center; color: var(--text-muted); padding: 1.5rem;">No pending withdrawal requests.</td>
                                </tr>
                               <% } %>
                            </tbody>
                        </table>
                    </div>
                </div>
            </main>

            <%- include("../partials/footer") %>
        </div>
    </div>

    <!-- ==================== PENDING REQUESTS POPUP MODAL ==================== -->
    <div id="pendingRequestsModal" class="modal-backdrop" onclick="handlePendingModalBackdrop(event)">
        <div class="modal-card">
            <!-- Modal Header -->
            <div class="modal-header-box">
                <div style="display: flex; align-items: center; gap: 0.65rem; min-width: 0; flex: 1;">
                    <div class="stat-icon icon-yellow pending-modal-header-icon" style="width: 38px; height: 38px; min-width: 38px; font-size: 1.05rem; border-radius: 10px;">
                        <i class="fa-solid fa-wallet"></i>
                    </div>
                    <div style="min-width: 0;">
                        <h2 class="pending-modal-title">
                            Pending Requests
                            <span class="badge badge-yellow pending-modal-badge">
                                <%= withdrawal.length %> Pending
                            </span>
                        </h2>
                        <p class="pending-modal-subtitle">
                            Review user payout details and approve or reject directly.
                        </p>
                    </div>
                </div>
                <button class="modal-close-icon" onclick="closePendingRequestsModal()" title="Close (Esc)">&times;</button>
            </div>

            <!-- Modal Body (Scrollable) -->
            <div class="modal-body-scroll">
                <% if (withdrawal.length === 0) { %>
                    <div style="text-align: center; padding: 3.5rem 1.5rem;">
                        <div style="width: 65px; height: 65px; margin: 0 auto 1.25rem; background: rgba(34, 197, 94, 0.12); color: #22c55e; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem;">
                            <i class="fa-solid fa-circle-check"></i>
                        </div>
                        <h3 style="color: #fff; font-size: 1.15rem; font-weight: 700; margin-bottom: 0.4rem;">No Pending Requests</h3>
                        <p style="color: var(--text-muted); font-size: 0.85rem; max-width: 400px; margin: 0 auto;">
                            All payout requests have been processed. New withdrawal requests submitted by players will show up here.
                        </p>
                    </div>
                <% } else { %>
                    <div class="pending-requests-list">
                        <% for (let req of withdrawal) { %>
                            <div class="pending-item-card" id="req-card-<%= req._id %>">
                                <!-- Top Bar of item -->
                                <div class="pending-item-header">
                                    <div class="player-info-meta">
                                        <div class="player-avatar-circle">
                                            <i class="fa-solid fa-user"></i>
                                        </div>
                                        <div>
                                            <div class="player-name-text">
                                                <%= req.playerName || 'Unknown Player' %>
                                            </div>
                                            <div class="player-time-text">
                                                <i class="fa-regular fa-clock"></i> 
                                                <%= (req.createdAt) ? new Date(req.createdAt).toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Kolkata' }) : (req._id && typeof req._id.getTimestamp === 'function' ? req._id.getTimestamp().toLocaleString('en-IN', { dateStyle: 'medium', timeStyle: 'short', timeZone: 'Asia/Kolkata' }) : 'N/A') %>
                                            </div>
                                        </div>
                                    </div>

                                    <div style="text-align: right;">
                                        <div class="amount-badge">
                                            ₹<%= req.amount %>
                                        </div>
                                        <span class="badge badge-yellow" style="font-size: 0.7rem; margin-top: 0.25rem;">
                                            <i class="fa-solid fa-hourglass-half"></i> Pending
                                        </span>
                                    </div>
                                </div>

                                <!-- Details Grid -->
                                <div class="pending-item-grid">
                                    <!-- Payment Detail / Method -->
                                    <div class="detail-box">
                                        <span class="detail-box-label">
                                            <i class="fa-solid fa-credit-card"></i> Payout Method (<%= req.payoutMethod ? req.payoutMethod.toUpperCase() : 'UPI' %>)
                                        </span>
                                        <div class="detail-box-value">
                                            <% if (req.payoutMethod === 'qr') { %>
                                                <div style="display: flex; align-items: center; gap: 0.75rem; margin-top: 0.35rem;">
                                                    <img src="<%= req.payoutDetail %>" alt="QR Code" 
                                                         onclick="openQRPreview('<%= req.payoutDetail %>')"
                                                         style="width: 55px; height: 55px; object-fit: contain; border-radius: 6px; border: 1px solid rgba(255,255,255,0.15); background: #fff; cursor: pointer;" 
                                                         title="Click to enlarge QR" />
                                                    <div>
                                                        <button type="button" class="btn-sm-action" onclick="openQRPreview('<%= req.payoutDetail %>')">
                                                            <i class="fa-solid fa-magnifying-glass-plus"></i> View QR
                                                        </button>
                                                        <a href="<%= req.payoutDetail %>" target="_blank" class="btn-sm-action" style="text-decoration: none; display: inline-flex; align-items: center; gap: 0.3rem;">
                                                            <i class="fa-solid fa-arrow-up-right-from-square"></i> Open Link
                                                        </a>
                                                    </div>
                                                </div>
                                            <% } else { %>
                                                <div style="display: flex; align-items: center; gap: 0.5rem; margin-top: 0.35rem; flex-wrap: wrap;">
                                                    <code class="upi-code-text"><%= req.payoutDetail %></code>
                                                    <button type="button" class="btn-copy-upi" onclick="copyUPI('<%= req.payoutDetail %>', this)" title="Copy UPI ID">
                                                        <i class="fa-regular fa-copy"></i> Copy
                                                    </button>
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>

                                    <!-- User Wallet Balance & Check -->
                                    <div class="detail-box">
                                        <span class="detail-box-label">
                                            <i class="fa-solid fa-wallet"></i> User Current Balance
                                        </span>
                                        <div class="detail-box-value">
                                            <div style="font-weight: 700; font-size: 0.95rem; color: <%= req.hasEnoughBalance ? '#22c55e' : '#ef4444' %>; margin-top: 0.35rem;">
                                                ₹<%= (typeof req.userTotalBalance !== 'undefined') ? req.userTotalBalance : 'N/A' %>
                                                <% if (req.isDeducted) { %>
                                                    <span style="font-size: 0.72rem; color: #60a5fa; font-weight: normal; margin-left: 0.25rem;">(Already deducted on request)</span>
                                                <% } %>
                                            </div>
                                            <% if (!req.hasEnoughBalance) { %>
                                                <div class="insufficient-alert">
                                                    <i class="fa-solid fa-triangle-exclamation"></i> Insufficient balance! (Needs ₹<%= req.amount %>)
                                                </div>
                                            <% } else { %>
                                                <div style="color: #22c55e; font-size: 0.75rem; margin-top: 0.2rem; display: flex; align-items: center; gap: 0.3rem;">
                                                    <i class="fa-solid fa-check-circle"></i> Sufficient balance available
                                                </div>
                                            <% } %>
                                        </div>
                                    </div>
                                </div>

                                <!-- Note (if present) -->
                                <% if (req.note && req.note.trim()) { %>
                                    <div class="pending-note-box">
                                        <i class="fa-solid fa-message" style="color: #f59e0b; margin-top: 2px;"></i>
                                        <span><strong>Player Note:</strong> <%= req.note %></span>
                                    </div>
                                <% } %>

                                <!-- Action Buttons -->
                                <div class="pending-item-actions">
                                    <% if (!req.hasEnoughBalance) { %>
                                        <button type="button" class="btn-action btn-approve" style="opacity: 0.5; cursor: not-allowed; background: #333; color: #888; border-color: #444;" onclick="alert('User does not have enough balance in their wallet to approve this withdrawal!');">
                                            <i class="fa-solid fa-check"></i> Approve
                                        </button>
                                    <% } else { %>
                                        <button type="button" class="btn-action btn-approve" onclick="processWithdrawalAction(this, 'approved', '<%= req._id %>')">
                                            <i class="fa-solid fa-check"></i> Approve
                                        </button>
                                    <% } %>
                                    <button type="button" class="btn-action btn-delete" onclick="processWithdrawalAction(this, 'rejected', '<%= req._id %>')">
                                        <i class="fa-solid fa-xmark"></i> Reject
                                    </button>
                                </div>
                            </div>
                        <% } %>
                    </div>
                <% } %>
            </div>

            <!-- Modal Footer -->
            <div class="modal-footer-box">
                <a href="/admin/withdrawals" class="btn-secondary" style="text-decoration: none; font-size: 0.82rem; padding: 0.55rem 1rem; display: inline-flex; align-items: center; gap: 0.4rem;">
                    <i class="fa-solid fa-list-check"></i> Open Withdrawals Page
                </a>
                <button type="button" class="btn-secondary" onclick="closePendingRequestsModal()" style="font-size: 0.82rem; padding: 0.55rem 1.2rem;">
                    Close
                </button>
            </div>
        </div>
    </div>

    <!-- QR Code Lightbox Modal -->
    <div id="qrPreviewModal" class="qr-lightbox" onclick="closeQRPreview()">
        <div class="qr-lightbox-content" onclick="event.stopPropagation()">
            <button class="qr-close-btn" onclick="closeQRPreview()">&times;</button>
            <img id="qrPreviewImage" src="" alt="Payout QR Code">
            <div style="text-align: center; margin-top: 0.75rem;">
                <a id="qrDownloadLink" href="" target="_blank" class="btn-secondary" style="text-decoration: none; font-size: 0.82rem; padding: 0.4rem 0.9rem; display: inline-flex; align-items: center; gap: 0.4rem;">
                    <i class="fa-solid fa-arrow-up-right-from-square"></i> Open Full Image
                </a>
            </div>
        </div>
    </div>

    <!-- JavaScript Controllers for Modal & Actions -->
    <script>
        function openPendingRequestsModal() {
            const modal = document.getElementById('pendingRequestsModal');
            if (modal) {
                modal.classList.add('open');
                document.body.style.overflow = 'hidden';
            }
        }

        function closePendingRequestsModal() {
            const modal = document.getElementById('pendingRequestsModal');
            if (modal) {
                modal.classList.remove('open');
                document.body.style.overflow = '';
            }
        }

        function handlePendingModalBackdrop(e) {
            if (e.target && e.target.id === 'pendingRequestsModal') {
                closePendingRequestsModal();
            }
        }

        // Close on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closePendingRequestsModal();
                closeQRPreview();
            }
        });

        // Copy UPI helper
        function copyUPI(upiText, btn) {
            if (!upiText) return;
            navigator.clipboard.writeText(upiText).then(() => {
                const originalHtml = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-check"></i> Copied!';
                btn.style.background = '#22c55e';
                btn.style.color = '#fff';
                setTimeout(() => {
                    btn.innerHTML = originalHtml;
                    btn.style.background = '';
                    btn.style.color = '';
                }, 1800);
            }).catch(err => {
                console.error('Failed to copy: ', err);
                prompt('Copy UPI ID manually:', upiText);
            });
        }

        // QR Lightbox helpers
        function openQRPreview(imgUrl) {
            const modal = document.getElementById('qrPreviewModal');
            const img = document.getElementById('qrPreviewImage');
            const link = document.getElementById('qrDownloadLink');
            if (modal && img) {
                img.src = imgUrl;
                if (link) link.href = imgUrl;
                modal.classList.add('open');
            }
        }

        function closeQRPreview() {
            const modal = document.getElementById('qrPreviewModal');
            if (modal) {
                modal.classList.remove('open');
            }
        }

        // Approve or Reject from modal
        async function processWithdrawalAction(btn, option, id) {
            const actionText = option === 'approved' ? 'approve' : 'reject';
            if (confirm(`Are you sure you want to ${actionText} this withdrawal request?`)) {
                const originalHtml = btn.innerHTML;
                const parent = btn.parentElement;
                const siblings = parent.querySelectorAll('button');
                siblings.forEach(s => s.disabled = true);
                btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Processing...';

                try {
                    const res = await fetch("/admin/withdrawalReq", {
                        method: 'POST',
                        headers: {
                            "Content-Type": "application/json"
                        },
                        body: JSON.stringify({ option, id })
                    });

                    const result = await res.json();
                    alert(result.msg);
                    window.location.reload();
                } catch(err) {
                    console.error("Error processing withdrawal:", err);
                    alert("Something went wrong while processing the request.");
                    siblings.forEach(s => s.disabled = false);
                    btn.innerHTML = originalHtml;
                }
            }
        }
    </script>
</body>
</html>
