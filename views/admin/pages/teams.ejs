<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Teams | UBR Esports Admin</title>
    <link rel="icon" type="image/jpeg" href="/images/photo.jpg.jpeg">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/admin/adminLayout.css">
    <link rel="stylesheet" href="/css/admin/dashboard.css">
    <style>
        .approve-btn {
            background: #28a745; 
            color: white; 
            border: none; 
            padding: 0.4rem 0.8rem; 
            border-radius: 6px; 
            font-weight: 700; 
            cursor: pointer; 
            font-size: 0.82rem; 
            display: inline-flex; 
            align-items: center; 
            gap: 0.35rem;
            transition: background 0.2s ease, transform 0.1s ease;
        }
        .approve-btn:hover {
            background: #218838;
            transform: translateY(-1px);
        }
        .approve-btn:active {
            transform: translateY(0);
        }
        
        .reject-btn {
            background: #dc3545; 
            color: white; 
            border: none; 
            padding: 0.4rem 0.8rem; 
            border-radius: 6px; 
            font-weight: 700; 
            cursor: pointer; 
            font-size: 0.82rem; 
            display: inline-flex; 
            align-items: center; 
            gap: 0.35rem;
            transition: background 0.2s ease, transform 0.1s ease;
        }
        .reject-btn:hover {
            background: #c82333;
            transform: translateY(-1px);
        }
        .reject-btn:active {
            transform: translateY(0);
        }

        .btn-whatsapp {
            background: #25d366;
            color: white;
            padding: 0.4rem 0.8rem;
            border-radius: 6px;
            font-weight: 700;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            font-size: 0.82rem;
            transition: background 0.2s ease, transform 0.1s ease;
            margin-top: 0.25rem;
        }
        .btn-whatsapp:hover {
            background: #128c7e;
            transform: translateY(-1px);
        }
    </style>
</head>
<body>
    <div class="admin-layout">
        <%- include("../partials/sidebar") %>

        <div class="admin-main">
            <%- include("../partials/adminNav") %>

            <main class="admin-body">
                <div class="page-title-bar">
                    <div>
                        <h1 class="page-heading">Registered Teams</h1>
                        <p class="page-sub">View all squads with direct WhatsApp contact.</p>
                    </div>
                </div>

                <div class="content-card">
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Squad Name</th>
                                    <th>WhatsApp Mobile</th>
                                    <th>Payment Screenshot</th>
                                    <th>Erangle</th>
                                    <th>Rando</th>
                                    <th>Miramar</th>
                                    <th>Status / Actions</th>
                                </tr>
                            </thead>
                            <tbody>

                                <% for(team of teams ) { %>
                                <tr>
                                    <td>
                                        <div style="display: flex; align-items: center; gap: 0.65rem;">
                                            <div style="width: 34px; height: 34px; border-radius: 50%; background: rgba(215,38,61,0.2); display: flex; align-items: center; justify-content: center; color: #ff455e; overflow: hidden;">
                                                <% if (team.teamLogo) { %>
                                                    <img src="/images/<%= team.teamLogo %>" alt="<%= team.teamName %>" style="width: 100%; height: 100%; object-fit: cover; display: block;">
                                                <% } else { %>
                                                    <i class="fa-solid fa-shield-halved"></i>
                                                <% } %>
                                            </div>
                                            <strong><%= team.teamName %></strong>
                                        </div>
                                    </td>
                                    <td>
                                        <div style="display: flex; flex-direction: column; gap: 0.25rem; align-items: flex-start;">
                                            <span>+91 <%= team.whatsappNumber %></span>
                                            <a href="https://wa.me/91<%= team.whatsappNumber %>" target="_blank" class="btn-whatsapp">
                                                <i class="fa-brands fa-whatsapp"></i> Chat WhatsApp
                                            </a>
                                        </div>
                                    </td>
                                    <td>
                                        <% if (team.paymentScreenshot) { %>
                                            <img src="/images/<%= team.paymentScreenshot %>" alt="Payment Proof" style="width: 50px; height: 50px; object-fit: cover; border-radius: 4px; cursor: pointer; border: 1px solid rgba(255,255,255,0.1);" onclick="showScreenshot('/images/<%= team.paymentScreenshot %>')">
                                        <% } else { %>
                                            <span style="font-size: 0.85rem; color: #9e9ea7;">N/A (Free)</span>
                                        <% } %>
                                    </td>
                                    <td> <%= team.dropDetails.erangle %></td>
                                    <td> <%= team.dropDetails.rando %></td>
                                    <td> <%= team.dropDetails.miramar %></td>
                                    <td>
                                        <% if (team.status === 'pending') { %>
                                            <div style="display: flex; gap: 0.4rem; align-items: center;">
                                                <button class="approve-btn" onclick="updateTeamStatus(this, '<%= team._id %>', 'approved')"><i class="fa-solid fa-check"></i> Approve</button>
                                                <button class="reject-btn" onclick="updateTeamStatus(this, '<%= team._id %>', 'rejected')"><i class="fa-solid fa-xmark"></i> Reject</button>
                                            </div>
                                        <% } else if (team.status === 'approved') { %>
                                            <span style="background: rgba(40, 167, 69, 0.15); color: #28a745; font-size: 0.8rem; padding: 0.25rem 0.6rem; border-radius: 6px; font-weight: 700; display: inline-block;">Approved</span>
                                        <% } else { %>
                                            <span style="background: rgba(220, 53, 69, 0.15); color: #dc3545; font-size: 0.8rem; padding: 0.25rem 0.6rem; border-radius: 6px; font-weight: 700; display: inline-block;"><%= team.status %></span>
                                        <% } %>
                                    </td>
                                </tr>
                                <%  } %>

                            </tbody>
                        </table>
                    </div>
                </div>
            </main>

            <%- include("../partials/footer") %>
        </div>
    </div>
    <!-- Screenshot Lightbox Modal -->
    <div id="screenshotModal" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background: rgba(0, 0, 0, 0.9); display: none; align-items: center; justify-content: center; z-index: 9999; padding: 1.5rem; box-sizing: border-box;">
        <button onclick="closeScreenshotModal()" style="position: absolute; top: 1.5rem; right: 1.5rem; background: transparent; border: none; color: white; font-size: 2.5rem; cursor: pointer; line-height: 1;">&times;</button>
        <img id="lightboxImg" src="" alt="Payment Screenshot Large" style="max-width: 100%; max-height: 90vh; object-fit: contain; border-radius: 8px; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
    </div>

    <script>
        function showScreenshot(src) {
            const modal = document.getElementById('screenshotModal');
            const img = document.getElementById('lightboxImg');
            img.src = src;
            modal.style.display = 'flex';
        }

        function closeScreenshotModal() {
            document.getElementById('screenshotModal').style.display = 'none';
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeScreenshotModal();
            }
        });

        async function updateTeamStatus(btn, teamId, status) {
            if (!confirm(`Are you sure you want to ${status === 'approved' ? 'approve' : 'reject'} this team?`)) {
                return;
            }

            const originalHtml = btn.innerHTML;
            btn.disabled = true;
            btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

            try {
                const res = await fetch(`/admin/category/<%= categoryId %>/match/<%= matchId %>/team/${teamId}/status`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify({ status })
                });

                const result = await res.json();
                alert(result.msg);
                if (res.status === 200) {
                    window.location.reload();
                } else {
                    btn.disabled = false;
                    btn.innerHTML = originalHtml;
                }
            } catch(err) {
                console.error("Error updating team status:", err);
                alert("Something went wrong. Please try again.");
                btn.disabled = false;
                btn.innerHTML = originalHtml;
            }
        }
    </script>
</body>
</html>
