<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Transactions | UBR Esports Admin</title>
    <link rel="icon" type="image/png" href="/images/ubrLogo.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/admin/adminLayout.css">
    <link rel="stylesheet" href="/css/admin/dashboard.css">
    <style>
        .screenshot-thumbnail {
            width: 80px;
            height: 80px;
            object-fit: cover;
            border-radius: 8px;
            border: 1px solid rgba(255, 255, 255, 0.1);
            cursor: pointer;
            transition: transform 0.2s;
        }
        .screenshot-thumbnail:hover {
            transform: scale(1.1);
        }
    </style>
</head>
<body>
    <div class="admin-layout">
        <%- include("../partials/sidebar") %>

        <div class="admin-main">
            <%- include("../partials/adminNav") %>

            <main class="admin-body">
                <div class="page-title-bar">
                    <div>
                        <h1 class="page-heading">Auto-Payment Transactions</h1>
                        <p class="page-sub">Real-time Lola Pay UPI gateway transaction logs & verification status.</p>
                    </div>
                </div>

                <div class="content-card">
                    <div class="table-wrap">
                        <table class="data-table">
                            <thead>
                                <tr>
                                    <th>Order ID</th>
                                    <th>Player Name</th>
                                    <th>Amount</th>
                                    <th>Bank UTR</th>
                                    <th>Gateway Txn ID</th>
                                    <th>Method / Provider</th>
                                    <th>Date & Time</th>
                                    <th>Status</th>
                                </tr>
                            </thead>
                            <tbody>

                                <% if (!transactions || transactions.length === 0) { %>
                                    <tr>
                                        <td colspan="8" style="text-align: center; padding: 2rem; color: #9e9ea7;">No transaction records found.</td>
                                    </tr>
                                <% } %>

                                <% for (const txn of transactions) { %>
                                <tr>
                                    <td>
                                        <span style="font-family: 'Fira Code', monospace; font-size: 0.88rem; font-weight: 600; color: #0E7490; background: rgba(14, 116, 144, 0.1); padding: 3px 8px; border-radius: 6px; border: 1px solid rgba(14, 116, 144, 0.2);">
                                            <%= txn.orderId || 'ORD_MANUAL' %>
                                        </span>
                                    </td>
                                    <td><strong><%= txn.playerName %></strong></td>
                                    <td><strong class="text-green" style="font-size: 1.05rem;">₹<%= Number(txn.amount).toFixed(2) %></strong></td>
                                    <td>
                                        <% if (txn.utr) { %>
                                            <span style="font-family: 'Fira Code', monospace; font-size: 0.88rem; color: #f1f5f9; background: rgba(255, 255, 255, 0.06); padding: 3px 8px; border-radius: 6px;">
                                                <%= txn.utr %>
                                            </span>
                                        <% } else { %>
                                            <span style="color: #6b7280; font-size: 0.85rem;">—</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <% if (txn.gatewayTxnId) { %>
                                            <span style="font-family: 'Fira Code', monospace; font-size: 0.82rem; color: #9e9ea7;">
                                                <%= txn.gatewayTxnId %>
                                            </span>
                                        <% } else { %>
                                            <span style="color: #6b7280; font-size: 0.85rem;">—</span>
                                        <% } %>
                                    </td>
                                    <td>
                                        <span style="font-size: 0.82rem; font-weight: 600; color: #C6E547; background: rgba(198, 229, 71, 0.1); padding: 2px 7px; border-radius: 4px; text-transform: uppercase;">
                                            <%= txn.paymentMethod || 'UPI QR' %>
                                        </span>
                                        <span style="font-size: 0.78rem; color: #9e9ea7; margin-left: 3px;">
                                            (<%= txn.provider || 'Paytm' %>)
                                        </span>
                                    </td>
                                    <td>
                                        <span style="font-size: 0.85rem; color: #d0d7de;">
                                            <%= new Date(txn.paidAt || txn.date).toLocaleString('en-IN', { timeZone: 'Asia/Kolkata' }) %>
                                        </span>
                                    </td>
                                    <td>
                                        <% if (txn.status === 'approved' || txn.status === 'success') { %>
                                            <span class="badge badge-green" style="display: inline-flex; align-items: center; gap: 4px;">
                                                <i class="fa-solid fa-circle-check"></i> Success
                                            </span>
                                        <% } else if (txn.status === 'rejected' || txn.status === 'failed') { %>
                                            <span class="badge badge-red" style="background: rgba(215, 38, 61, 0.15); color: #ff455e; border: 1px solid rgba(215, 38, 61, 0.3); display: inline-flex; align-items: center; gap: 4px;">
                                                <i class="fa-solid fa-circle-xmark"></i> Failed
                                            </span>
                                        <% } else { %>
                                            <span class="badge badge-yellow" style="display: inline-flex; align-items: center; gap: 4px;">
                                                <i class="fa-solid fa-clock"></i> Pending
                                            </span>
                                        <% } %>
                                    </td>
                                </tr>
                                <% } %>

                            </tbody>
                        </table>
                    </div>
                </div>
            </main>

            <%- include("../partials/footer") %>
        </div>
    </div>
</body>
</html>
