<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Add Category | UBR Esports Admin</title>
    <link rel="icon" type="image/jpeg" href="/images/photo.jpg.jpeg">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/admin/adminLayout.css">
    <link rel="stylesheet" href="/css/addcategory.css">
</head>
<body>
    <div class="admin-layout">
        <%- include("../partials/sidebar") %>

        <div class="admin-main">
            <%- include("../partials/adminNav") %>

            <main class="admin-body">
                <div class="add-category-wrapper">
                    <div class="add-category-card">
                        <h1>Add Category</h1>

                        <form class="category-form" method="post">
                            <!-- 1. Category Name Field -->
                            <div class="form-group">
                                <label for="categoryName">Category Name</label>
                                <input 
                                    type="text" 
                                    id="categoryName" 
                                    name="categoryName" 
                                    class="form-input" 
                                    placeholder="Enter category name" 
                                    required
                                >
                            </div>

                            <!-- 2. Category Picture Upload Field -->
                            <div class="form-group">
                                <label for="categoryPicture">Category Picture</label>
                                <input 
                                    type="file" 
                                    id="categoryPicture" 
                                    name="categoryPicture" 
                                    class="form-file-input" 
                                    accept="image/*" 
                                    required
                                >
                            </div>

                            <!-- 3. Category Description Field -->
                            <div class="form-group">
                                <label for="categoryDescription">Category Description</label>
                                <textarea 
                                    id="categoryDescription" 
                                    name="categoryDescription" 
                                    class="form-textarea" 
                                    rows="4" 
                                    placeholder="Enter category description" 
                                    required
                                ></textarea>
                            </div>

                            <!-- 4. Submit Button -->
                            <button type="submit" id="submitButton" class="submit-btn">
                                Submit
                            </button>
                        </form>
                    </div>
                </div>
            </main>

            <%- include("../partials/footer") %>
        </div>
    </div>


    <script>
        const categoryName = document.getElementById("categoryName");
        const categoryPicture = document.getElementById("categoryPicture");
        const categoryDescription = document.getElementById("categoryDescription");
        const submitButton = document.getElementById("submitButton");
        const baseurl = "<%= baseurl %>";

        async function submitData(e){
            e.preventDefault();
            try {
                if (!categoryName.value || !categoryDescription.value) {
                    alert("Please fill all fields");
                    return;
                }
                const formData = new FormData();
                formData.append("title", categoryName.value);
                formData.append("description", categoryDescription.value);
                if (categoryPicture.files[0]) {
                    formData.append("categoryPicture", categoryPicture.files[0]);
                } else {
                    alert("Please upload a category picture");
                    return;
                }

                const originalBtnHtml = submitButton.innerHTML;
                submitButton.disabled = true;
                submitButton.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting...';

                const res = await fetch(`${baseurl}/admin/addcategory`, {  
                    method: 'POST',
                    body: formData
                });

                const result = await res.json();
                alert(result.msg);
                if (res.status === 200 || result.msg === "Category created successfully") {
                    window.location.href = "/admin/categories";
                } else {
                    submitButton.disabled = false;
                    submitButton.innerHTML = originalBtnHtml;
                }
            } catch(err) {
                console.log(err);
                if (typeof submitButton !== 'undefined') {
                    submitButton.disabled = false;
                    submitButton.innerHTML = originalBtnHtml;
                }
            }
        }

        submitButton.addEventListener("click", submitData);
    </script>
</body>
</html>
