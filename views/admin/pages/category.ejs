<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Category | UBR Esports Admin</title>
    <link rel="icon" type="image/png" href="/images/ubrLogo.png">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/admin/adminLayout.css?v=restore">
    <link rel="stylesheet" href="/css/admin/category.css?v=restore">
    <style>
        .delete-scrim-btn {
            position: absolute;
            top: 0.75rem;
            right: 0.75rem;
            background: rgba(155, 7, 7, 0.85);
            border: none;
            border-radius: 50% !important;
            width: 34px !important;
            height: 34px !important;
            padding: 0 !important;
            box-sizing: border-box !important;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #ffffff;
            cursor: pointer;
            transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
            z-index: 10;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }

        .delete-scrim-btn:hover {
            transform: scale(1.1);
            background-color: #D41B23;
            box-shadow: 0 4px 12px rgba(155, 7, 7, 0.5);
        }

        .edit-scrim-btn {
            position: absolute;
            top: 0.75rem;
            right: 3.25rem;
            background: rgba(255, 193, 7, 0.85);
            border: none;
            border-radius: 50% !important;
            width: 34px !important;
            height: 34px !important;
            padding: 0 !important;
            box-sizing: border-box !important;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #000000;
            cursor: pointer;
            transition: transform 0.2s ease, background-color 0.2s ease, box-shadow 0.2s ease;
            z-index: 10;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.3);
        }

        .edit-scrim-btn:hover {
            transform: scale(1.1);
            background-color: #ffca28;
            box-shadow: 0 4px 12px rgba(255, 193, 7, 0.5);
        }

        /* Date Banner styling */
        .selected-date-banner {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            margin: 1.25rem auto;
            width: 100%;
            max-width: 600px;
        }

        .selected-date-banner .line {
            flex: 1;
            height: 1px;
            background: rgba(212, 27, 35, 0.4);
        }

        .selected-date-banner .date-text {
            color: #D41B23;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            background: transparent;
            border: none;
            padding: 0 0.5rem;
            text-shadow: none;
            white-space: nowrap;
        }

        /* Drag & Drop Reorder Styles */
        .drag-handle {
            position: absolute;
            top: 0.75rem;
            left: 0.75rem;
            background: rgba(255, 255, 255, 0.08);
            border: 1px solid rgba(255, 255, 255, 0.15);
            border-radius: 8px;
            padding: 0.25rem 0.55rem;
            font-size: 0.75rem;
            font-weight: 700;
            color: #b0b0b8;
            cursor: grab;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            transition: background 0.2s ease, border-color 0.2s ease, color 0.2s ease;
            z-index: 10;
            user-select: none;
            touch-action: none;
        }

        .drag-handle:hover {
            background: rgba(155, 7, 7, 0.25);
            border-color: rgba(155, 7, 7, 0.5);
            color: #D41B23;
        }

        .drag-handle:active {
            cursor: grabbing;
        }

        .scrim-title {
            margin-top: 1.6rem !important;
            word-break: break-word;
        }

        .scrim-card.sortable-ghost {
            opacity: 0.35;
            border: 2px dashed #D41B23 !important;
            background: rgba(155, 7, 7, 0.08) !important;
        }

        .scrim-card.sortable-chosen {
            border-color: #D41B23 !important;
            box-shadow: 0 10px 30px rgba(155, 7, 7, 0.35) !important;
            cursor: grabbing !important;
        }

        .scrim-card.sortable-drag {
            opacity: 0.95;
            transform: scale(1.02);
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.7) !important;
        }

        /* Floating Toast for Reorder Status */
        .reorder-toast {
            position: fixed;
            bottom: 2rem;
            right: 2rem;
            background: #151720;
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #ffffff;
            padding: 0.75rem 1.25rem;
            border-radius: 12px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.6);
            display: flex;
            align-items: center;
            gap: 0.65rem;
            font-size: 0.88rem;
            font-weight: 700;
            z-index: 9999;
            transform: translateY(100px);
            opacity: 0;
            transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
            pointer-events: none;
        }

        .reorder-toast.show {
            transform: translateY(0);
            opacity: 1;
        }

        .reorder-toast.success {
            border-color: rgba(34, 197, 94, 0.4);
            color: #4ade80;
        }

        .reorder-toast.error {
            border-color: rgba(239, 68, 68, 0.4);
            color: #f87171;
        }

        .reorder-toast.loading {
            border-color: rgba(255, 193, 7, 0.4);
            color: #ffca28;
        }
    </style>
</head>
<body>
    <div class="admin-layout">
        <%- include("../partials/sidebar") %>

        <div class="admin-main">
            <%- include("../partials/adminNav") %>

            <main class="admin-body">
                <div class="admin-category-page">
                    <!-- Hero Header -->
                    <section class="category-hero">
                        <div class="hero-text">
                            <!-- <div class="hero-badge" style="display: inline-flex; align-items: center; gap: 0.4rem; padding: 0.25rem 0.65rem; background: rgba(155, 7, 7,0.15); border: 1px solid rgba(155, 7, 7,0.3); border-radius: 999px; font-size: 0.75rem; font-weight: 700; color: #D41B23; margin-bottom: 0.5rem;">
                                <i class="fa-solid fa-circle" style="font-size: 0.45rem;"></i> Date-Wise Category Schedule
                            </div> -->
                        <div class="hero-text" style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 1rem;">
                            <div>
                                <h1>BGMI Scrims & Scrims</h1>
                                <p>Select a date to find live scrims, daily cash cups, and weekend custom matches.</p>
                            </div>
                            <a href="/admin/addscrim" class="slot-btn-full" style="width: auto; padding: 0.65rem 1.25rem; text-decoration: none;">
                                <i class="fa-solid fa-plus"></i> Add Scrim
                            </a>
                        </div>
                    </section>

                    <!-- Date-Based Filter Section -->
                    <section class="date-filter-section">
                        <div class="filter-header">
                            <div class="filter-title">
                                <i class="fa-solid fa-calendar-days"></i>
                                <span>Filter by Scrim Date</span>
                            </div>
                        </div>

                        <div class="filter-controls-wrapper">
                            <!-- Specific Custom Date Picker -->
                            <div class="custom-date-picker">
                                <label for="customDatePicker"><i class="fa-regular fa-calendar"></i> Pick Specific Date:</label>
                                <input type="date" id="customDatePicker" name="customDate" min="2026-08-01" max="2026-12-31">
                            </div>
                        </div>
                    </section>

                    <!-- Selected Date Display Banner -->
                    <div class="selected-date-banner">
                        <span class="line"></span>
                        <span class="date-text" id="selectedDateDisplay">Loading Date...</span>
                        <span class="line"></span>
                    </div>

                    <!-- Scrim / Category Grid -->
                    <section class="scrim-grid" id="scrimGrid">

                        <!-- Card 1 -->
                          <% for (const match of matches) { %>
                         <article class="scrim-card" data-id="<%= match._id %>" data-date="<%= match.date %>" style="position: relative;">
                             <div class="drag-handle" title="Drag to reorder scrim">
                                 <i class="fa-solid fa-grip-vertical"></i> <span>Drag</span>
                             </div>
                             <button class="edit-scrim-btn" onclick="event.stopPropagation(); window.location.href='/admin/category/<%= id %>/scrim/edit/<%= match._id %>'" title="Edit Scrim">
                                 <i class="fa-solid fa-pen-to-square"></i>
                             </button>
                             <button class="delete-scrim-btn" onclick="deleteScrim(event, this, '<%= id %>', '<%= match._id %>')" title="Delete Scrim">
                                 <i class="fa-solid fa-trash-can"></i>
                             </button>
                            <h3 class="scrim-title"><%= match.title %></h3>
                            <div class="scrim-meta">
                                <div class="meta-item">
                                    <span class="meta-label"><i class="fa-regular fa-calendar"></i> Match Date</span>
                                    <span class="meta-val highlight-date"><%= match.date %></span>
                                </div>
                                <div class="meta-item">
                                    <span class="meta-label"><i class="fa-solid fa-sack-dollar"></i> Prize Pool</span>
                                    <span class="meta-val prize">₹ <%= match.prizePool %></span>
                                </div>
                                <div class="meta-item" style="display: flex; flex-direction: column; align-items: flex-start; gap: 0.4rem; width: 100%;">
                                    <% const approvedTeamsCount = (match.teams || []).filter(t => t.status === "approved" || !t.status).length; %>
                                    <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                                        <span class="meta-label"><i class="fa-solid fa-users"></i> Slots Booked</span>
                                        <span class="meta-val slot-highlight"><%= approvedTeamsCount %> / <%= match.slots %></span>
                                    </div>
                                    <% const filledPercentage = Math.min(100, Math.round((approvedTeamsCount / (match.slots || 1)) * 100)); %>
                                    <div class="progress-bar-container" style="width: 100%; height: 8px; background: rgba(255, 255, 255, 0.08); border-radius: 999px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.04); box-sizing: border-box;">
                                        <div class="progress-bar-fill" style="width: <%= filledPercentage %>%; height: 100%; background: <%= (match.teams && match.teams.length >= match.slots) ? '#ff0000' : 'linear-gradient(90deg, #4ade80, #22c55e)' %>; border-radius: 999px; transition: width 0.3s ease;"></div>
                                    </div>
                                </div>
                                <div class="meta-item">
                                    <span class="meta-label"><i class="fa-solid fa-rupee-sign"></i> Entry Fee</span>
                                    <span class="meta-val slot-highlight">₹<%= match.entryFee %></span>
                                </div>
                                <div class="meta-item">
                                    <span class="meta-label"><i class="fa-solid fa-gamepad"></i> Mode (Squad)</span>
                                    <span class="meta-val">16 - 18</span>
                                </div>
                            </div>
                            <div class="idp-timing">
                                <span class="meta-label"><i class="fa-regular fa-clock"></i> IDP Timing</span>
                                <div class="timings">
                                    <% for( time of match.idpTimings.split(",") ) { %>
                                    <span><%= time %></span>
                                    <% } %>
                                </div>
                            </div>
                            <% if (match.maps) { %>
                            <div class="idp-timing" style="margin-top: 10px;">
                                <span class="meta-label"><i class="fa-solid fa-map"></i> Maps</span>
                                <div class="timings">
                                    <% for( mapName of match.maps.split(",") ) { %>
                                    <span><%= mapName.trim() %></span>
                                    <% } %>
                                </div>
                            </div>
                            <% } %>
                            <div class="card-actions-single">
                                <button class="slot-btn-full" onclick="window.location.href='/admin/teams/<%= id %>/<%= match._id %>'">
                                    <i class="fa-solid fa-eye"></i> View Details
                                </button>
                            </div>
                        </article>
                       <% } %>
                        
                    </section>

                    <!-- Empty State -->
                    <div class="no-scrims-card" id="noScrimsMsg" style="display: none;">
                        <div class="empty-icon"><i class="fa-regular fa-calendar-xmark"></i></div>
                        <h3>No Scrims Found on this Date</h3>
                        <p>There are no matches scheduled for the selected date.</p>
                        <button type="button" class="reset-filter-btn" id="resetDateFilter">
                            <i class="fa-solid fa-rotate-left"></i> View All Dates
                        </button>
                    </div>
                </div>
            </main>

            <%- include("../partials/footer") %>
        </div>
    </div>

    <!-- Date Filter Script -->
    <script>
        (function() {
            const customDatePicker = document.getElementById('customDatePicker');
            const scrimCards = document.querySelectorAll('.scrim-card');
            const emptyMsg = document.getElementById('noScrimsMsg');
            const resetBtn = document.getElementById('resetDateFilter');

            function applyFilter(customDateValue) {
                let visibleCount = 0;
                scrimCards.forEach(card => {
                    const cardDate = card.getAttribute('data-date');
                    if (!customDateValue || cardDate === customDateValue) {
                        card.style.display = 'flex';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (visibleCount === 0) {
                    emptyMsg.style.display = 'block';
                } else {
                    emptyMsg.style.display = 'none';
                }

                // Update selected date display banner
                const dateDisplay = document.getElementById('selectedDateDisplay');
                if (dateDisplay) {
                    if (customDateValue) {
                        try {
                            const dateParts = customDateValue.split('-');
                            const formattedDate = new Date(dateParts[0], dateParts[1] - 1, dateParts[2]);
                            const options = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' };
                            dateDisplay.textContent = formattedDate.toLocaleDateString('en-US', options);
                        } catch(e) {
                            dateDisplay.textContent = customDateValue;
                        }
                    } else {
                        dateDisplay.textContent = "All Upcoming Matches";
                    }
                }
            }

            if (customDatePicker) {
                customDatePicker.addEventListener('change', function() {
                    applyFilter(this.value);
                });
            }

            if (resetBtn) {
                resetBtn.addEventListener('click', function() {
                    if (customDatePicker) customDatePicker.value = '';
                    applyFilter(null);
                });
            }

            // Pre-fill current date (today) in YYYY-MM-DD format and apply filter
            const today = new Date();
            const year = today.getFullYear();
            const month = String(today.getMonth() + 1).padStart(2, '0');
            const day = String(today.getDate()).padStart(2, '0');
            const todayString = `${year}-${month}-${day}`;

            if (customDatePicker) {
                customDatePicker.value = todayString;
                applyFilter(todayString);
            }
        })();
    </script>

    <script>
        async function deleteScrim(event, btn, categoryId, matchId) {
            event.stopPropagation();
            if (confirm("Are you sure you want to delete this scrim? This action cannot be undone.")) {
                try {
                    const originalBtnHtml = btn.innerHTML;
                    btn.disabled = true;
                    btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';

                    const res = await fetch(`/admin/category/${categoryId}/scrim/delete/${matchId}`, {
                        method: 'POST'
                    });
                    const result = await res.json();
                    alert(result.msg);
                    if (res.status === 200 || result.success) {
                        window.location.reload();
                    } else {
                        btn.disabled = false;
                        btn.innerHTML = originalBtnHtml;
                    }
                } catch(err) {
                    console.error("Error deleting scrim:", err);
                    alert("Something went wrong. Please try again.");
                    if (typeof btn !== 'undefined' && originalBtnHtml) {
                        btn.disabled = false;
                        btn.innerHTML = originalBtnHtml;
                    }
                }
            }
        }
    </script>

    <!-- Floating Notification Toast -->
    <div id="reorderToast" class="reorder-toast"></div>

    <!-- Drag & Drop Sortable Scripts -->
    <script src="/js/sortable.min.js"></script>
    <script>
        if (typeof Sortable === 'undefined') {
            document.write('<script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"><\/script>');
        }
    </script>
    <script>
        (function initDragAndDrop() {
            const scrimGrid = document.getElementById('scrimGrid');
            const toast = document.getElementById('reorderToast');
            let toastTimeout = null;

            function showToast(message, type, iconHtml) {
                if (!toast) return;
                if (toastTimeout) clearTimeout(toastTimeout);
                toast.className = `reorder-toast show ${type}`;
                toast.innerHTML = `${iconHtml || ''} <span>${message}</span>`;
                if (type !== 'loading') {
                    toastTimeout = setTimeout(() => {
                        toast.classList.remove('show');
                    }, 3000);
                }
            }

            if (scrimGrid) {
                const categoryId = '<%= id %>';
                new Sortable(scrimGrid, {
                    animation: 200,
                    handle: '.drag-handle',
                    ghostClass: 'sortable-ghost',
                    chosenClass: 'sortable-chosen',
                    dragClass: 'sortable-drag',
                    filter: '.edit-scrim-btn, .delete-scrim-btn, .slot-btn-full',
                    preventOnFilter: false,
                    onEnd: async function(evt) {
                        if (evt.oldIndex === evt.newIndex) return;

                        const customDatePicker = document.getElementById('customDatePicker');
                        const isFiltered = customDatePicker && customDatePicker.value;
                        let orderedIds;

                        if (isFiltered) {
                            // When date filter is active, get visible cards of that date in their new order
                            const visibleCards = Array.from(scrimGrid.querySelectorAll('.scrim-card')).filter(card => card.style.display !== 'none');
                            orderedIds = visibleCards.map(c => c.getAttribute('data-id')).filter(Boolean);
                        } else {
                            // When all dates are shown, get all cards
                            const allCards = Array.from(scrimGrid.querySelectorAll('.scrim-card'));
                            orderedIds = allCards.map(c => c.getAttribute('data-id')).filter(Boolean);
                        }

                        if (!orderedIds || orderedIds.length === 0) return;

                        showToast('Saving new order...', 'loading', '<i class="fa-solid fa-spinner fa-spin"></i>');

                        try {
                            const response = await fetch(`/admin/category/${categoryId}/reorder-scrims`, {
                                method: 'POST',
                                headers: { 'Content-Type': 'application/json' },
                                body: JSON.stringify({ orderedIds })
                            });
                            const data = await response.json();
                            if (response.ok && data.success) {
                                showToast('Order saved successfully!', 'success', '<i class="fa-solid fa-circle-check"></i>');
                            } else {
                                showToast(data.msg || 'Failed to save order', 'error', '<i class="fa-solid fa-circle-exclamation"></i>');
                            }
                        } catch (err) {
                            console.error('Error reordering scrims:', err);
                            showToast('Network error while saving order', 'error', '<i class="fa-solid fa-triangle-exclamation"></i>');
                        }
                    }
                });
            }
        })();
    </script>
</body>
</html>
