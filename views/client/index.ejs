            <%
            function getCategoryIcon(title) {
                const t = (title || '').toLowerCase();
                if (t.includes('point') || t.includes('table') || t.includes('standing') || t.includes('rank') || t.includes('result') || t.includes('leaderboard')) {
                    return 'fa-solid fa-ranking-star';
                }
                if (t.includes('war') || t.includes('battle') || t.includes('combat') || t.includes('clash') || t.includes('fight')) {
                    return 'fa-solid fa-crosshairs';
                }
                if (t.includes('advance') || t.includes('pro') || t.includes('elite') || t.includes('tier') || t.includes('master')) {
                    return 'fa-solid fa-shield-halved';
                }
                if (t.includes('daily') || t.includes('grind') || t.includes('regular') || t.includes('practice')) {
                    return 'fa-solid fa-fire-flame-curved';
                }
                if (t.includes('tournament') || t.includes('cup') || t.includes('championship')) {
                    return 'fa-solid fa-trophy';
                }
                if (t.includes('paid') || t.includes('cash') || t.includes('prize') || t.includes('money')) {
                    return 'fa-solid fa-sack-dollar';
                }
                return 'fa-solid fa-gamepad';
            }
