<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>UBR Esports | Supporting Upcoming BGMI Talent</title>
    <link rel="icon" type="image/jpeg" href="/images/ubrLogo.png">
    <meta name="description" content="UBR Esports is a premier platform for rising BGMI talent, daily competitive scrims, custom tournaments, and fast prize withdrawals.">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/nav.css">
    <link rel="stylesheet" href="/css/footer.css">
</head>
<body>
    <div class="page-shell">
        <%- include("partials/nav", ) %>

        <main class="main-content">
            <section class="hero">
                <!-- <div class="hero-badge">
                    <span class="pulse-dot"></span>
                    <span>Live BGMI Tournaments</span>
                </div> -->
                <h1>SUPPORTING UPCOMING BGMI TALENT</h1>
                <p>UBR Esports is creating a dedicated arena for rising BGMI players, competitive squads, and passionate esports fans to compete, earn, and dominate the battleground.</p>
            </section>

            <section class="section-title">
                <h4>OUR TOP CATEGORIES</h4>
                <h2>Explore What We Offer</h2>
            </section>

            <div class="categories">
                <% for(category of categories) { %>
                <div class="category-card">
                    <div class="category-card-img">
                        <% if(category.img) { %>
                            <img src="<%= imageUrl(category.img) %>" alt="<%= category.title %>">
                        <% } else { %>
                            <i class="fa-solid fa-gamepad"></i>
                        <% } %>
                    </div>
                    <h3><%= category.title %></h3>
                    <p><%= category.description %></p>
                    <a href="/category/<%= category._id %>" class="card-btn">
                        <i class="fa-solid fa-calendar-days"></i>Explore
                    </a>
                </div>
                <% }  %>

                <!-- Point Table Category Card -->
                <div class="category-card">
                    <div class="category-card-img" style="background: linear-gradient(135deg, #1e2029, #13141b); display: flex; align-items: center; justify-content: center; color: #ff455e; font-size: 3rem; overflow: hidden;">
                        <% if (typeof pointTableCover !== 'undefined' && pointTableCover) { %>
                            <img src="<%= imageUrl(pointTableCover) %>" alt="Point Table" style="width: 100%; height: 100%; object-fit: cover; display: block;">
                        <% } else { %>
                            <i class="fa-solid fa-ranking-star"></i>
                        <% } %>
                    </div>
                    <h3>Point Table</h3>
                    <p>Check out the latest standings, points, and ranks of all completed matches and scrims.</p>
                    <a href="/point-table" class="card-btn">
                        <i class="fa-solid fa-calendar-days"></i>Explore
                    </a>
                </div>

            </div>
        </main>

        <%- include("partials/footer") %>
    </div>

</body>
</html>