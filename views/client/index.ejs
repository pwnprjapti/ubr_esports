    <script>
        const baseurl = "<%= typeof baseurl !== 'undefined' ? baseurl : '' %>";

        function switchMainTab(tab) {
            const categoriesView = document.getElementById('categoriesView');
            const tournamentsView = document.getElementById('tournamentsView');
            const tabScrims = document.getElementById('tabDailyScrims');
            const tabTournaments = document.getElementById('tabTournaments');

            if (tab === 'tournaments') {
                if (categoriesView) categoriesView.style.display = 'none';
                if (tournamentsView) tournamentsView.style.display = 'block';
                if (tabScrims) tabScrims.classList.remove('active');
                if (tabTournaments) tabTournaments.classList.add('active');
                try {
                    history.replaceState(null, null, '#tournaments');
                } catch(e) {}
            } else {
                if (categoriesView) categoriesView.style.display = 'block';
                if (tournamentsView) tournamentsView.style.display = 'none';
                if (tabTournaments) tabTournaments.classList.remove('active');
                if (tabScrims) tabScrims.classList.add('active');
                try {
                    history.replaceState(null, null, '#categories');
                } catch(e) {}
            }
        }

        let currentBookingParams = null;

        function initiateBooking(params) {
            const fee = Number(params.entryFee) || 0;
            currentBookingParams = params;

            const queryUrl = params.tournamentId 
                ? `/checksignin?tournamentId=${encodeURIComponent(params.tournamentId)}&title=${encodeURIComponent(params.title || '')}`
                : `/checksignin`;

            fetch(queryUrl)
                .then(res => res.json())
                .then(data => {
                    if (!data.authenticated) {
                        window.location.href = '/signin';
                        return;
                    }

                    if (!data.hasTeam) {
                        openTeamSettingsModal();
                        return;
                    }

                    if (!data.hasDrop) {
                        openDropDetailsModal();
                        return;
                    }

                    const totalBalance = Number(data.totalBalance) || 0;
                    if (fee > 0 && totalBalance < fee) {
                        alert(`Insufficient balance in your wallet. Required: ₹${fee}, Available: ₹${totalBalance}. Please add cash to book slot.`);
                        return;
                    }

                    const availableTeams = data.availableTeams || [];
                    if (availableTeams.length === 0) {
                        alert("All of your squads are already registered for this tournament! You can manage or create up to 4 teams in Team Settings.");
                        return;
                    }

                    openSelectTeamModal(params, availableTeams, totalBalance);
                })
                .catch(err => {
                    console.error("Auth check error:", err);
                    window.location.href = '/signin';
                });
        }

        function openSelectTeamModal(params, availableTeams, walletBalance) {
            document.getElementById('selectTeamMatchTitle').textContent = params.title || 'Tournament';
            document.getElementById('selectTeamMatchFee').textContent = '₹' + (params.entryFee || 0);
            document.getElementById('selectTeamWalletBal').textContent = '₹' + walletBalance;

            const listContainer = document.getElementById('selectTeamList');
            listContainer.innerHTML = '';

            availableTeams.forEach((team, index) => {
                const isChecked = index === 0 ? 'checked' : '';
                const logoHtml = team.teamLogo 
                    ? `<img src="${team.teamLogo.startsWith('http') ? team.teamLogo : '/images/' + team.teamLogo}" style="width: 42px; height: 42px; border-radius: 8px; object-fit: cover; flex-shrink: 0;">`
                    : `<div style="width: 42px; height: 42px; border-radius: 8px; background: rgba(212,27,35,0.15); display: flex; align-items: center; justify-content: center; color: #D41B23; font-size: 1.2rem; flex-shrink: 0;"><i class="fa-solid fa-shield-halved"></i></div>`;

                const teamItem = document.createElement('label');
                teamItem.style.cssText = 'display: flex; align-items: center; gap: 0.85rem; padding: 0.85rem; background: rgba(255,255,255,0.03); border: 1.5px solid rgba(255,255,255,0.08); border-radius: 12px; cursor: pointer; transition: all 0.2s;';
                teamItem.innerHTML = `
                    <input type="radio" name="selectedTeamRadio" value="${team._id}" data-name="${escapeHtml(team.teamName)}" ${isChecked} style="accent-color: #D41B23; transform: scale(1.15); margin: 0;">
                    ${logoHtml}
                    <div style="flex: 1; min-width: 0;">
                        <div style="font-weight: 800; color: #ffffff; font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${escapeHtml(team.teamName)}</div>
                        <div style="font-size: 0.78rem; color: #25d366; display: flex; align-items: center; gap: 0.3rem; margin-top: 2px;">
                            <i class="fa-brands fa-whatsapp"></i> +91 ${team.whatsappNumber || ''}
                        </div>
                    </div>
                `;
                listContainer.appendChild(teamItem);
            });

            document.getElementById('selectTeamModal').style.display = 'flex';
        }

        function closeSelectTeamModal() {
            document.getElementById('selectTeamModal').style.display = 'none';
        }

        let currentSlotWhatsappUrl = '';

        function openSlotSuccessModal(params) {
            const modal = document.getElementById('slotSuccessModal');
            const squadText = document.getElementById('slotSuccessSquadText');
            const waWrap = document.getElementById('slotSuccessWhatsappWrap');
            const waBtn = document.getElementById('slotSuccessWhatsappBtn');
            const copyWaBtn = document.getElementById('slotSuccessCopyWaBtn');

            if (squadText) {
                if (params && params.squadName) {
                    squadText.innerHTML = `Your squad <strong style="color: #ffffff;">${escapeHtml(params.squadName)}</strong> has been registered!`;
                } else if (params && params.msg) {
                    squadText.textContent = params.msg;
                } else {
                    squadText.textContent = "Your slot has been confirmed.";
                }
            }

            if (waWrap && waBtn) {
                if (params && params.whatsappGroupLink && params.whatsappGroupLink.trim() !== '') {
                    currentSlotWhatsappUrl = params.whatsappGroupLink.trim();
                    waBtn.href = currentSlotWhatsappUrl;
                    waWrap.style.display = 'flex';
                } else {
                    currentSlotWhatsappUrl = '';
                    waWrap.style.display = 'none';
                }
            }

            if (copyWaBtn) {
                copyWaBtn.innerHTML = '<i class="fa-regular fa-copy"></i> <span>Copy WhatsApp Link</span>';
                copyWaBtn.style.backgroundColor = 'rgba(37, 211, 102, 0.12)';
                copyWaBtn.style.color = '#25d366';
            }

            if (modal) {
                modal.style.display = 'flex';
            }
        }

        function copySlotWhatsAppLink(btn) {
            if (!currentSlotWhatsappUrl) {
                if (typeof showToast === 'function') {
                    showToast('WhatsApp Group Link not available.', 'error');
                } else {
                    alert('WhatsApp Group Link not available.');
                }
                return;
            }
            if (typeof copyWhatsAppLink === 'function') {
                copyWhatsAppLink(currentSlotWhatsappUrl, btn);
            }
            if (typeof showToast === 'function') {
                showToast('WhatsApp group link copied!', 'success');
            }
        }

        function closeSlotSuccessModal() {
            const modal = document.getElementById('slotSuccessModal');
            if (modal) {
                modal.style.display = 'none';
            }
            window.location.reload();
        }

        async function confirmSelectedTeamBooking() {
            const selectedRadio = document.querySelector('input[name="selectedTeamRadio"]:checked');
            if (!selectedRadio) {
                alert("Please select a squad to register.");
                return;
            }

            const teamId = selectedRadio.value;
            const teamName = selectedRadio.getAttribute('data-name') || '';
            const confirmBtn = document.getElementById('confirmBookTeamBtn');
            const originalBtnHtml = confirmBtn.innerHTML;

            try {
                confirmBtn.disabled = true;
                confirmBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Registering Squad...';

                const formData = new FormData();
                formData.append('tournamentId', currentBookingParams.tournamentId);
                formData.append('teamId', teamId);

                const res = await fetch('/book-tournament', {
                    method: 'POST',
                    body: formData,
                    credentials: 'include'
                });

                if (res.status === 401) {
                    window.location.href = '/signin';
                    return;
                }

                const result = await res.json();

                if (res.status === 200) {
                    closeSelectTeamModal();
                    openSlotSuccessModal({
                        squadName: teamName,
                        whatsappGroupLink: result.whatsappGroupLink || '',
                        slotNumber: result.slotNumber || 1,
                        msg: result.msg
                    });
                } else {
                    alert(result.msg);
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = originalBtnHtml;
                }
            } catch (err) {
                console.error("Booking error:", err);
                alert("Something went wrong. Please try again.");
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = originalBtnHtml;
            }
        }

        function openTeamSettingsModal() {
            document.getElementById('teamSettingsModal').style.display = 'flex';
        }

        function closeTeamSettingsModal() {
            document.getElementById('teamSettingsModal').style.display = 'none';
            document.getElementById('popTeamSettingsForm').reset();
        }

        function openDropDetailsModal() {
            document.getElementById('dropDetailsModal').style.display = 'flex';
        }

        function closeDropDetailsModal() {
            document.getElementById('dropDetailsModal').style.display = 'none';
            document.getElementById('popDropDetailsForm').reset();
        }

        async function submitPopTeamSettings(event) {
            event.preventDefault();
            const form = event.target;
            const submitBtn = document.getElementById('popTeamSubmitBtn');
            const originalHtml = submitBtn.innerHTML;

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';

            const formData = new FormData(form);

            try {
                const res = await fetch(`/team-settings`, {
                    method: 'POST',
                    body: formData
                });

                const result = await res.json();
                alert(result.msg);

                if (res.status === 200) {
                    closeTeamSettingsModal();
                    if (currentBookingParams) {
                        initiateBooking(currentBookingParams);
                    }
                } else {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalHtml;
                }
            } catch (err) {
                console.error("Save team error:", err);
                alert("Something went wrong. Please try again.");
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalHtml;
            }
        }

        async function submitPopDropDetails(event) {
            event.preventDefault();
            const form = event.target;
            const submitBtn = document.getElementById('popDropSubmitBtn');
            const originalHtml = submitBtn.innerHTML;

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';

            const payload = {
                erangle: document.getElementById('popErangle').value.trim(),
                rando: document.getElementById('popRando').value.trim(),
                miramar: document.getElementById('popMiramar').value.trim()
            };

            try {
                const res = await fetch(`/drop-details`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const result = await res.json();

                if (res.ok) {
                    alert(typeof result === 'string' ? result : 'Drop details saved successfully!');
                    closeDropDetailsModal();
                    if (currentBookingParams) {
                        initiateBooking(currentBookingParams);
                    }
                } else {
                    alert(result.msg || 'Failed to save drop details.');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalHtml;
                }
            } catch (err) {
                console.error("Save drop error:", err);
                alert("Something went wrong. Please try again.");
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalHtml;
            }
        }

        function showUserRegisteredTeams(btn, event) {
            if (event) {
                event.preventDefault();
                event.stopPropagation();
            }

            try {
                const modal = document.getElementById('infoModal');
                const modalTitle = document.getElementById('modalTitle');
                const modalBody = document.getElementById('modalBody');

                if (!modal || !modalTitle || !modalBody) {
                    console.error("infoModal elements not found!");
                    return;
                }

                let teams = [];
                const raw = btn.getAttribute('data-teams');
                if (raw) {
                    try {
                        teams = JSON.parse(decodeURIComponent(raw));
                    } catch (err) {
                        console.error("Error parsing encoded data-teams", err);
                    }
                }

                // Fallback to textContent of .user-reg-data if needed
                if (!teams || teams.length === 0) {
                    const dataEl = btn.querySelector('.user-reg-data');
                    if (dataEl && dataEl.textContent) {
                        try {
                            teams = JSON.parse(dataEl.textContent.trim());
                        } catch (err) {
                            console.error("Error parsing fallback user-reg-data", err);
                        }
                    }
                }

                modalTitle.textContent = "Your Registered Teams";

                if (!teams || teams.length === 0) {
                    modalBody.innerHTML = `
                        <div style="text-align: center; padding: 2rem 1rem; color: #9e9ea7;">
                            <i class="fa-solid fa-shield-halved" style="font-size: 2.5rem; color: #D41B23; margin-bottom: 1rem; display: block;"></i>
                            <p style="margin: 0; font-weight: 700; font-size: 1rem; color: #ffffff;">No squad registered yet by you.</p>
                            <p style="margin: 0.35rem 0 0; font-size: 0.85rem; color: #9e9ea7;">Book a slot to see your squad listed here.</p>
                        </div>
                    `;
                } else {
                    let listHtml = `
                        <div style="margin-bottom: 1rem; font-size: 0.88rem; color: #a0a0aa; text-align: left;">
                            Registered squad(s) for this tournament: <strong style="color: #ffffff;">${teams.length}</strong>
                        </div>
                        <div style="display: flex; flex-direction: column; gap: 0.75rem; max-height: 350px; overflow-y: auto; padding-right: 2px;">
                    `;
                    teams.forEach(team => {
                        const rawLogo = team.teamLogo || '';
                        const logoUrl = rawLogo 
                            ? (rawLogo.startsWith('http://') || rawLogo.startsWith('https://') ? rawLogo : `/images/${rawLogo}`)
                            : '';
                        const logoHtml = logoUrl 
                            ? `<img src="${logoUrl}" alt="${escapeHtml(team.teamName || 'Squad')}" style="width: 100%; height: 100%; object-fit: cover;">`
                            : `<i class="fa-solid fa-shield-halved"></i>`;
                        
                        const phone = team.whatsappNumber ? String(team.whatsappNumber) : '';
                        
                        listHtml += `
                            <div style="display: flex; align-items: center; gap: 0.85rem; padding: 0.85rem; background: rgba(255, 255, 255, 0.03); border: 1px solid rgba(212, 27, 35, 0.25); border-radius: 12px;">
                                <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(212, 27, 35, 0.15); display: flex; align-items: center; justify-content: center; overflow: hidden; flex-shrink: 0; color: #D41B23; font-size: 1.2rem;">
                                    ${logoHtml}
                                </div>
                                <div style="flex: 1; min-width: 0; text-align: left;">
                                    <div style="color: #ffffff; font-weight: 800; font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                        ${escapeHtml(team.teamName || 'Squad')}
                                    </div>
                                    ${phone ? `
                                        <div style="font-size: 0.78rem; color: #25d366; display: flex; align-items: center; gap: 0.35rem; margin-top: 3px;">
                                            <i class="fa-brands fa-whatsapp"></i> +91 ${escapeHtml(phone)}
                                        </div>
                                    ` : ''}
                                </div>
                                <div style="flex-shrink: 0;">
                                    <span style="font-size: 0.72rem; font-weight: 800; padding: 0.25rem 0.6rem; border-radius: 999px; background: rgba(37, 211, 102, 0.15); color: #25d366; border: 1px solid rgba(37, 211, 102, 0.35);">
                                        <i class="fa-solid fa-check"></i> Registered
                                    </span>
                                </div>
                            </div>
                        `;
                    });
                    listHtml += '</div>';
                    modalBody.innerHTML = listHtml;
                }

                modal.style.display = 'flex';
            } catch (err) {
                console.error("Error in showUserRegisteredTeams:", err);
            }
        }

        function showTournamentTeams(btn) {
            const isBooked = btn.getAttribute('data-booked') === 'true';
            const modal = document.getElementById('infoModal');
            const modalTitle = document.getElementById('modalTitle');
            const modalBody = document.getElementById('modalBody');

            if (!isBooked) {
                modalTitle.textContent = "Access Restricted";
                modalBody.innerHTML = `
                    <div style="text-align: center; padding: 2rem 1rem; color: #9e9ea7;">
                        <i class="fa-solid fa-lock" style="font-size: 2.5rem; color: #D41B23; margin-bottom: 1rem; display: block;"></i>
                        <p style="margin: 0; font-size: 1.15rem; font-weight: 800; color: #ffffff;">Book slot to view teams</p>
                        <p style="margin: 0.5rem 0 0; font-size: 0.88rem; color: #9e9ea7;">
                            Tournament me registered teams dekhne ke liye pehle apna slot book karein.
                        </p>
                    </div>
                `;
                modal.style.display = 'flex';
                return;
            }

            const teamsJsonEl = btn.querySelector('.teams-data');
            let teams = [];
            try {
                if (teamsJsonEl && teamsJsonEl.textContent) {
                    teams = JSON.parse(teamsJsonEl.textContent.trim());
                }
            } catch(e) {
                console.error("Error parsing teams data", e);
            }

            modalTitle.textContent = "Registered Teams";
            
            if (teams.length === 0) {
                modalBody.innerHTML = `
                    <div style="text-align: center; padding: 2rem 1rem; color: #9e9ea7;">
                        <i class="fa-solid fa-users-slash" style="font-size: 2.5rem; color: #D41B23; margin-bottom: 1rem; display: block;"></i>
                        <p style="margin: 0; font-weight: 600;">No teams registered yet.</p>
                        <p style="margin: 0.25rem 0 0; font-size: 0.85rem;">Be the first squad to sign up!</p>
                    </div>
                `;
            } else {
                let listHtml = '<div class="modal-teams-list">';
                teams.forEach(team => {
                    const logoUrl = team.teamLogo 
                        ? (team.teamLogo.startsWith('http://') || team.teamLogo.startsWith('https://') ? team.teamLogo : `/images/${team.teamLogo}`)
                        : '';
                    const logoHtml = logoUrl 
                        ? `<img src="${logoUrl}" alt="${team.teamName}">`
                        : `<i class="fa-solid fa-shield-halved"></i>`;
                    
                    listHtml += `
                        <div class="modal-team-item">
                            <div class="modal-team-logo">
                                ${logoHtml}
                            </div>
                            <div class="modal-team-name">${escapeHtml(team.teamName)}</div>
                        </div>
                    `;
                });
                listHtml += '</div>';
                modalBody.innerHTML = listHtml;
            }

            modal.style.display = 'flex';
        }

        function showTournamentDetails(btn) {
            const dataEl = btn.querySelector('.match-data');
            if (!dataEl) return;

            const detailsText = dataEl.getAttribute('data-details') || '';

            const modal = document.getElementById('infoModal');
            const modalTitle = document.getElementById('modalTitle');
            const modalBody = document.getElementById('modalBody');

            modalTitle.textContent = "Tournament Details";

            modalBody.innerHTML = `
                <div style="white-space: pre-wrap; font-size: 0.95rem; line-height: 1.6; color: #c4c4cc; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.04); border-radius: 12px; padding: 1rem; text-align: left; box-sizing: border-box; width: 100%;">
                    ${escapeHtml(detailsText || 'No details provided.')}
                </div>
            `;

            modal.style.display = 'flex';
        }

        function closeModal() {
            const modal = document.getElementById('infoModal');
            if (modal) modal.style.display = 'none';
        }

        window.addEventListener('click', function(event) {
            const modal = document.getElementById('infoModal');
            const teamModal = document.getElementById('teamSettingsModal');
            const dropModal = document.getElementById('dropDetailsModal');
            const selectModal = document.getElementById('selectTeamModal');
            const slotSuccess = document.getElementById('slotSuccessModal');
            if (event.target === modal) closeModal();
            if (event.target === teamModal) closeTeamSettingsModal();
            if (event.target === dropModal) closeDropDetailsModal();
            if (event.target === selectModal) closeSelectTeamModal();
            if (event.target === slotSuccess) closeSlotSuccessModal();
        });

        document.addEventListener('keydown', function(event) {
            if (event.key === 'Escape') {
                const slotSuccess = document.getElementById('slotSuccessModal');
                if (slotSuccess && slotSuccess.style.display === 'flex') {
                    closeSlotSuccessModal();
                }
            }
        });

        function escapeHtml(str) {
            if (str === null || str === undefined) return '';
            return String(str)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#039;");
        }

        function copyWhatsAppLink(link, btn) {
            if (!link) {
                alert("WhatsApp Group Link not available.");
                return;
            }

            function showSuccess() {
                const origHtml = btn.innerHTML;
                btn.innerHTML = '<i class="fa-solid fa-check"></i> <span>Link Copied!</span>';
                btn.style.backgroundColor = '#25d366';
                btn.style.color = '#ffffff';
                setTimeout(() => {
                    btn.innerHTML = origHtml;
                    btn.style.backgroundColor = 'rgba(37, 211, 102, 0.12)';
                    btn.style.color = '#25d366';
                }, 2500);
            }

            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(link).then(() => {
                    showSuccess();
                }).catch(err => {
                    fallbackCopyWhatsApp(link, showSuccess);
                });
            } else {
                fallbackCopyWhatsApp(link, showSuccess);
            }
        }

        function fallbackCopyWhatsApp(text, onSuccess) {
            try {
                const textarea = document.createElement('textarea');
                textarea.value = text;
                textarea.style.position = 'fixed';
                textarea.style.left = '-9999px';
                document.body.appendChild(textarea);
                textarea.select();
                const successful = document.execCommand('copy');
                document.body.removeChild(textarea);
                if (successful && onSuccess) {
                    onSuccess();
                } else {
                    prompt('Copy WhatsApp Group Link:', text);
                }
            } catch (e) {
                prompt('Copy WhatsApp Group Link:', text);
            }
        }

        document.addEventListener('DOMContentLoaded', function() {
            if (window.location.hash === '#tournaments') {
                switchMainTab('tournaments');
            }
        });
    </script>
</body>
</html>