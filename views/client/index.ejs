                    }
                    .category-card-stats .stat-item,
                    .category-card-stats .cat-stat-item {
                        gap: 0.3rem !important;
                        background: transparent !important;
                        border: none !important;
                        padding: 0 !important;
                    }
                    .category-card-stats .stat-icon {
                        font-size: 1.05rem !important;
                        margin-right: 0.42rem !important;
                    }
                    .category-card-stats .stat-value {
