                /* Modal overlay styling */
                .modal-overlay {
                    position: fixed;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 100%;
                    background-color: rgba(0, 0, 0, 0.75);
                    backdrop-filter: blur(5px);
                    display: none;
                    align-items: center;
                    justify-content: center;
                    z-index: 2000;
                    padding: 1rem;
                    box-sizing: border-box;
                }

                .modal-content {
                    background-color: #151720;
                    border: 1px solid rgba(255, 255, 255, 0.08);
                    border-radius: 20px;
                    width: 100%;
                    max-width: 500px;
                    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
                    display: flex;
                    flex-direction: column;
                    max-height: 85vh;
                    animation: modalFadeIn 0.3s ease;
                }

                @keyframes modalFadeIn {
                    from { transform: translateY(20px); opacity: 0; }
                    to { transform: translateY(0); opacity: 1; }
                }

                .modal-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    padding: 1.25rem 1.5rem;
                    border-bottom: 1px solid rgba(255, 255, 255, 0.08);
                }

                .modal-header h3 {
                    margin: 0;
                    font-size: 1.3rem;
                    font-weight: 800;
                    color: #ffffff;
                }

                .modal-close-btn {
                    background: transparent;
                    border: none;
                    font-size: 1.8rem;
                    color: #9e9ea7;
                    cursor: pointer;
                    transition: color 0.2s ease;
                    line-height: 1;
                }

                .modal-close-btn:hover {
                    color: #D41B23;
                }

                .modal-body {
                    padding: 1.5rem;
                    overflow-y: auto;
                    color: #f5f5f7;
                    font-size: 0.95rem;
                }

                .modal-teams-list {
                    display: grid;
                    grid-template-columns: repeat(2, 1fr);
                    gap: 0.75rem;
                }

                .modal-team-item {
                    display: flex;
                    align-items: center;
                    gap: 1rem;
                    padding: 0.75rem 1rem;
                    background: rgba(255, 255, 255, 0.02);
                    border: 1px solid rgba(255, 255, 255, 0.04);
                    border-radius: 12px;
                }

                .modal-team-logo {
                    width: 40px;
                    height: 40px;
                    border-radius: 50%;
                    background: rgba(155, 7, 7, 0.15);
                    color: #D41B23;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    overflow: hidden;
                    font-size: 1.2rem;
                }

                .modal-team-logo img {
                    width: 100%;
                    height: 100%;
                    object-fit: cover;
                }

                .modal-team-name {
                    font-weight: 700;
                    color: #ffffff;
                }

                .selected-date-banner {
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    gap: 1rem;
                    margin: 1.25rem auto;
                    width: 100%;
                    max-width: 600px;
                }

                .selected-date-banner .line {
                    flex: 1;
                    height: 1px;
                    background: rgba(212, 27, 35, 0.4);
                }

                .selected-date-banner .date-text {
                    color: #D41B23;
                    font-size: 0.85rem;
                    font-weight: 700;
                    letter-spacing: 0.08em;
                    text-transform: uppercase;
                    background: transparent;
                    border: none;
                    padding: 0 0.5rem;
                    text-shadow: none;
                    white-space: nowrap;
                }

                .scrim-card {
                    order: 1;
                }
                .scrim-card.scrim-card-full {
                    order: 2;
                    opacity: 0.92;
                }

                .card-top-bar {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    gap: 0.75rem;
                    padding-bottom: 0.75rem;
                    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
                    margin-bottom: 0.85rem;
                    width: 100%;
                }

                .slot-assigned-badge {
                    font-size: 0.78rem;
                    font-weight: 800;
                    color: #22c55e;
                    background: rgba(34, 197, 94, 0.12);
                    border: 1px solid rgba(34, 197, 94, 0.3);
                    padding: 0.25rem 0.65rem;
                    border-radius: 999px;
                    display: inline-flex;
                    align-items: center;
                    gap: 0.35rem;
                    white-space: nowrap;
                }

                .slot-assigned-badge.full {
                    color: #ef4444;
                    background: rgba(239, 68, 68, 0.12);
                    border-color: rgba(239, 68, 68, 0.3);
                }
            </style>

            <div class="categories">
                <% for(category of categories) { %>
                <div class="category-card">
                    <!-- Top: Larger Category Icon (Left) + Text (Heading & Paragraph on Right) -->
                    <div class="category-card-header-row">
                        <div class="category-card-icon-badge">
                            <i class="<%= getCategoryIcon(category.title) %>"></i>
                        </div>
                        <div class="category-card-text-col">
                            <h3><%= category.title %></h3>
                            <p><%= category.description %></p>
                        </div>
                    </div>

                    <!-- Category Image -->
                    <div class="category-card-img">
                        <% if(category.img) { %>
                            <img src="<%= imageUrl(category.img) %>" alt="<%= category.title %>">
                        <% } else { %>
                            <i class="<%= getCategoryIcon(category.title) %>"></i>
                        <% } %>
                    </div>

                    <!-- Meta Highlights Row (Teams | Entry Fee | Prize Pool) -->
                    <div class="category-card-stats">
                        <div class="stat-item cat-stat-item">
                            <div class="stat-icon">
                                <i class="fa-solid fa-users"></i>
                            </div>
                            <div class="stat-text">
                                <span class="stat-value"><%= category.teams || '16-18' %></span>
                                <span class="stat-label">Teams</span>
                            </div>
                        </div>
                        <div class="stat-v-divider"></div>
                        <div class="stat-item cat-stat-item">
                            <div class="stat-icon">
                                <i class="fa-solid fa-indian-rupee-sign"></i>
                            </div>
                            <div class="stat-text">
                                <% 
                                    let rawFee = category.entryFee || '60';
                                    let displayFee = rawFee.toString().trim();
                                    if (displayFee.toLowerCase() !== 'free' && !displayFee.toUpperCase().includes('INR') && !displayFee.startsWith('₹')) {
                                        displayFee += ' INR';
                                    }
                                %>
                                <span class="stat-value"><%= displayFee %></span>
                                <span class="stat-label">Entry Fee</span>
                            </div>
                        </div>
                        <div class="stat-v-divider"></div>
                        <div class="stat-item cat-stat-item">
                            <div class="stat-icon">
                                <i class="fa-solid fa-trophy"></i>
                            </div>
                            <div class="stat-text">
                                <span class="stat-value"><%= category.prizePool || '1000' %></span>
                                <span class="stat-label">Prize Pool</span>
                            </div>
                        </div>
                    </div>

                    <!-- View Details Action Button -->
                    <a href="/category/<%= category._id %>" class="card-btn">
                        <i class="fa-solid fa-calendar-days"></i>View Details
                    </a>
                </div>
                <% }  %>

            </div> <!-- /.categories -->
            </div> <!-- /#categoriesView -->

            <!-- Tournaments Section (shown when Tournaments tab is clicked) -->
            <div id="tournamentsView" style="display: none;">
                <section class="section-title" id="tournamentsSection">
                    <h4>COMPETITIVE TOURNAMENTS</h4>
                </section>

                <% 
                    const hasTournaments = Array.isArray(tournaments) && tournaments.length > 0;
                    const sortedTournaments = hasTournaments ? [...tournaments].sort((a, b) => {
                        const aTeams = (a && a.teams && Array.isArray(a.teams)) ? a.teams.length : 0;
                        const aSlots = (a && Number(a.slots)) || 0;
                        const aFull = (aSlots > 0 && aTeams >= aSlots) ? 1 : 0;

                        const bTeams = (b && b.teams && Array.isArray(b.teams)) ? b.teams.length : 0;
                        const bSlots = (b && Number(b.slots)) || 0;
                        const bFull = (bSlots > 0 && bTeams >= bSlots) ? 1 : 0;

                        return aFull - bFull;
                    }) : [];
                %>

                <div class="no-scrims-card" id="noTournamentsMsg" style="display: <%= hasTournaments ? 'none' : 'block' %>;">
                    <div class="empty-icon"><i class="fa-solid fa-trophy"></i></div>
                    <h3>No Tournaments Found</h3>
                    <p>There are no tournaments currently scheduled. Please check back later!</p>
                </div>

                <% if (hasTournaments) { %>
                <section class="scrim-grid" id="tournamentsGrid">
                    <% for (const tournament of sortedTournaments) { %>
                        <% const approvedTeams = (tournament.teams || []).filter(t => t.status === "approved" || !t.status); %>
                        <% 
                        const userTeamIdStrings = (typeof userTeams !== 'undefined' && Array.isArray(userTeams))
                            ? userTeams.map(t => t && t._id ? t._id.toString() : '').filter(Boolean)
                            : [];
                        const userRegTeams = (tournament.teams && Array.isArray(tournament.teams))
                            ? tournament.teams.filter(t => {
                                if (!t) return false;
                                const tId = t._id ? t._id.toString() : '';
                                const tTeamId = t.teamId ? t.teamId.toString() : '';
                                const tName = t.teamName ? t.teamName.toString().trim().toLowerCase() : '';
                                const idMatch = (tId && userTeamIdStrings.includes(tId)) || (tTeamId && userTeamIdStrings.includes(tTeamId));
                                const nameMatch = tName && (
                                    (typeof userTeamNames !== 'undefined' && Array.isArray(userTeamNames) && userTeamNames.some(ut => ut && ut.toString().trim().toLowerCase() === tName)) ||
                                    (typeof userTeamName !== 'undefined' && userTeamName && userTeamName.toString().trim().toLowerCase() === tName)
                                );
                                return idMatch || nameMatch;
                            })
                            : [];
                        const isJoined = userRegTeams.length > 0;
                        const isTournamentFull = Boolean(tournament.slots && (tournament.teams ? tournament.teams.length : 0) >= tournament.slots);
                        const remainingTournamentSlots = Math.max(0, (tournament.slots || 0) - (tournament.teams ? tournament.teams.length : 0));
                        %>
                        <article class="scrim-card <%= isTournamentFull ? 'scrim-card-full' : '' %>" data-date="<%= tournament.date %>" data-period="today" data-full="<%= isTournamentFull ? 'true' : 'false' %>">
                            <!-- Top Bar: Tournament Badge + Remaining Slots -->
                            <div class="card-top-bar">
                                <span style="background: linear-gradient(135deg, #d97706, #b45309); color: #fff; font-size: 0.68rem; font-weight: 900; padding: 0.22rem 0.65rem; border-radius: 6px; text-transform: uppercase; letter-spacing: 0.06em; display: inline-flex; align-items: center; gap: 0.35rem; box-shadow: 0 2px 8px rgba(217, 119, 6, 0.35);">
                                    <i class="fa-solid fa-trophy"></i> Tournament
                                </span>
                                <% if (remainingTournamentSlots > 0) { %>
                                    <span class="slot-assigned-badge">
                                        <i class="fa-solid fa-users"></i> <%= remainingTournamentSlots %> <%= remainingTournamentSlots === 1 ? 'Slot' : 'Slots' %> Left
                                    </span>
                                <% } else { %>
                                    <span class="slot-assigned-badge full">
                                        <i class="fa-solid fa-ban"></i> Slots Full
                                    </span>
                                <% } %>
                            </div>
                            <h3 class="scrim-title"><%= tournament.title %></h3>
                            <div class="scrim-meta">
                                <div class="meta-item">
                                    <span class="meta-label"><i class="fa-regular fa-calendar"></i> Match Date</span>
                                    <span class="meta-val highlight-date"><%= tournament.date %></span>
                                </div>
                                <div class="meta-item">
                                    <span class="meta-label"><i class="fa-solid fa-sack-dollar"></i> Prize Pool</span>
                                    <span class="meta-val prize">₹ <%= Number(tournament.prizePool).toLocaleString('en-IN') %></span>
                                </div>
                                <div class="meta-item" style="flex-direction: column; align-items: flex-start; gap: 0.4rem; width: 100%;">
                                    <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                                        <span class="meta-label"><i class="fa-solid fa-users"></i> Slots Booked</span>
                                        <span class="meta-val slot-highlight"> <%= (tournament.teams ? tournament.teams.length : 0) %> / <%= tournament.slots %> </span>
                                    </div>
                                    <% const filledPercentage = Math.min(100, Math.round(((tournament.teams ? tournament.teams.length : 0) / (tournament.slots || 1)) * 100)); %>
                                    <div class="progress-bar-container" style="width: 100%; height: 8px; background: rgba(255, 255, 255, 0.08); border-radius: 999px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.04);">
                                        <div class="progress-bar-fill" style="width: <%= filledPercentage %>%; height: 100%; background: <%= (tournament.teams && tournament.teams.length >= tournament.slots) ? '#D41B23' : 'linear-gradient(90deg, #4ade80, #22c55e)' %>; border-radius: 999px; transition: width 0.3s ease;"></div>
                                    </div>
                                </div>
                                <div class="meta-item">
                                    <span class="meta-label"><i class="fa-solid fa-rupee-sign"></i> Entry Fee</span>
                                    <span class="meta-val slot-highlight"> ₹<%= tournament.entryFee %> </span>
                                </div>
                            </div>
                            <div class="idp-timing">
                                <span class="meta-label"><i class="fa-regular fa-clock"></i> IDP Timing</span>
                                <div class="timings">
                                    <% const timings = (tournament.idpTimings || '').split(","); %>
                                    <% for (const time of timings) { %>
                                        <% if (time.trim()) { %>
                                            <span><%= time.trim() %></span>
                                        <% } %>
                                    <% } %>
                                </div>
                            </div>
                            <% if (tournament.maps) { %>
                            <div class="idp-timing" style="margin-top: 10px;">
                                <span class="meta-label"><i class="fa-solid fa-map"></i> Maps</span>
                                <div class="timings">
                                    <% const mapsList = tournament.maps.split(","); %>
                                    <% for (const mapName of mapsList) { %>
                                        <% if (mapName.trim()) { %>
                                            <span><%= mapName.trim() %></span>
                                        <% } %>
                                    <% } %>
                                </div>
                            </div>
                            <% } %>
                           
                            <div class="card-actions-grid" style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; width: 100%;">
                                  <% if (isJoined) { %>
                                      <% if (tournament.whatsappGroupLink) { %>
                                          <div style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%;">
                                              <a href="<%= tournament.whatsappGroupLink %>" target="_blank" class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: #25d366; color: white; text-decoration: none; font-weight: 800; border-radius: 8px; box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35); transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#128c7e'" onmouseout="this.style.backgroundColor='#25d366'">
                                                  <i class="fa-brands fa-whatsapp" style="margin-right: 0.5rem; font-size: 1.1rem;"></i> TAP TO JOIN IDP GROUP
                                              </a>
                                              <button type="button" class="slot-btn" onclick="copyWhatsAppLink('<%= tournament.whatsappGroupLink %>', this)" title="Copy WhatsApp Group Link" style="width: 100%; min-height: 40px; margin: 0; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; background: rgba(37, 211, 102, 0.12); border: 1px solid rgba(37, 211, 102, 0.5); color: #25d366; border-radius: 8px; cursor: pointer; transition: all 0.2s; font-weight: 700; font-size: 0.88rem;" onmouseover="this.style.backgroundColor='rgba(37, 211, 102, 0.22)'" onmouseout="this.style.backgroundColor='rgba(37, 211, 102, 0.12)'">
                                                  <i class="fa-regular fa-copy"></i> <span>Copy WhatsApp Link</span>
                                              </button>
                                              <% if (isTournamentFull) { %>
                                                  <button class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: #6c757d; color: white;" disabled>
                                                      <i class="fa-solid fa-ban"></i> Slots Full
                                                  </button>
                                              <% } else { %>
                                                  <button type="button" class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: #D41B23; color: white; font-weight: 800;" onclick="initiateBooking({ type: 'tournament', tournamentId: '<%= tournament._id %>', title: '<%= tournament.title %>', entryFee: '<%= tournament.entryFee %>' })">
                                                      <i class="fa-solid fa-plus-circle"></i> Book More Slot
                                                  </button>
                                              <% } %>
                                              <div style="text-align: center; margin-top: 0.35rem; width: 100%;">
                                                  <button type="button" class="user-registered-teams-link" data-teams="<%- encodeURIComponent(JSON.stringify(userRegTeams.map(t => ({ _id: t._id, teamName: t.teamName, teamLogo: t.teamLogo, whatsappNumber: t.whatsappNumber })))) %>" onclick="showUserRegisteredTeams(this, event)" style="background: transparent; border: none; color: #38bdf8; font-size: 0.86rem; font-weight: 700; text-decoration: underline; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.35rem 0.6rem; transition: color 0.2s;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#38bdf8'">
                                                      <i class="fa-solid fa-shield-halved"></i> See your registered teams
                                                      <span class="user-reg-data" style="display: none;"><%- JSON.stringify(userRegTeams) %></span>
                                                  </button>
                                              </div>
                                          </div>
                                      <% } else { %>
                                         <div style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%;">
                                             <button class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: #28a745; color: white;" disabled>
                                                 <i class="fa-solid fa-circle-check"></i> Booked Successfully
                                             </button>
                                             <% if (isTournamentFull) { %>
                                                 <button class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: #6c757d; color: white;" disabled>
                                                     <i class="fa-solid fa-ban"></i> Slots Full
                                                 </button>
                                             <% } else { %>
                                                 <button type="button" class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: #D41B23; color: white; font-weight: 800;" onclick="initiateBooking({ type: 'tournament', tournamentId: '<%= tournament._id %>', title: '<%= tournament.title %>', entryFee: '<%= tournament.entryFee %>' })">
                                                     <i class="fa-solid fa-plus-circle"></i> Book More Slot
                                                 </button>
                                             <% } %>
                                             <div style="text-align: center; margin-top: 0.35rem; width: 100%;">
                                                 <button type="button" class="user-registered-teams-link" data-teams="<%- encodeURIComponent(JSON.stringify(userRegTeams.map(t => ({ _id: t._id, teamName: t.teamName, teamLogo: t.teamLogo, whatsappNumber: t.whatsappNumber })))) %>" onclick="showUserRegisteredTeams(this, event)" style="background: transparent; border: none; color: #38bdf8; font-size: 0.86rem; font-weight: 700; text-decoration: underline; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.35rem 0.6rem; transition: color 0.2s;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#38bdf8'">
                                                     <i class="fa-solid fa-shield-halved"></i> See your registered teams
                                                     <span class="user-reg-data" style="display: none;"><%- JSON.stringify(userRegTeams) %></span>
                                                 </button>
                                             </div>
                                         </div>
                                      <% } %>
                                  <% } else { %>
                                      <% if (isTournamentFull) { %>
                                          <button class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: #6c757d; color: white;" disabled>
                                              <i class="fa-solid fa-ban"></i> Slots Full
                                          </button>
                                      <% } else { %>
                                          <button class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center;" onclick="initiateBooking({ type: 'tournament', tournamentId: '<%= tournament._id %>', title: '<%= tournament.title %>', entryFee: '<%= tournament.entryFee %>' })"><i class="fa-solid fa-ticket"></i> Book Slot</button>
                                      <% } %>
                                  <% } %>
                                  <div class="secondary-actions" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; width: 100%;">
                                      <button type="button" class="pay-btn" style="min-height: 38px; padding: 0.5rem; font-size: 0.85rem; width: 100%;" data-booked="<%= isJoined %>" onclick="showTournamentTeams(this)">
                                          <i class="fa-solid fa-users"></i> View Teams
                                          <span class="teams-data" style="display: none;"><%- isJoined ? JSON.stringify(approvedTeams) : '[]' %></span>
                                      </button>
                                     <button type="button" class="pay-btn" style="min-height: 38px; padding: 0.5rem; font-size: 0.85rem; width: 100%;" onclick="showTournamentDetails(this)">
                                         <i class="fa-solid fa-circle-info"></i> View Details
                                         <span class="match-data" style="display: none;" 
                                               data-title="<%= tournament.title %>"
                                               data-date="<%= tournament.date %>"
                                               data-prize="<%= tournament.prizePool %>"
                                               data-slots="<%= tournament.slots %>"
                                               data-registered="<%= approvedTeams.length %>"
                                               data-fee="<%= tournament.entryFee %>"
                                               data-timings="<%= tournament.idpTimings %>"
                                               data-maps="<%= tournament.maps || '' %>"
                                               data-details="<%= tournament.details || '' %>"></span>
                                     </button>
                                 </div>
                            </div>
                        </article>
                    <% } %>
                </section>
                <% } %>
            </div>
        </main>

        <%- include("partials/footer") %>
        <%- include("partials/bottomNav") %>
    </div>

