<section class="wallet-card">
    <div class="wallet-header">
        <div class="wallet-title-group">
            <p class="wallet-label"> Wallet </p>
            <!-- <h3 class="wallet-amount">₹ 12,450.00</h3> -->
        </div>
        <!-- <div class="wallet-icon" aria-hidden="true">
            <i class="fa-solid fa-wallet"></i>
        </div> -->
    </div>

    <div class="wallet-stats">
        <div class="stat-item">
            <span class="stat-label">Available Balance</span>
            <strong class="stat-val">₹ <%= wallet.availableBalance %></strong>
        </div>
        <div class="stat-item">
            <span class="stat-label">Won Prizepool</span>
            <strong class="stat-val">₹ <%= wallet.prizePool %> </strong>
        </div>
        <div class="stat-item highlight">
            <span class="stat-label">Total Cash</span>
            <strong class="stat-val">₹ <%= wallet.prizePool + wallet.availableBalance %></strong>
        </div>
    </div>

    <div class="wallet-actions">
        <a href="javascript:void(0)" onclick="openAddCashModal()" class="wallet-btn primary">
            <i class="fa-solid fa-plus-circle"></i> <span>Add Cash</span>
        </a>
        <a href="/withdrawal" class="wallet-btn secondary">
            <i class="fa-solid fa-money-bill-transfer"></i> <span>Withdraw</span>
        </a>
    </div>
</section>

<!-- Add Cash Modal -->
<div id="addCashModal" class="modal-overlay" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.75); backdrop-filter: blur(5px); display: none; align-items: center; justify-content: center; z-index: 9999; padding: 1rem; box-sizing: border-box;">
    <div class="modal-content" style="background-color: #151720; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 20px; width: 100%; max-width: 450px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5); display: flex; flex-direction: column; max-height: 90vh; animation: modalFadeIn 0.3s ease; text-align: left;">
        <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
            <h3 style="margin: 0; font-size: 1.3rem; font-weight: 800; color: #ffffff;">Add Cash to Wallet</h3>
            <button class="modal-close-btn" onclick="closeAddCashModal()" style="background: transparent; border: none; font-size: 1.8rem; color: #9e9ea7; cursor: pointer; transition: color 0.2s ease; line-height: 1;">&times;</button>
        </div>
        <div class="modal-body" style="padding: 1.5rem; overflow-y: auto; color: #f5f5f7; display: flex; flex-direction: column; gap: 1.25rem;">
            <!-- QR Code Section -->
            <div style="display: flex; flex-direction: column; align-items: center; gap: 0.5rem; background: rgba(255, 255, 255, 0.02); border: 1px solid rgba(255, 255, 255, 0.04); border-radius: 12px; padding: 1rem; text-align: center;">
                <span style="font-size: 0.88rem; color: #9e9ea7; font-weight: 700;">Scan QR Code to Pay</span>
                <img src="/images/qrCode.png" id="qrCodeImage" alt="Payment QR Code" style="width: 180px; height: 180px; object-fit: contain; border-radius: 8px; border: 4px solid white; background: white;">
                <span style="font-size: 0.82rem; color: #ff455e; font-weight: 600; margin-top: 0.25rem;">Pay using any UPI App (GPay, PhonePe, Paytm)</span>
            </div>

            <!-- Form Details -->
            <form id="addCashForm" onsubmit="submitAddCash(event)" style="display: flex; flex-direction: column; gap: 1rem;">
                <div style="display: flex; flex-direction: column; gap: 0.4rem; width: 100%;">
                    <label for="addCashAmount" style="font-size: 0.88rem; color: #9e9ea7; font-weight: 700;">Enter Amount (₹) <span style="color: #ff455e;">*</span></label>
                    <input type="number" id="addCashAmount" name="amount" required min="1" placeholder="e.g. 100" style="width: 100%; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 0.75rem; color: #ffffff; box-sizing: border-box; outline: none; font-size: 1rem;">
                </div>

                <div style="display: flex; flex-direction: column; gap: 0.4rem; width: 100%;">
                    <label for="addCashScreenshot" style="font-size: 0.88rem; color: #9e9ea7; font-weight: 700;">Upload Payment Screenshot <span style="color: #ff455e;">*</span></label>
                    <input type="file" id="addCashScreenshot" name="screenshot" accept="image/*" required style="width: 100%; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 0.5rem; color: #ffffff; box-sizing: border-box; cursor: pointer;">
                </div>

                <button type="submit" id="addCashSubmitBtn" class="slot-btn" style="width: 100%; margin: 0.5rem 0 0 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; border: none; border-radius: 8px; background: linear-gradient(135deg, #d7263d, #ff455e); color: white; cursor: pointer; box-shadow: 0 4px 14px rgba(215, 38, 61, 0.35); font-family: inherit;">
                    <i class="fa-solid fa-paper-plane" style="margin-right: 0.5rem;"></i> Submit Payment Details
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function openAddCashModal() {
        document.getElementById('addCashModal').style.display = 'flex';
    }

    function closeAddCashModal() {
        document.getElementById('addCashModal').style.display = 'none';
        document.getElementById('addCashForm').reset();
    }

    async function submitAddCash(event) {
        event.preventDefault();
        const form = event.target;
        const submitBtn = document.getElementById('addCashSubmitBtn');
        const originalHtml = submitBtn.innerHTML;

        const amountInput = document.getElementById('addCashAmount');
        if (Number(amountInput.value) <= 0) {
            alert("Please enter a valid amount.");
            return;
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Submitting...';

        const formData = new FormData(form);

        try {
            const originUrl = typeof baseurl !== 'undefined' && baseurl ? baseurl : window.location.origin;
            const res = await fetch(`${originUrl}/addcash`, {
                method: 'POST',
                body: formData
            });

            const result = await res.json();
            alert(result.msg);

            if (res.status === 200 || result.success) {
                closeAddCashModal();
                window.location.reload();
            } else {
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalHtml;
            }
        } catch (err) {
            console.error("Add cash submission error:", err);
            alert("Something went wrong. Please try again.");
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalHtml;
        }
    }

    // Close modal when clicking outside content
    window.addEventListener('click', function(event) {
        const addCashModal = document.getElementById('addCashModal');
        if (event.target === addCashModal) {
            closeAddCashModal();
        }
    });
</script>

