<section class="wallet-card">
    <div class="wallet-header">
        <div class="wallet-title-group">
            <p class="wallet-label"> Wallet </p>
            <!-- <h3 class="wallet-amount">₹ 12,450.00</h3> -->
        </div>
        <!-- <div class="wallet-icon" aria-hidden="true">
            <i class="fa-solid fa-wallet"></i>
        </div> -->
    </div>

    <div class="wallet-stats">
        <div class="stat-item">
            <span class="stat-label">Available Balance</span>
            <strong class="stat-val">₹ <%= wallet.availableBalance %></strong>
        </div>
        <div class="stat-item">
            <span class="stat-label">Won Prizepool</span>
            <strong class="stat-val">₹ <%= wallet.prizePool %> </strong>
        </div>
        <div class="stat-item highlight">
            <span class="stat-label">Total Cash</span>
            <strong class="stat-val">₹ <%= wallet.prizePool + wallet.availableBalance %></strong>
        </div>
    </div>

    <div class="wallet-actions">
        <a href="#recharge" class="wallet-btn primary">
            <i class="fa-solid fa-plus-circle"></i> <span>Add Cash</span>
        </a>
        <a href="/withdrawal" class="wallet-btn secondary">
            <i class="fa-solid fa-money-bill-transfer"></i> <span>Withdraw</span>
        </a>
    </div>
</section>

