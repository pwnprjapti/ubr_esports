<section class="wallet-card">
    <div class="wallet-header">
        <div class="wallet-title-group">
            <p class="wallet-label"> Wallet </p>
            <!-- <h3 class="wallet-amount">₹ 12,450.00</h3> -->
        </div>
        <!-- <div class="wallet-icon" aria-hidden="true">
            <i class="fa-solid fa-wallet"></i>
        </div> -->
    </div>

    <div class="wallet-stats">
        <div class="stat-item">
            <span class="stat-label">Available Balance</span>
            <strong class="stat-val">₹ <%= wallet.availableBalance %></strong>
        </div>
        <div class="stat-item">
            <span class="stat-label">Won Prizepool</span>
            <strong class="stat-val">₹ <%= wallet.prizePool %> </strong>
        </div>
        <div class="stat-item highlight">
            <span class="stat-label">Total Cash</span>
            <strong class="stat-val">₹ <%= wallet.prizePool + wallet.availableBalance %></strong>
        </div>
    </div>

    <div class="wallet-actions">
        <a href="javascript:void(0)" onclick="openAddCashModal()" class="wallet-btn primary">
            <i class="fa-solid fa-plus-circle"></i> <span>Add Cash</span>
        </a>
        <a href="/withdrawal" class="wallet-btn secondary">
            <i class="fa-solid fa-money-bill-transfer"></i> <span>Withdraw</span>
        </a>
    </div>
</section>

<!-- Add Cash Modal -->
<div id="addCashModal" class="modal-overlay" style="position: fixed; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(0, 0, 0, 0.75); backdrop-filter: blur(5px); display: none; align-items: center; justify-content: center; z-index: 9999; padding: 1rem; box-sizing: border-box;">
    <div class="modal-content" style="background-color: #151720; border: 1px solid rgba(255, 255, 255, 0.08); border-radius: 20px; width: 100%; max-width: 450px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5); display: flex; flex-direction: column; max-height: 90vh; animation: modalFadeIn 0.3s ease; text-align: left;">
        <div class="modal-header" style="display: flex; justify-content: space-between; align-items: center; padding: 1.25rem 1.5rem; border-bottom: 1px solid rgba(255, 255, 255, 0.08);">
            <h3 style="margin: 0; font-size: 1.3rem; font-weight: 800; color: #ffffff;">Add Cash to Wallet</h3>
            <button class="modal-close-btn" onclick="closeAddCashModal()" style="background: transparent; border: none; font-size: 1.8rem; color: #9e9ea7; cursor: pointer; transition: color 0.2s ease; line-height: 1;">&times;</button>
        </div>
        <div class="modal-body" style="padding: 1.5rem; overflow-y: auto; color: #f5f5f7; display: flex; flex-direction: column; gap: 1.25rem;">
            <!-- Form Details -->
            <form id="addCashForm" onsubmit="submitAddCash(event)" style="display: flex; flex-direction: column; gap: 1.25rem;">
                <div style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%;">
                    <label for="addCashAmount" style="font-size: 0.9rem; color: #9e9ea7; font-weight: 700;">Enter Amount (₹) <span style="color: #ff455e;">*</span></label>
                    <input type="number" id="addCashAmount" name="amount" required min="1" placeholder="e.g. 100" style="width: 100%; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.12); border-radius: 10px; padding: 0.85rem 1rem; color: #ffffff; box-sizing: border-box; outline: none; font-size: 1.1rem; font-weight: 700;">
                </div>

                <!-- Quick Amount Badges -->
                <div style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
                    <button type="button" onclick="setAddAmount(50)" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: #fff; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer;">+ ₹50</button>
                    <button type="button" onclick="setAddAmount(100)" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: #fff; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer;">+ ₹100</button>
                    <button type="button" onclick="setAddAmount(200)" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: #fff; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer;">+ ₹200</button>
                    <button type="button" onclick="setAddAmount(500)" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.12); color: #fff; padding: 6px 14px; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer;">+ ₹500</button>
                </div>

                <div style="background: rgba(198, 229, 71, 0.08); border: 1px solid rgba(198, 229, 71, 0.2); border-radius: 10px; padding: 0.75rem 1rem; display: flex; align-items: center; gap: 0.75rem;">
                    <i class="fa-solid fa-shield-halved" style="color: #C6E547; font-size: 1.2rem;"></i>
                    <span style="font-size: 0.82rem; color: #d0d7de; line-height: 1.4;">Instant & Secure UPI Payment (GPay, PhonePe, Paytm, BHIM)</span>
                </div>

                <button type="submit" id="addCashSubmitBtn" class="slot-btn" style="width: 100%; margin: 0.25rem 0 0 0; min-height: 46px; display: inline-flex; align-items: center; justify-content: center; font-weight: 800; border: none; border-radius: 10px; background: linear-gradient(135deg, #0B3D2E, #134d3a); color: #C6E547; border: 1px solid #C6E547; cursor: pointer; box-shadow: 0 4px 14px rgba(11, 61, 46, 0.4); font-family: inherit; font-size: 1rem;">
                    <i class="fa-solid fa-qrcode" style="margin-right: 0.5rem;"></i> Proceed to Pay
                </button>
            </form>
        </div>
    </div>
</div>

<script>
    function setAddAmount(val) {
        document.getElementById('addCashAmount').value = val;
    }

    function openAddCashModal() {
        document.getElementById('addCashModal').style.display = 'flex';
    }

    function closeAddCashModal() {
        document.getElementById('addCashModal').style.display = 'none';
        document.getElementById('addCashForm').reset();
    }

    async function submitAddCash(event) {
        event.preventDefault();
        const submitBtn = document.getElementById('addCashSubmitBtn');
        const originalHtml = submitBtn.innerHTML;

        const amountInput = document.getElementById('addCashAmount');
        const amount = Number(amountInput.value);
        if (isNaN(amount) || amount <= 0) {
            alert("Please enter a valid amount.");
            return;
        }

        submitBtn.disabled = true;
        submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Generating Payment QR...';

        try {
            const originUrl = typeof baseurl !== 'undefined' && baseurl ? baseurl : window.location.origin;
            const res = await fetch(`${originUrl}/addcash`, {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify({ amount })
            });

            const result = await res.json();

            if (res.ok && result.success && result.paymentUrl) {
                // Redirect user to Lola Pay checkout QR page
                window.location.href = result.paymentUrl;
            } else {
                alert(result.msg || "Failed to generate payment link. Please try again.");
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalHtml;
            }
        } catch (err) {
            console.error("Add cash submission error:", err);
            alert("Something went wrong. Please try again.");
            submitBtn.disabled = false;
            submitBtn.innerHTML = originalHtml;
        }
    }

    // Check URL params for payment status notifications
    window.addEventListener('DOMContentLoaded', () => {
        const urlParams = new URLSearchParams(window.location.search);
        const paymentStatus = urlParams.get('payment_status');
        if (paymentStatus === 'success') {
            alert("Payment Successful! ₹ Your wallet has been updated.");
            // Clean up URL parameter
            window.history.replaceState({}, document.title, window.location.pathname);
        } else if (paymentStatus === 'failed') {
            alert("Payment Failed or Cancelled. Please try again.");
            window.history.replaceState({}, document.title, window.location.pathname);
        }
    });

    // Close modal when clicking outside content
    window.addEventListener('click', function(event) {
        const addCashModal = document.getElementById('addCashModal');
        if (event.target === addCashModal) {
            closeAddCashModal();
        }
    });
</script>

