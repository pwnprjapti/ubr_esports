<!-- Floating WhatsApp Widget -->
<style>
.floating-whatsapp-container {
    position: fixed !important;
    bottom: 85px !important;
    left: 20px !important;
    z-index: 9999 !important;
}

@media (max-width: 768px) {
    .floating-whatsapp-container {
        bottom: 10% !important;
        left: 14px !important;
    }
    .floating-whatsapp-btn {
        width: 50px !important;
        height: 50px !important;
        font-size: 1.65rem !important;
    }
    .whatsapp-menu {
        bottom: 60px !important;
    }
}
</style>
<div class="floating-whatsapp-container">
    <div class="whatsapp-menu" id="whatsappMenu">
        <div class="whatsapp-menu-header">
            <i class="fa-brands fa-whatsapp"></i> Select Contact
        </div>
        <a href="https://wa.me/917880892513" target="_blank" rel="noopener noreferrer" class="whatsapp-menu-item">
            <span class="whatsapp-avatar">V</span>
            <div class="whatsapp-item-text">
                <span class="whatsapp-name">Vishnu</span>
            </div>
        </a>
         <a href="https://wa.me/917357957147" target="_blank" rel="noopener noreferrer" class="whatsapp-menu-item">
            <span class="whatsapp-avatar">C</span>
            <div class="whatsapp-item-text">
                <span class="whatsapp-name">Chetan</span>
            </div>
        </a>
    </div>
    <button class="floating-whatsapp-btn" id="whatsappFloatingBtn" aria-label="WhatsApp Support">
        <i class="fa-brands fa-whatsapp"></i>
    </button>
</div>

<script>
    document.addEventListener('DOMContentLoaded', () => {
        // WhatsApp floating widget handlers
        const waBtn = document.getElementById('whatsappFloatingBtn');
        const waMenu = document.getElementById('whatsappMenu');
        if (waBtn && waMenu) {
            waBtn.addEventListener('click', (e) => {
                e.stopPropagation();
                waMenu.classList.toggle('show');
            });
            document.addEventListener('click', () => {
                waMenu.classList.remove('show');
            });
            waMenu.addEventListener('click', (e) => {
                e.stopPropagation();
            });
        }
    });
</script>
