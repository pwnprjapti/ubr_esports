                    <div style="display: flex; flex-direction: column; gap: 0.4rem; width: 100%;">
                        <label for="popWhatsappNumber" style="font-size: 0.88rem; color: #9e9ea7; font-weight: 700;">WhatsApp Mobile Number <span style="color: #D41B23;">*</span></label>
                        <div style="display: flex; align-items: center; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; width: 100%; box-sizing: border-box; overflow: hidden;">
                            <span style="padding: 0.75rem; background: rgba(255,255,255,0.05); color: #9e9ea7; font-weight: 700; font-size: 0.9rem; border-right: 1px solid rgba(255,255,255,0.08);">+91</span>
                            <input type="tel" id="popWhatsappNumber" name="whatsappNumber" pattern="[0-9]{10}" maxlength="10" required placeholder="Enter 10 digit number" style="width: 100%; background: transparent; border: none; padding: 0.75rem; color: #ffffff; outline: none; box-sizing: border-box;">
                        </div>
                    </div>

                    <button type="submit" id="popTeamSubmitBtn" class="slot-btn" style="width: 100%; margin: 0.5rem 0 0 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; font-weight: 800;">
                        <i class="fa-solid fa-paper-plane"></i> Save Team Details
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Drop Details Modal -->
    <div id="dropDetailsModal" class="modal-overlay">
        <div class="modal-content" style="max-width: 450px;">
            <div class="modal-header">
                <h3 style="color: #ffffff; font-weight: 500; margin: 0; font-size: 1.25rem;">Add Drop Details</h3>
                <button type="button" class="modal-close-btn" onclick="closeDropDetailsModal()">&times;</button>
            </div>
            <div class="modal-body" style="padding: 1.5rem;">
                <form id="popDropDetailsForm" onsubmit="submitPopDropDetails(event)" style="width: 100%; display: flex; flex-direction: column; gap: 1rem; text-align: left;">
                    <!-- Erangle Map Field -->
                    <div style="display: flex; flex-direction: column; gap: 0.4rem; width: 100%;">
                        <label for="popErangle" style="font-size: 0.88rem; color: #9e9ea7; font-weight: 700;">Erangle Drop Location</label>
                        <input type="text" id="popErangle" name="erangle" placeholder="e.g. Pochinki, School" style="width: 100%; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 0.75rem; color: #ffffff; box-sizing: border-box;">
                    </div>

                    <!-- Rando Map Field -->
                    <div style="display: flex; flex-direction: column; gap: 0.4rem; width: 100%;">
                        <label for="popRando" style="font-size: 0.88rem; color: #9e9ea7; font-weight: 700;">Rando Drop Location</label>
                        <input type="text" id="popRando" name="rando" placeholder="e.g. Bootcamp" style="width: 100%; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 0.75rem; color: #ffffff; box-sizing: border-box;">
                    </div>

                    <!-- Miramar Map Field -->
                    <div style="display: flex; flex-direction: column; gap: 0.4rem; width: 100%;">
                        <label for="popMiramar" style="font-size: 0.88rem; color: #9e9ea7; font-weight: 700;">Miramar Drop Location</label>
                        <input type="text" id="popMiramar" name="miramar" placeholder="e.g. Pecado" style="width: 100%; background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 8px; padding: 0.75rem; color: #ffffff; box-sizing: border-box;">
                    </div>

                    <button type="submit" id="popDropSubmitBtn" class="slot-btn" style="width: 100%; margin: 0.5rem 0 0 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; font-weight: 800;">
                        <i class="fa-solid fa-paper-plane"></i> Save Drop Details
                    </button>
                </form>
            </div>
        </div>
    </div>

    <!-- Select Squad Modal -->
    <div id="selectTeamModal" class="modal-overlay">
        <div class="modal-content" style="max-width: 460px;">
            <div class="modal-header">
                <h3 style="color: #ffffff; font-weight: 500; margin: 0; font-size: 1.2rem;">Select Squad to Register</h3>
                <button type="button" class="modal-close-btn" onclick="closeSelectTeamModal()">&times;</button>
            </div>
            <div class="modal-body" style="padding: 1.5rem;">
                <!-- Match Info Summary -->
                <div style="background: rgba(255,255,255,0.03); border: 1px solid rgba(255,255,255,0.08); border-radius: 12px; padding: 0.85rem 1rem; margin-bottom: 1.25rem; display: flex; justify-content: space-between; align-items: center;">
                    <div style="min-width: 0; flex: 1; padding-right: 0.5rem;">
                        <div id="selectTeamMatchTitle" style="font-weight: 800; color: #ffffff; font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">Scrim</div>
                        <div style="font-size: 0.8rem; color: #a0a0aa; margin-top: 2px;">Entry Fee: <span id="selectTeamMatchFee" style="color: #4ade80; font-weight: 700;">₹0</span></div>
                    </div>
                    <div style="text-align: right; flex-shrink: 0;">
                        <div style="font-size: 0.72rem; color: #a0a0aa; text-transform: uppercase;">Wallet Balance</div>
                        <div id="selectTeamWalletBal" style="font-weight: 800; color: #ffffff; font-size: 0.92rem;">₹0</div>
                    </div>
                </div>

                <!-- Squad Selection Label -->
                <div style="margin-bottom: 0.6rem; font-size: 0.82rem; font-weight: 700; color: #a0a0aa; text-transform: uppercase; letter-spacing: 0.5px;">
                    Choose Squad to Register
                </div>

                <!-- List of available user teams (already registered squads are filtered out) -->
                <div id="selectTeamList" style="display: flex; flex-direction: column; gap: 0.75rem; max-height: 260px; overflow-y: auto; padding-right: 2px;">
                    <!-- Dynamically populated squads -->
                </div>

                <!-- Action Button -->
                <div style="margin-top: 1.25rem; display: flex; flex-direction: column; gap: 0.75rem;">
                    <button type="button" id="confirmBookTeamBtn" class="slot-btn" style="width: 100%; min-height: 46px; font-weight: 800; font-size: 0.95rem;" onclick="confirmSelectedTeamBooking()">
                        <i class="fa-solid fa-check-circle"></i> Confirm & Book Slot
                    </button>
                    <div style="display: flex; justify-content: space-between; align-items: center; font-size: 0.82rem; color: #a0a0aa; padding-top: 0.5rem; border-top: 1px solid rgba(255,255,255,0.06);">
                        <span>Need a new squad?</span>
                        <a href="/team-settings" style="color: #D41B23; text-decoration: none; font-weight: 700;">+ Manage Squads</a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Slot Booking Success Pop-up Modal -->
    <div id="slotSuccessModal" class="modal-overlay" style="display: none; z-index: 3500;">
        <div class="modal-content" style="max-width: 420px; width: 92%; background: #111319; border: 1px solid rgba(34, 197, 94, 0.4); border-radius: 20px; box-shadow: 0 20px 50px rgba(0, 0, 0, 0.85), 0 0 35px rgba(34, 197, 94, 0.22); position: relative; padding: 2.25rem 1.75rem 1.75rem; text-align: center; box-sizing: border-box;">
            <!-- Top Right Corner Close Button (Angle me cross ka sign) -->
            <button type="button" onclick="closeSlotSuccessModal()" title="Close" style="position: absolute; top: 12px; right: 14px; width: 34px; height: 34px; border-radius: 50%; background: rgba(255, 255, 255, 0.06); border: 1px solid rgba(255, 255, 255, 0.1); color: #9e9ea7; font-size: 1.15rem; display: flex; align-items: center; justify-content: center; cursor: pointer; transition: all 0.2s; padding: 0; line-height: 1;" onmouseover="this.style.color='#ffffff'; this.style.backgroundColor='rgba(239, 68, 68, 0.3)'; this.style.borderColor='rgba(239, 68, 68, 0.6)';" onmouseout="this.style.color='#9e9ea7'; this.style.backgroundColor='rgba(255, 255, 255, 0.06)'; this.style.borderColor='rgba(255, 255, 255, 0.1)';">
                <i class="fa-solid fa-xmark"></i>
            </button>

            <!-- Glowing Icon Badge -->
            <div style="width: 72px; height: 72px; border-radius: 50%; background: rgba(34, 197, 94, 0.12); border: 2px solid #22c55e; display: flex; align-items: center; justify-content: center; margin: 0 auto 1.25rem; box-shadow: 0 0 25px rgba(34, 197, 94, 0.35);">
                <i class="fa-solid fa-check" style="font-size: 2.2rem; color: #22c55e;"></i>
            </div>

            <!-- Green Line with Tick Sign: Slot booked successfully -->
            <div style="display: flex; align-items: center; justify-content: center; gap: 0.55rem; color: #22c55e; font-size: clamp(1.1rem, 3.8vw, 1.28rem); font-weight: 700; margin-bottom: 0.6rem; text-align: center;">
                <i class="fa-solid fa-check" style="color: #22c55e; font-size: 1.2rem;"></i>
                <span>Slot booked successfully</span>
            </div>

            <!-- Squad confirmation text -->
            <p id="slotSuccessSquadText" style="color: #9e9ea7; font-size: 0.9rem; margin: 0 0 1.25rem; line-height: 1.5;"></p>

            <!-- WhatsApp Group Link and Copy Link (jaisa scrim ke card pr hai, just above view my bookings button) -->
            <div id="slotSuccessWhatsappWrap" style="display: none; flex-direction: column; gap: 0.5rem; width: 100%; margin-bottom: 0.65rem; box-sizing: border-box;">
                <a id="slotSuccessWhatsappBtn" href="#" target="_blank" class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: #25d366; color: white; text-decoration: none; font-weight: 800; border-radius: 8px; box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35); transition: background-color 0.2s; font-size: 0.92rem; box-sizing: border-box;" onmouseover="this.style.backgroundColor='#128c7e'" onmouseout="this.style.backgroundColor='#25d366'">
                    <i class="fa-brands fa-whatsapp" style="margin-right: 0.5rem; font-size: 1.15rem;"></i> TAP TO JOIN IDP GROUP
                </a>
                <button id="slotSuccessCopyWaBtn" type="button" class="slot-btn" onclick="copySlotWhatsAppLink(this)" title="Copy WhatsApp Group Link" style="width: 100%; min-height: 40px; margin: 0; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; background: rgba(37, 211, 102, 0.12); border: 1px solid rgba(37, 211, 102, 0.5); color: #25d366; border-radius: 8px; cursor: pointer; transition: all 0.2s; font-weight: 700; font-size: 0.88rem; box-sizing: border-box;" onmouseover="this.style.backgroundColor='rgba(37, 211, 102, 0.22)'" onmouseout="this.style.backgroundColor='rgba(37, 211, 102, 0.12)'">
                    <i class="fa-regular fa-copy"></i> <span>Copy WhatsApp Link</span>
                </button>
            </div>

            <!-- View My Bookings Button (Gray / Light Black color, directly below WhatsApp buttons) -->
            <a href="/my-matches" class="slot-btn" style="width: 100%; min-height: 44px; margin: 0; display: inline-flex; align-items: center; justify-content: center; gap: 0.55rem; background: #20242c; border: 1px solid rgba(255, 255, 255, 0.16); color: #f1f2f6; font-weight: 700; font-size: 0.92rem; border-radius: 8px; text-decoration: none; cursor: pointer; transition: all 0.2s; box-sizing: border-box;" onmouseover="this.style.backgroundColor='#2c323e'; this.style.borderColor='rgba(255, 255, 255, 0.32)'; this.style.color='#ffffff';" onmouseout="this.style.backgroundColor='#20242c'; this.style.borderColor='rgba(255, 255, 255, 0.16)'; this.style.color='#f1f2f6';">
                <i class="fa-solid fa-ticket"></i> View My Bookings
            </a>
        </div>
    </div>

</body>
</html>
