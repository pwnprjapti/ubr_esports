<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Scrims & Categories | UBR Esports</title>
    <link rel="icon" type="image/png" href="/images/ubrLogo.png">
    <meta name="description" content="Browse and filter upcoming BGMI scrims by date. Book your squad slots and compete for cash prize pools.">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/home.css?v=restore">
    <link rel="stylesheet" href="/css/nav.css?v=restore">
    <link rel="stylesheet" href="/css/category.css?v=restore">
    <link rel="stylesheet" href="/css/footer.css?v=restore">
    <style>
        /* Modal overlay styling */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(5px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            padding: 1rem;
            box-sizing: border-box;
        }

        /* Modal Content Box */
        .modal-content {
            background-color: #151720;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
            display: flex;
            flex-direction: column;
            max-height: 85vh;
            animation: modalFadeIn 0.3s ease;
        }

        @keyframes modalFadeIn {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        /* Modal Header */
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .modal-header h3 {
            margin: 0;
            font-size: 1.3rem;
            font-weight: 400;
            color: #ffffff;
        }

        .modal-close-btn {
            background: transparent;
            border: none;
            font-size: 1.8rem;
            color: #9e9ea7;
            cursor: pointer;
            transition: color 0.2s ease;
            line-height: 1;
        }

        .modal-close-btn:hover {
            color: #D41B23;
        }

        /* Modal Body */
        .modal-body {
            padding: 1.5rem;
            overflow-y: auto;
            color: #f5f5f7;
            font-size: 0.95rem;
        }

        /* Teams List inside Modal */
        .modal-teams-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem;
        }

        .modal-team-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.75rem 1rem;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 12px;
        }

        .modal-team-logo {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(155, 7, 7, 0.15);
            color: #D41B23;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            font-size: 1.2rem;
        }

        .modal-team-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .modal-team-name {
            font-weight: 700;
            color: #ffffff;
        }

        /* Details inside Modal */
        .modal-details-grid {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .modal-detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }

        .modal-detail-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .modal-detail-label {
            color: #9e9ea7;
            font-size: 0.88rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .modal-detail-value {
            color: #ffffff;
            font-weight: 700;
            font-size: 0.95rem;
        }

        .modal-detail-value.highlight {
            color: #D41B23;
        }

        /* Date Banner styling */
        .selected-date-banner {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            margin: 1.25rem auto;
            width: 100%;
            max-width: 600px;
        }

        .selected-date-banner .line {
            flex: 1;
            height: 1px;
            background: rgba(212, 27, 35, 0.4);
        }

        .selected-date-banner .date-text {
            color: #D41B23;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            background: transparent;
            border: none;
            padding: 0 0.5rem;
            text-shadow: none;
            white-space: nowrap;
        }

        @media (max-width: 480px) {
            .modal-teams-list {
                gap: 0.5rem;
            }
            .modal-team-item {
                padding: 0.45rem 0.65rem;
                gap: 0.6rem;
                border-radius: 8px;
            }
            .modal-team-logo {
                width: 32px;
                height: 32px;
                font-size: 1rem;
            }
            .modal-team-name {
                font-size: 0.85rem;
            }
        }

        /* Scrim Grid & Card Layout - Sleek Horizontal Rectangle */
        .scrim-grid {
            display: grid !important;
            grid-template-columns: repeat(auto-fit, minmax(360px, 1fr)) !important;
            gap: 1.1rem !important;
            width: 100% !important;
        }

        .scrim-card {
            order: 1;
            background: #0e111a !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            border-radius: 14px !important;
            padding: 0.85rem 1.05rem !important;
            box-shadow: 0 8px 24px rgba(0, 0, 0, 0.5) !important;
            display: flex;
            flex-direction: column !important;
            gap: 0.52rem !important;
            position: relative !important;
            overflow: hidden !important;
            transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease !important;
        }

        .scrim-card.is-hidden {
            display: none !important;
        }

        .scrim-card:hover {
            transform: translateY(-3px) !important;
            border-color: rgba(255, 255, 255, 0.18) !important;
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.6) !important;
        }

        .scrim-card.scrim-card-full {
            order: 2;
            opacity: 0.95;
        }

        /* Card Hero Row: Logo on Left (~30% card height), Details on Right */
        .card-hero-row {
            display: flex !important;
            align-items: center !important;
            gap: 0.85rem !important;
            width: 100% !important;
        }

        .card-game-logo {
            width: 52px !important;
            height: 52px !important;
            border-radius: 8px !important;
            object-fit: cover !important;
            display: block !important;
            flex-shrink: 0 !important;
            border: 1px solid rgba(255, 255, 255, 0.1) !important;
            box-shadow: 0 4px 14px rgba(0, 0, 0, 0.45) !important;
        }

        .card-hero-details {
            display: flex !important;
            flex-direction: column !important;
            justify-content: center !important;
            gap: 0.45rem !important;
            flex: 1 !important;
            min-width: 0 !important;
        }

        .card-header-bar {
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            gap: 0.5rem !important;
            width: 100% !important;
            padding-bottom: 0 !important;
        }

        .card-main-title {
            font-size: 0.84rem !important;
            font-weight: 800 !important;
            color: #ffffff !important;
            margin: 0 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.025em !important;
            line-height: 1.25 !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            flex: 1 !important;
            min-width: 0 !important;
            text-align: left !important;
        }

        .card-slot-badge {
            background: #1e1333 !important;
            border: 1px solid #8b5cf6 !important;
            color: #d8b4fe !important;
            font-size: 0.65rem !important;
            font-weight: 800 !important;
            padding: 0.16rem 0.45rem !important;
            border-radius: 6px !important;
            white-space: nowrap !important;
            box-shadow: 0 0 10px rgba(139, 92, 246, 0.2) !important;
            display: inline-flex !important;
            align-items: center !important;
            gap: 0.25rem !important;
            flex-shrink: 0 !important;
        }

        .card-slot-badge.badge-full {
            background: rgba(239, 68, 68, 0.12) !important;
            border-color: rgba(239, 68, 68, 0.45) !important;
            color: #f87171 !important;
            box-shadow: 0 0 10px rgba(239, 68, 68, 0.15) !important;
        }

        .card-slot-badge.badge-open {
            background: rgba(34, 197, 94, 0.12) !important;
            border-color: rgba(34, 197, 94, 0.45) !important;
            color: #4ade80 !important;
            box-shadow: 0 0 10px rgba(34, 197, 94, 0.15) !important;
        }

        /* Stats Row: PRIZE POOL | ENTRY FEE */
        .card-stats-grid {
            display: flex !important;
            align-items: flex-start !important;
            justify-content: flex-start !important;
            gap: 1.15rem !important;
            width: 100% !important;
            padding: 0 !important;
            margin: 0 !important;
        }

        .card-stat-box {
            display: flex !important;
            flex-direction: column !important;
            align-items: flex-start !important;
            gap: 0.12rem !important;
            min-width: 0 !important;
            flex-shrink: 0 !important;
        }

        .card-stat-label {
            display: flex !important;
            align-items: center !important;
            gap: 0.25rem !important;
            font-size: 0.58rem !important;
            color: #94a3b8 !important;
            font-weight: 700 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.03em !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            width: 100% !important;
        }

        .card-stat-label i {
            font-size: 0.64rem !important;
            color: #94a3b8 !important;
        }

        .card-stat-val {
            font-size: 0.84rem !important;
            font-weight: 800 !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            width: 100% !important;
            line-height: 1.15 !important;
        }

        .card-stat-val.val-prize {
            color: #22c55e !important;
        }

        .card-stat-val.val-fee {
            color: #ffffff !important;
        }

        /* IDP TIMINGS and MAPS Rows */
        .card-meta-row {
            display: flex !important;
            align-items: center !important;
            gap: 0.5rem !important;
            width: 100% !important;
        }

        .card-meta-label {
            display: flex !important;
            align-items: center !important;
            gap: 0.35rem !important;
            font-size: 0.64rem !important;
            font-weight: 700 !important;
            color: #94a3b8 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.03em !important;
            flex-shrink: 0 !important;
            width: 90px !important;
        }

        .card-meta-label i {
            font-size: 0.72rem !important;
            color: #94a3b8 !important;
        }

        .card-pills-container {
            display: grid !important;
            grid-template-columns: repeat(4, minmax(0, 1fr)) !important;
            gap: 0.3rem !important;
            flex: 1 !important;
            min-width: 0 !important;
        }

        .timing-pill-dark {
            background: #171a25 !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            border-radius: 6px !important;
            color: #ffffff !important;
            font-size: 0.68rem !important;
            font-weight: 700 !important;
            padding: 0.22rem 0.15rem !important;
            text-align: center !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

        .map-pill-purple {
            background: rgba(147, 51, 234, 0.12) !important;
            border: 1px solid #7c3aed !important;
            border-radius: 6px !important;
            color: #e9d5ff !important;
            font-size: 0.64rem !important;
            font-weight: 800 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.03em !important;
            padding: 0.22rem 0.15rem !important;
            text-align: center !important;
            white-space: nowrap !important;
            overflow: hidden !important;
            text-overflow: ellipsis !important;
            display: flex !important;
            align-items: center !important;
            justify-content: center !important;
        }

        /* Slots Filled Row */
        .card-slots-bar-box {
            display: flex !important;
            flex-direction: column !important;
            gap: 0.25rem !important;
            width: 100% !important;
            margin-top: 0.05rem !important;
        }

        .slots-header-line {
            display: flex !important;
            align-items: center !important;
            justify-content: space-between !important;
            width: 100% !important;
        }

        .slots-header-label {
            display: flex !important;
            align-items: center !important;
            gap: 0.35rem !important;
            font-size: 0.64rem !important;
            font-weight: 700 !important;
            color: #94a3b8 !important;
            text-transform: uppercase !important;
            letter-spacing: 0.03em !important;
        }

        .slots-header-label i {
            font-size: 0.72rem !important;
            color: #94a3b8 !important;
        }

        .slots-header-count {
            font-size: 0.78rem !important;
            font-weight: 800 !important;
            color: #ffffff !important;
            letter-spacing: 0.02em !important;
        }

        .slots-bar-track {
            width: 100% !important;
            height: 6px !important;
            background: rgba(255, 255, 255, 0.08) !important;
            border-radius: 999px !important;
            overflow: hidden !important;
        }

        .slots-bar-fill {
            height: 100% !important;
            background: #22c55e !important;
            border-radius: 999px !important;
            transition: width 0.3s ease !important;
            box-shadow: 0 0 8px rgba(34, 197, 94, 0.4) !important;
        }

        /* Action Buttons */
        .card-actions-wrapper {
            display: flex !important;
            flex-direction: column !important;
            gap: 0.45rem !important;
            width: 100% !important;
            margin-top: 0.15rem !important;
        }

        .card-joined-actions-row {
            display: grid !important;
            grid-template-columns: 1.15fr 0.85fr !important;
            gap: 0.45rem !important;
            width: 100% !important;
        }

        .btn-join-idp {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 0.4rem !important;
            background: linear-gradient(135deg, #22c55e, #16a34a) !important;
            color: #ffffff !important;
            text-decoration: none !important;
            font-weight: 800 !important;
            font-size: 0.76rem !important;
            text-transform: uppercase !important;
            letter-spacing: 0.025em !important;
            border-radius: 8px !important;
            height: 35px !important;
            border: none !important;
            box-shadow: 0 3px 12px rgba(34, 197, 94, 0.3) !important;
            transition: all 0.2s ease !important;
            cursor: pointer !important;
        }

        .btn-join-idp:hover {
            filter: brightness(1.1) !important;
            transform: translateY(-1px) !important;
        }

        .btn-copy-link {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 0.35rem !important;
            background: rgba(34, 197, 94, 0.08) !important;
            border: 1px solid #22c55e !important;
            color: #4ade80 !important;
            font-weight: 700 !important;
            font-size: 0.74rem !important;
            border-radius: 8px !important;
            height: 35px !important;
            cursor: pointer !important;
            transition: all 0.2s ease !important;
        }

        .btn-copy-link:hover {
            background: rgba(34, 197, 94, 0.16) !important;
            color: #86efac !important;
            transform: translateY(-1px) !important;
        }

        .btn-book-slot-primary {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 0.4rem !important;
            background: #D41B23 !important;
            color: #ffffff !important;
            font-weight: 800 !important;
            font-size: 0.8rem !important;
            border-radius: 8px !important;
            height: 36px !important;
            border: none !important;
            width: 100% !important;
            box-shadow: 0 3px 12px rgba(212, 27, 35, 0.3) !important;
            cursor: pointer !important;
            transition: all 0.2s ease !important;
        }

        .btn-book-slot-primary:hover {
            background: #b9151c !important;
            transform: translateY(-1px) !important;
        }

        .btn-slots-full-disabled {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 0.4rem !important;
            background: #171a24 !important;
            border: 1px solid rgba(255, 255, 255, 0.06) !important;
            color: #64748b !important;
            font-weight: 700 !important;
            font-size: 0.76rem !important;
            border-radius: 8px !important;
            height: 36px !important;
            width: 100% !important;
            cursor: not-allowed !important;
        }

        .btn-book-more {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 0.35rem !important;
            background: #D41B23 !important;
            color: #ffffff !important;
            font-weight: 800 !important;
            font-size: 0.74rem !important;
            border-radius: 8px !important;
            height: 33px !important;
            border: none !important;
            cursor: pointer !important;
            width: 100% !important;
            transition: all 0.2s !important;
        }

        .btn-book-more.disabled {
            background: #171a24 !important;
            border: 1px solid rgba(255, 255, 255, 0.06) !important;
            color: #64748b !important;
            cursor: not-allowed !important;
        }

        .card-sec-actions-grid {
            display: grid !important;
            grid-template-columns: 1fr 1fr !important;
            gap: 0.45rem !important;
            width: 100% !important;
        }

        .btn-card-secondary {
            display: inline-flex !important;
            align-items: center !important;
            justify-content: center !important;
            gap: 0.35rem !important;
            background: #171a25 !important;
            border: 1px solid rgba(255, 255, 255, 0.08) !important;
            border-radius: 8px !important;
            color: #ffffff !important;
            font-weight: 700 !important;
            font-size: 0.74rem !important;
            height: 33px !important;
            width: 100% !important;
            cursor: pointer !important;
            transition: all 0.2s ease !important;
        }

        .btn-card-secondary:hover {
            background: #202434 !important;
            border-color: rgba(255, 255, 255, 0.16) !important;
            transform: translateY(-1px) !important;
        }

        @media (max-width: 480px) {
            .scrim-grid {
                grid-template-columns: 1fr !important;
                gap: 0.85rem !important;
            }
            .scrim-card {
                padding: 0.75rem 0.85rem !important;
                gap: 0.45rem !important;
                border-radius: 12px !important;
            }
            .card-hero-row {
                gap: 0.65rem !important;
            }
            .card-game-logo {
                width: 48px !important;
                height: 48px !important;
                border-radius: 7px !important;
            }
            .card-hero-details {
                gap: 0.35rem !important;
            }
            .card-main-title {
                font-size: 0.78rem !important;
            }
            .card-slot-badge {
                font-size: 0.6rem !important;
                padding: 0.14rem 0.4rem !important;
            }
            .card-stats-grid {
                gap: 0.9rem !important;
            }
            .card-stat-label {
                font-size: 0.52rem !important;
            }
            .card-stat-val {
                font-size: 0.76rem !important;
            }
            .card-meta-label {
                width: 80px !important;
                font-size: 0.6rem !important;
            }
            .timing-pill-dark {
                font-size: 0.62rem !important;
                padding: 0.18rem 0.1rem !important;
            }
            .map-pill-purple {
                font-size: 0.58rem !important;
                padding: 0.18rem 0.1rem !important;
            }
            .btn-join-idp {
                font-size: 0.72rem !important;
                height: 33px !important;
            }
            .btn-copy-link {
                font-size: 0.7rem !important;
                height: 33px !important;
            }
            .btn-book-slot-primary {
                font-size: 0.75rem !important;
                height: 34px !important;
            }
            .btn-card-secondary {
                font-size: 0.7rem !important;
                height: 31px !important;
            }
        }

    </style>
</head>
<body>
    <div class="page-shell">
        <%- include("../partials/nav") %>

        <main class="main-content category-page">
        <% if(wallet && wallet.balance ) {  %>
             <%- include("../partials/wallet", { wallet:wallet.balance }) %>
        <% } %>

            <!-- Date-Based Filter Section -->
            <section class="date-filter-section">
                <div class="filter-header">
                    <div class="filter-title">
                        <i class="fa-solid fa-calendar-days"></i>
                        <span>Filter by Scrim Date</span>
                    </div>
                </div>

                <div class="filter-controls-wrapper">

                    <!-- Specific Custom Date Picker -->
                    <% const todayDate = new Date().toLocaleDateString('en-CA', { timeZone: 'Asia/Kolkata' }); %>
                    <div class="custom-date-picker">
                        <label for="customDatePicker"><i class="fa-regular fa-calendar"></i> Pick Specific Date:</label>
                        <input type="date" id="customDatePicker" name="customDate" value="<%= todayDate %>" min="2026-08-01" max="2026-12-31">
                    </div>
                </div>
            </section>

            <!-- Selected Date Display Banner -->
            <div class="selected-date-banner">
                <span class="line"></span>
                <span class="date-text" id="selectedDateDisplay"><%= new Date().toLocaleDateString('en-US', { timeZone: 'Asia/Kolkata', weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' }) %></span>
                <span class="line"></span>
            </div>

            <!-- Scrim Grid -->
            <section class="scrim-grid" id="scrimGrid">
                <!-- Scrim 1: Today -->

            <% 
                const hasMatches = Array.isArray(matches) && matches.length > 0; 
                // Sort matches: available slots first, full slots at the bottom
                const sortedMatches = hasMatches ? [...matches].sort((a, b) => {
                    const aTeams = (a && a.teams && Array.isArray(a.teams)) ? a.teams.length : 0;
                    const aSlots = (a && Number(a.slots)) || 0;
                    const aFull = (aSlots > 0 && aTeams >= aSlots) ? 1 : 0;

                    const bTeams = (b && b.teams && Array.isArray(b.teams)) ? b.teams.length : 0;
                    const bSlots = (b && Number(b.slots)) || 0;
                    const bFull = (bSlots > 0 && bTeams >= bSlots) ? 1 : 0;

                    return aFull - bFull;
                }) : [];

                const todayMatches = sortedMatches.filter(m => (m.date || '').trim() === todayDate);
                const hasTodayMatches = todayMatches.length > 0;
            %>

            <div class="no-scrims-card" id="noScrimsMsg" style="display: <%= hasTodayMatches ? 'none' : 'block' %>;">
                <div class="empty-icon"><i class="fa-regular fa-calendar-xmark"></i></div>
                <h3 id="noScrimsTitle"><%= hasMatches ? 'No Scrims Scheduled for Today' : 'No Scrims Found for this category' %></h3>
                <p id="noScrimsDesc"><%= hasMatches ? 'Please pick another date from the calendar above to view available scrims.' : 'There are no matches scheduled for the selected Category. Choose another Category.' %></p>
                <button type="button" onclick="showAllScrims()" class="reset-filter-btn" id="resetDateFilter">
                    <i class="fa-solid fa-list-ul"></i> View All Matches
                </button>
            </div>

            <% if (hasMatches) { %>
                <% for (const match of sortedMatches) { %>
                    <% const approvedTeams = (match.teams || []).filter(t => t.status === "approved" || !t.status); %>
                    <% 
                    const userTeamIdStrings = (typeof userTeams !== 'undefined' && Array.isArray(userTeams))
                        ? userTeams.map(t => t && t._id ? t._id.toString() : '').filter(Boolean)
                        : [];
                    let userSlotNumbers = [];
                    const userRegTeams = [];
                    if (match.teams && Array.isArray(match.teams)) {
                        match.teams.forEach((t, idx) => {
                            if (!t) return;
                            const tId = t._id ? t._id.toString() : '';
                            const tTeamId = t.teamId ? t.teamId.toString() : '';
                            const tName = t.teamName ? t.teamName.toString().trim().toLowerCase() : '';
                            const idMatch = (tId && userTeamIdStrings.includes(tId)) || (tTeamId && userTeamIdStrings.includes(tTeamId));
                            const nameMatch = tName && (
                                (typeof userTeamNames !== 'undefined' && Array.isArray(userTeamNames) && userTeamNames.some(ut => ut && ut.toString().trim().toLowerCase() === tName)) ||
                                (typeof userTeamName !== 'undefined' && userTeamName && userTeamName.toString().trim().toLowerCase() === tName)
                            );
                            if (idMatch || nameMatch) {
                                userRegTeams.push(t);
                                userSlotNumbers.push(idx + 1);
                            }
                        });
                    }
                    const isJoined = userRegTeams.length > 0;
                    const registeredTeam = isJoined ? userRegTeams[0] : null;
                    const isFull = Boolean(match.slots && (match.teams ? match.teams.length : 0) >= match.slots); 
                    const remainingSlots = Math.max(0, (match.slots || 0) - (match.teams ? match.teams.length : 0));
                    const filledPercentage = Math.min(100, Math.round(((match.teams ? match.teams.length : 0) / (match.slots || 1)) * 100));
                    const isMatchToday = (match.date || '').trim() === todayDate;
                    %>
                    <article class="scrim-card <%= isFull ? 'scrim-card-full' : '' %> <%= isMatchToday ? '' : 'is-hidden' %>" 
                             data-date="<%= (match.date || '').trim() %>" 
                             data-period="<%= isMatchToday ? 'today' : 'other' %>" 
                             data-full="<%= isFull ? 'true' : 'false' %>"
                             style="<%= isMatchToday ? 'display: flex !important;' : 'display: none !important;' %>">
                        <!-- Hero Row: BGMI Logo on Left (~30% height), Details on Right -->
                        <div class="card-hero-row">
                            <img src="/assets/images/bgmi_logo.png" alt="BGMI" class="card-game-logo">
                            <div class="card-hero-details">
                                <div class="card-header-bar">
                                    <h3 class="card-main-title"><%= match.title %></h3>
                                    <% if (isJoined) { %>
                                        <span class="card-slot-badge">
                                            Slot #<%= userSlotNumbers.join(', #') %>
                                        </span>
                                    <% } else if (isFull) { %>
                                        <span class="card-slot-badge badge-full">
                                            <i class="fa-solid fa-ban"></i> Slots Full
                                        </span>
                                    <% } else { %>
                                        <span class="card-slot-badge badge-open">
                                            <i class="fa-solid fa-users"></i> <%= remainingSlots %> Slot
                                        </span>
                                    <% } %>
                                </div>

                                <!-- Stats: PRIZE POOL | ENTRY FEE -->
                                <div class="card-stats-grid">
                                    <div class="card-stat-box">
                                        <span class="card-stat-label"><i class="fa-solid fa-sack-dollar"></i> PRIZE POOL</span>
                                        <span class="card-stat-val val-prize">₹ <%= match.prizePool %></span>
                                    </div>
                                    <div class="card-stat-box">
                                        <span class="card-stat-label"><i class="fa-solid fa-indian-rupee-sign"></i> ENTRY FEE</span>
                                        <span class="card-stat-val val-fee">₹ <%= match.entryFee %></span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- IDP TIMINGS Row -->
                        <div class="card-meta-row">
                            <div class="card-meta-label">
                                <i class="fa-regular fa-clock"></i> IDP TIMINGS
                            </div>
                            <div class="card-pills-container">
                                <% 
                                    const rawTimings = (match.idpTimings || '').split(',').map(t => t.trim()).filter(Boolean);
                                    const displayTimings = rawTimings.length > 0 ? rawTimings : ['7:32 PM', '8:02 PM', '8:32 PM', '9:02 PM'];
                                %>
                                <% for (const time of displayTimings) { %>
                                    <span class="timing-pill-dark"><%= time %></span>
                                <% } %>
                            </div>
                        </div>

                        <!-- MAPS Row -->
                        <div class="card-meta-row">
                            <div class="card-meta-label">
                                <i class="fa-solid fa-map-location-dot"></i> MAPS
                            </div>
                            <div class="card-pills-container">
                                <% 
                                    const rawMaps = (match.maps || '').split(',').map(m => m.trim()).filter(Boolean);
                                    const displayMaps = rawMaps.length > 0 ? rawMaps : ['ERANGEL', 'MIRAMAR', 'RONDO', 'ERANGEL'];
                                %>
                                <% for (const mapName of displayMaps) { %>
                                    <span class="map-pill-purple"><%= mapName.toUpperCase() %></span>
                                <% } %>
                            </div>
                        </div>

                        <!-- SLOTS FILLED Row -->
                        <div class="card-slots-bar-box">
                            <div class="slots-header-line">
                                <span class="slots-header-label"><i class="fa-solid fa-users"></i> SLOTS FILLED</span>
                                <span class="slots-header-count"><%= (match.teams ? match.teams.length : 0) %> / <%= match.slots %></span>
                            </div>
                            <div class="slots-bar-track">
                                <div class="slots-bar-fill" style="width: <%= filledPercentage %>%;"></div>
                            </div>
                        </div>

                        <!-- Actions Container -->
                        <div class="card-actions-wrapper">
                            <% if (isJoined) { %>
                                <% if (match.whatsappGroupLink) { %>
                                    <div class="card-joined-actions-row">
                                        <a href="<%= match.whatsappGroupLink %>" target="_blank" class="btn-join-idp">
                                            <i class="fa-brands fa-whatsapp"></i> JOIN IDP GROUP
                                        </a>
                                        <button type="button" class="btn-copy-link" onclick="copyWhatsAppLink('<%= match.whatsappGroupLink %>', this)">
                                            <i class="fa-regular fa-copy"></i> Copy Link
                                        </button>
                                    </div>
                                <% } else { %>
                                    <div class="card-joined-actions-row">
                                        <button type="button" class="btn-join-idp" style="background: #28a745; cursor: default;" disabled>
                                            <i class="fa-solid fa-circle-check"></i> Booked Successfully
                                        </button>
                                        <button type="button" class="btn-copy-link" style="opacity: 0.5; cursor: not-allowed;" disabled>
                                            <i class="fa-regular fa-copy"></i> Link TBA
                                        </button>
                                    </div>
                                <% } %>

                                <% if (isFull) { %>
                                    <button class="btn-book-more disabled" disabled><i class="fa-solid fa-ban"></i> Slots Full</button>
                                <% } else { %>
                                    <button type="button" class="btn-book-more" onclick="initiateBooking({ type: 'scrim', id: '<%= id %>', matchid: '<%= match._id %>', title: '<%= match.title %>', entryFee: '<%= match.entryFee %>' })">
                                        <i class="fa-solid fa-plus-circle"></i> Book More Slot
                                    </button>
                                <% } %>

                                <div style="text-align: center; margin-top: 0.15rem; width: 100%;">
                                    <button type="button" class="user-registered-teams-link" data-teams="<%- encodeURIComponent(JSON.stringify(userRegTeams.map(t => ({ _id: t._id, teamName: t.teamName, teamLogo: t.teamLogo, whatsappNumber: t.whatsappNumber })))) %>" onclick="showUserRegisteredTeams(this, event)" style="background: transparent; border: none; color: #38bdf8; font-size: 0.85rem; font-weight: 700; text-decoration: underline; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.25rem 0.5rem; transition: color 0.2s;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#38bdf8'">
                                        <i class="fa-solid fa-shield-halved"></i> See your registered teams
                                        <span class="user-reg-data" style="display: none;"><%- JSON.stringify(userRegTeams) %></span>
                                    </button>
                                </div>
                            <% } else { %>
                                <% if (isFull) { %>
                                    <button class="btn-slots-full-disabled" disabled>
                                        <i class="fa-solid fa-ban"></i> Slots Full
                                    </button>
                                <% } else { %>
                                    <button type="button" class="btn-book-slot-primary" onclick="initiateBooking({ type: 'scrim', id: '<%= id %>', matchid: '<%= match._id %>', title: '<%= match.title %>', entryFee: '<%= match.entryFee %>' })">
                                        <i class="fa-solid fa-ticket"></i> Book Slot
                                    </button>
                                <% } %>
                            <% } %>

                            <!-- Secondary Buttons (View Teams | View Details) -->
                            <div class="card-sec-actions-grid">
                                <button type="button" class="btn-card-secondary" data-booked="<%= isJoined %>" onclick="showTeams(this)">
                                    <i class="fa-solid fa-users"></i> View Teams
                                    <span class="teams-data" style="display: none;"><%- isJoined ? JSON.stringify(approvedTeams) : '[]' %></span>
                                </button>
                                <button type="button" class="btn-card-secondary" onclick="showDetails(this)">
                                    <i class="fa-solid fa-circle-info"></i> View Details
                                    <span class="match-data" style="display: none;" 
                                          data-title="<%= match.title %>"
                                          data-date="<%= match.date %>"
                                          data-prize="<%= match.prizePool %>"
                                          data-slots="<%= match.slots %>"
                                          data-registered="<%= approvedTeams.length %>"
                                          data-fee="<%= match.entryFee %>"
                                          data-timings="<%= match.idpTimings %>"
                                          data-maps="<%= match.maps || '' %>"
                                          data-details="<%= match.details || '' %>"></span>
                                </button>
                            </div>
                        </div>
                    </article>
                <% } %>
            <% } %>

            <!-- Empty State if no scrims match selected date -->
            <div class="no-scrims-card" id="noScrimsMsg" style="display: none;">
                <div class="empty-icon"><i class="fa-regular fa-calendar-xmark"></i></div>
                <h3>No Scrims Found on this Date</h3>
                <p>There are no matches scheduled for the selected date. Choose another date or view all upcoming scrims.</p>
                <button type="button" class="reset-filter-btn" id="resetDateFilter">
                    <i class="fa-solid fa-rotate-left"></i> View All Dates
                </button>
            </div>
        </main>

        <%- include("../partials/footer") %>
        <%- include("../partials/bottomNav") %>
    </div>

    <!-- Date Filter Script -->
    <script>
        const baseurl = "<%= baseurl %>";

        (function() {
            const customDatePicker = document.getElementById('customDatePicker');
            const scrimCards = document.querySelectorAll('.scrim-card');
            const emptyMsg = document.getElementById('noScrimsMsg');
            const noScrimsTitle = document.getElementById('noScrimsTitle');
            const noScrimsDesc = document.getElementById('noScrimsDesc');
            const dateDisplay = document.getElementById('selectedDateDisplay');

            function formatNiceDate(dateStr) {
                try {
                    const parts = dateStr.split('-');
                    if (parts.length === 3) {
                        const d = new Date(parts[0], parts[1] - 1, parts[2]);
                        return d.toLocaleDateString('en-US', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });
                    }
                } catch(e) {}
                return dateStr;
            }

            function applyFilter(customDateValue) {
                let visibleCount = 0;
                const targetDate = (customDateValue || '').trim();

                scrimCards.forEach(card => {
                    const cardDate = (card.getAttribute('data-date') || '').trim();
                    const isMatch = targetDate === 'all' || (cardDate === targetDate);

                    if (isMatch) {
                        card.style.setProperty('display', 'flex', 'important');
                        card.classList.remove('is-hidden');
                        visibleCount++;
                    } else {
                        card.style.setProperty('display', 'none', 'important');
                        card.classList.add('is-hidden');
                    }
                });

                if (emptyMsg) {
                    if (visibleCount === 0) {
                        emptyMsg.style.setProperty('display', 'block', 'important');
                        if (noScrimsTitle) noScrimsTitle.textContent = "No Scrims Scheduled for this Date";
                        if (noScrimsDesc) noScrimsDesc.textContent = "Please pick another date from the calendar to view available scrims.";
                    } else {
                        emptyMsg.style.setProperty('display', 'none', 'important');
                    }
                }

                if (dateDisplay) {
                    if (targetDate === 'all') {
                        dateDisplay.textContent = "All Matches";
                    } else {
                        dateDisplay.textContent = formatNiceDate(targetDate);
                    }
                }
            }

            window.showAllScrims = function() {
                if (customDatePicker) customDatePicker.value = '';
                applyFilter('all');
            };

            if (customDatePicker) {
                customDatePicker.addEventListener('change', function() {
                    if (this.value) {
                        applyFilter(this.value);
                    } else {
                        applyFilter('all');
                    }
                });
            }

            // Get local client today in YYYY-MM-DD
            const now = new Date();
            const year = now.getFullYear();
            const month = String(now.getMonth() + 1).padStart(2, '0');
            const day = String(now.getDate()).padStart(2, '0');
            const todayString = `${year}-${month}-${day}`;

            const initialDate = (customDatePicker && customDatePicker.value) ? customDatePicker.value : todayString;
            if (customDatePicker && !customDatePicker.value) {
                customDatePicker.value = todayString;
            }

            applyFilter(initialDate);
        })();


        let currentBookingParams = null;

        function initiateBooking(params) {
            currentBookingParams = params;
            const fee = Number(params.entryFee) || 0;

            const queryUrl = `/checksignin?categoryId=${encodeURIComponent(params.id)}&matchId=${encodeURIComponent(params.matchid)}&matchTitle=${encodeURIComponent(params.title || '')}`;

            fetch(queryUrl)
                .then(res => res.json())
                .then(data => {
                    if (!data.authenticated) {
                        window.location.href = '/signin';
                        return;
                    }

                    if (!data.hasTeam) {
                        openTeamSettingsModal();
                        return;
                    }

                    if (!data.hasDrop) {
                        openDropDetailsModal();
                        return;
                    }

                    const totalBalance = Number(data.totalBalance) || 0;
                    if (fee > 0 && totalBalance < fee) {
                        alert(`Insufficient balance in your wallet. Required: ₹${fee}, Available: ₹${totalBalance}. Please add cash to book slot.`);
                        return;
                    }

                    const availableTeams = data.availableTeams || [];
                    if (availableTeams.length === 0) {
                        alert("All of your squads are already registered for this scrim! You can manage or create up to 4 teams in Team Settings.");
                        return;
                    }

                    openSelectTeamModal(params, availableTeams, totalBalance);
                })
                .catch(err => {
                    console.error("Auth check error:", err);
                    window.location.href = '/signin';
                });
        }

        function bookSlotDirectly(btn, id, title, entryFee, matchid) {
            initiateBooking({ type: 'scrim', id, matchid, title, entryFee });
        }

        function openSelectTeamModal(params, availableTeams, walletBalance) {
            document.getElementById('selectTeamMatchTitle').textContent = params.title || 'Scrim';
            document.getElementById('selectTeamMatchFee').textContent = '₹' + (params.entryFee || 0);
            document.getElementById('selectTeamWalletBal').textContent = '₹' + walletBalance;

            const listContainer = document.getElementById('selectTeamList');
            listContainer.innerHTML = '';

            availableTeams.forEach((team, index) => {
                const isChecked = index === 0 ? 'checked' : '';
                const logoHtml = team.teamLogo 
                    ? `<img src="${team.teamLogo.startsWith('http') ? team.teamLogo : '/images/' + team.teamLogo}" style="width: 42px; height: 42px; border-radius: 8px; object-fit: cover; flex-shrink: 0;">`
                    : `<div style="width: 42px; height: 42px; border-radius: 8px; background: rgba(212,27,35,0.15); display: flex; align-items: center; justify-content: center; color: #D41B23; font-size: 1.2rem; flex-shrink: 0;"><i class="fa-solid fa-shield-halved"></i></div>`;

                const teamItem = document.createElement('label');
                teamItem.style.cssText = 'display: flex; align-items: center; gap: 0.85rem; padding: 0.85rem; background: rgba(255,255,255,0.03); border: 1.5px solid rgba(255,255,255,0.08); border-radius: 12px; cursor: pointer; transition: all 0.2s;';
                teamItem.innerHTML = `
                    <input type="radio" name="selectedTeamRadio" value="${team._id}" data-name="${escapeHtml(team.teamName)}" ${isChecked} style="accent-color: #D41B23; transform: scale(1.15); margin: 0;">
                    ${logoHtml}
                    <div style="flex: 1; min-width: 0;">
                        <div style="font-weight: 800; color: #ffffff; font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">${escapeHtml(team.teamName)}</div>
                        <div style="font-size: 0.78rem; color: #25d366; display: flex; align-items: center; gap: 0.3rem; margin-top: 2px;">
                            <i class="fa-brands fa-whatsapp"></i> +91 ${team.whatsappNumber || ''}
                        </div>
                    </div>
                `;
                listContainer.appendChild(teamItem);
            });

            document.getElementById('selectTeamModal').style.display = 'flex';
        }

        function closeSelectTeamModal() {
            const modal = document.getElementById('selectTeamModal');
            if (modal) modal.style.display = 'none';
        }

        let currentSlotWhatsappUrl = '';

        function openSlotSuccessModal(params) {
            const modal = document.getElementById('slotSuccessModal');
            const squadText = document.getElementById('slotSuccessSquadText');
            const waWrap = document.getElementById('slotSuccessWhatsappWrap');
            const waBtn = document.getElementById('slotSuccessWhatsappBtn');
            const copyWaBtn = document.getElementById('slotSuccessCopyWaBtn');

            if (squadText) {
                if (params && params.squadName) {
                    squadText.innerHTML = `Your squad <strong style="color: #ffffff;">${escapeHtml(params.squadName)}</strong> has been registered!`;
                } else if (params && params.msg) {
                    squadText.textContent = params.msg;
                } else {
                    squadText.textContent = "Your slot has been confirmed.";
                }
            }

            if (waWrap && waBtn) {
                if (params && params.whatsappGroupLink && params.whatsappGroupLink.trim() !== '') {
                    currentSlotWhatsappUrl = params.whatsappGroupLink.trim();
                    waBtn.href = currentSlotWhatsappUrl;
                    waWrap.style.display = 'flex';
                } else {
                    currentSlotWhatsappUrl = '';
                    waWrap.style.display = 'none';
                }
            }

            if (copyWaBtn) {
                copyWaBtn.innerHTML = '<i class="fa-regular fa-copy"></i> <span>Copy WhatsApp Link</span>';
                copyWaBtn.style.backgroundColor = 'rgba(37, 211, 102, 0.12)';
                copyWaBtn.style.color = '#25d366';
            }

            if (modal) {
                modal.style.display = 'flex';
            }
        }

        function copySlotWhatsAppLink(btn) {
            if (!currentSlotWhatsappUrl) {
                if (typeof showToast === 'function') {
                    showToast('WhatsApp Group Link not available.', 'error');
                } else {
                    alert('WhatsApp Group Link not available.');
                }
                return;
            }
            if (typeof copyWhatsAppLink === 'function') {
                copyWhatsAppLink(currentSlotWhatsappUrl, btn);
            }
            if (typeof showToast === 'function') {
                showToast('WhatsApp group link copied!', 'success');
            }
        }

        function closeSlotSuccessModal() {
            const modal = document.getElementById('slotSuccessModal');
            if (modal) {
                modal.style.display = 'none';
            }
            window.location.reload();
        }

        async function confirmSelectedTeamBooking() {
            const selectedRadio = document.querySelector('input[name="selectedTeamRadio"]:checked');
            if (!selectedRadio) {
                alert("Please select a squad to register.");
                return;
            }

            const teamId = selectedRadio.value;
            const teamName = selectedRadio.getAttribute('data-name') || '';
            const confirmBtn = document.getElementById('confirmBookTeamBtn');
            const originalBtnHtml = confirmBtn.innerHTML;

            try {
                confirmBtn.disabled = true;
                confirmBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Registering Squad...';

                const formData = new FormData();
                formData.append('id', currentBookingParams.id);
                formData.append('title', currentBookingParams.title);
                formData.append('matchid', currentBookingParams.matchid);
                formData.append('teamId', teamId);

                const res = await fetch(`${baseurl}/book`, {
                    method: 'POST',
                    body: formData,
                    credentials: 'include'
                });

                if (res.status === 401) {
                    window.location.href = '/signin';
                    return;
                }

                const result = await res.json();

                if (res.status === 200) {
                    closeSelectTeamModal();
                    openSlotSuccessModal({
                        squadName: teamName,
                        whatsappGroupLink: result.whatsappGroupLink || '',
                        slotNumber: result.slotNumber || 1,
                        msg: result.msg
                    });
                } else {
                    alert(result.msg);
                    confirmBtn.disabled = false;
                    confirmBtn.innerHTML = originalBtnHtml;
                }
            } catch (err) {
                console.error("Booking error:", err);
                alert("Something went wrong. Please try again.");
                confirmBtn.disabled = false;
                confirmBtn.innerHTML = originalBtnHtml;
            }
        }

        function openTeamSettingsModal() {
            document.getElementById('teamSettingsModal').style.display = 'flex';
        }

        function closeTeamSettingsModal() {
            document.getElementById('teamSettingsModal').style.display = 'none';
            document.getElementById('popTeamSettingsForm').reset();
        }

        function openDropDetailsModal() {
            document.getElementById('dropDetailsModal').style.display = 'flex';
        }

        function closeDropDetailsModal() {
            document.getElementById('dropDetailsModal').style.display = 'none';
            document.getElementById('popDropDetailsForm').reset();
        }

        async function submitPopTeamSettings(event) {
            event.preventDefault();
            const form = event.target;
            const submitBtn = document.getElementById('popTeamSubmitBtn');
            const originalHtml = submitBtn.innerHTML;

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';

            const formData = new FormData(form);

            try {
                const res = await fetch(`${baseurl}/team-settings`, {
                    method: 'POST',
                    body: formData
                });

                const result = await res.json();
                alert(result.msg);

                if (res.status === 200) {
                    closeTeamSettingsModal();
                    if (currentBookingParams) {
                        initiateBooking(currentBookingParams);
                    }
                } else {
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalHtml;
                }
            } catch (err) {
                console.error("Save team error:", err);
                alert("Something went wrong. Please try again.");
                submitBtn.disabled = false;
                submitBtn.innerHTML = originalHtml;
            }
        }

        async function submitPopDropDetails(event) {
            event.preventDefault();
            const form = event.target;
            const submitBtn = document.getElementById('popDropSubmitBtn');
            const originalHtml = submitBtn.innerHTML;

            submitBtn.disabled = true;
            submitBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';

            const payload = {
                erangle: document.getElementById('popErangle').value.trim(),
                rando: document.getElementById('popRando').value.trim(),
                miramar: document.getElementById('popMiramar').value.trim()
            };

            try {
                const res = await fetch(`${baseurl}/drop-details`, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(payload)
                });

                const result = await res.json();

                if (res.ok) {
                    alert(typeof result === 'string' ? result : 'Drop details saved successfully!');
                    closeDropDetailsModal();
                    if (currentBookingParams) {
                        initiateBooking(currentBookingParams);
                    }
                } else {
                    alert(result.msg || 'Failed to save drop details.');
                    submitBtn.disabled = false;
                    submitBtn.innerHTML = originalHtml;
                }
            } catch (err) {
