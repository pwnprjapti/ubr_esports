<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Scrims & Categories | UBR Esports</title>
    <link rel="icon" type="image/png" href="/images/ubrLogo.png">
    <meta name="description" content="Browse and filter upcoming BGMI scrims by date. Book your squad slots and compete for cash prize pools.">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/home.css?v=restore">
    <link rel="stylesheet" href="/css/nav.css?v=restore">
    <link rel="stylesheet" href="/css/category.css?v=restore">
    <link rel="stylesheet" href="/css/footer.css?v=restore">
    <style>
        /* Modal overlay styling */
        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.75);
            backdrop-filter: blur(5px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 2000;
            padding: 1rem;
            box-sizing: border-box;
        }

        /* Modal Content Box */
        .modal-content {
            background-color: #151720;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 20px;
            width: 100%;
            max-width: 500px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5);
            display: flex;
            flex-direction: column;
            max-height: 85vh;
            animation: modalFadeIn 0.3s ease;
        }

        @keyframes modalFadeIn {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        /* Modal Header */
        .modal-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 1.25rem 1.5rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.08);
        }

        .modal-header h3 {
            margin: 0;
            font-size: 1.3rem;
            font-weight: 400;
            color: #ffffff;
        }

        .modal-close-btn {
            background: transparent;
            border: none;
            font-size: 1.8rem;
            color: #9e9ea7;
            cursor: pointer;
            transition: color 0.2s ease;
            line-height: 1;
        }

        .modal-close-btn:hover {
            color: #D41B23;
        }

        /* Modal Body */
        .modal-body {
            padding: 1.5rem;
            overflow-y: auto;
            color: #f5f5f7;
            font-size: 0.95rem;
        }

        /* Teams List inside Modal */
        .modal-teams-list {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 0.75rem;
        }

        .modal-team-item {
            display: flex;
            align-items: center;
            gap: 1rem;
            padding: 0.75rem 1rem;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.04);
            border-radius: 12px;
        }

        .modal-team-logo {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(155, 7, 7, 0.15);
            color: #D41B23;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            font-size: 1.2rem;
        }

        .modal-team-logo img {
            width: 100%;
            height: 100%;
            object-fit: cover;
        }

        .modal-team-name {
            font-weight: 700;
            color: #ffffff;
        }

        /* Details inside Modal */
        .modal-details-grid {
            display: flex;
            flex-direction: column;
            gap: 1rem;
        }

        .modal-detail-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding-bottom: 0.75rem;
            border-bottom: 1px solid rgba(255, 255, 255, 0.04);
        }

        .modal-detail-row:last-child {
            border-bottom: none;
            padding-bottom: 0;
        }

        .modal-detail-label {
            color: #9e9ea7;
            font-size: 0.88rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
        }

        .modal-detail-value {
            color: #ffffff;
            font-weight: 700;
            font-size: 0.95rem;
        }

        .modal-detail-value.highlight {
            color: #D41B23;
        }

        /* Date Banner styling */
        .selected-date-banner {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 1rem;
            margin: 1.25rem auto;
            width: 100%;
            max-width: 600px;
        }

        .selected-date-banner .line {
            flex: 1;
            height: 1px;
            background: rgba(212, 27, 35, 0.4);
        }

        .selected-date-banner .date-text {
            color: #D41B23;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 0.08em;
            text-transform: uppercase;
            background: transparent;
            border: none;
            padding: 0 0.5rem;
            text-shadow: none;
            white-space: nowrap;
        }

        @media (max-width: 480px) {
            .modal-teams-list {
                gap: 0.5rem;
            }
            .modal-team-item {
                padding: 0.45rem 0.65rem;
                gap: 0.6rem;
                border-radius: 8px;
            }
            .modal-team-logo {
                width: 32px;
                height: 32px;
                font-size: 1rem;
            }
            .modal-team-name {
                font-size: 0.85rem;
            }
        }

        /* Scrim cards ordering: available slots first, full slots at the bottom */
        .scrim-card {
            order: 1;
        }
        .scrim-card.scrim-card-full {
            order: 2;
            opacity: 0.92;
        }
    </style>
</head>
<body>
    <div class="page-shell">
        <%- include("../partials/nav") %>

        <main class="main-content category-page">
        <% if(wallet && wallet.balance ) {  %>
             <%- include("../partials/wallet", { wallet:wallet.balance }) %>
        <% } %>

            <!-- Date-Based Filter Section -->
            <section class="date-filter-section">
                <div class="filter-header">
                    <div class="filter-title">
                        <i class="fa-solid fa-calendar-days"></i>
                        <span>Filter by Scrim Date</span>
                    </div>
                </div>

                <div class="filter-controls-wrapper">

                    <!-- Specific Custom Date Picker -->
                    <div class="custom-date-picker">
                        <label for="customDatePicker"><i class="fa-regular fa-calendar"></i> Pick Specific Date:</label>
                        <input type="date" id="customDatePicker" name="customDate" min="2026-08-01" max="2026-12-31">
                    </div>
                </div>
            </section>

            <!-- Selected Date Display Banner -->
            <div class="selected-date-banner">
                <span class="line"></span>
                <span class="date-text" id="selectedDateDisplay">Loading Date...</span>
                <span class="line"></span>
            </div>

            <!-- Scrim Grid -->
            <section class="scrim-grid" id="scrimGrid">
                <!-- Scrim 1: Today -->

            <% 
                const hasMatches = Array.isArray(matches) && matches.length > 0; 
                // Sort matches: available slots first, full slots at the bottom
                const sortedMatches = hasMatches ? [...matches].sort((a, b) => {
                    const aTeams = (a && a.teams && Array.isArray(a.teams)) ? a.teams.length : 0;
                    const aSlots = (a && Number(a.slots)) || 0;
                    const aFull = (aSlots > 0 && aTeams >= aSlots) ? 1 : 0;

                    const bTeams = (b && b.teams && Array.isArray(b.teams)) ? b.teams.length : 0;
                    const bSlots = (b && Number(b.slots)) || 0;
                    const bFull = (bSlots > 0 && bTeams >= bSlots) ? 1 : 0;

                    return aFull - bFull;
                }) : [];
            %>

            <div class="no-scrims-card" id="noScrimsMsg" style="display: <%= hasMatches ? 'none' : 'block' %>;">
                <div class="empty-icon"><i class="fa-regular fa-calendar-xmark"></i></div>
                <h3>No Scrims Found for this category </h3>
                <p>There are no matches scheduled for the selected Category. Choose another Category.</p>
                <button type="button" onclick="window.location.href='/'" class="reset-filter-btn" id="resetDateFilter">
                    <i class="fa-solid fa-rotate-left"></i> View All Categories
                </button>
            </div>

            <% if (hasMatches) { %>
                <% for (const match of sortedMatches) { %>
                    <% const approvedTeams = (match.teams || []).filter(t => t.status === "approved" || !t.status); %>
                    <% 
                    const userTeamIdStrings = (typeof userTeams !== 'undefined' && Array.isArray(userTeams))
                        ? userTeams.map(t => t && t._id ? t._id.toString() : '').filter(Boolean)
                        : [];
                    const userRegTeams = (match.teams && Array.isArray(match.teams))
                        ? match.teams.filter(t => {
                            if (!t) return false;
                            const tId = t._id ? t._id.toString() : '';
                            const tTeamId = t.teamId ? t.teamId.toString() : '';
                            const tName = t.teamName ? t.teamName.toString().trim().toLowerCase() : '';
                            const idMatch = (tId && userTeamIdStrings.includes(tId)) || (tTeamId && userTeamIdStrings.includes(tTeamId));
                            const nameMatch = tName && (
                                (typeof userTeamNames !== 'undefined' && Array.isArray(userTeamNames) && userTeamNames.some(ut => ut && ut.toString().trim().toLowerCase() === tName)) ||
                                (typeof userTeamName !== 'undefined' && userTeamName && userTeamName.toString().trim().toLowerCase() === tName)
                            );
                            return idMatch || nameMatch;
                        })
                        : [];
                    const isJoined = userRegTeams.length > 0;
                    const registeredTeam = isJoined ? userRegTeams[0] : null;
                    const isFull = Boolean(match.slots && (match.teams ? match.teams.length : 0) >= match.slots); 
                    %>
                    <article class="scrim-card <%= isFull ? 'scrim-card-full' : '' %>" data-date="<%= match.date %>" data-period="today" data-full="<%= isFull ? 'true' : 'false' %>">
                        <h3 class="scrim-title"><%= match.title %></h3>
                        <div class="scrim-meta">
                            <div class="meta-item">
                                <span class="meta-label"><i class="fa-regular fa-calendar"></i> Match Date</span>
                                <span class="meta-val highlight-date"><%= match.date %></span>
                            </div>
                            <div class="meta-item">
                                <span class="meta-label"><i class="fa-solid fa-sack-dollar"></i> Prize Pool</span>
                                <span class="meta-val prize">₹ <%= match.prizePool %></span>
                            </div>
                            <div class="meta-item" style="flex-direction: column; align-items: flex-start; gap: 0.4rem; width: 100%;">
                                <div style="display: flex; justify-content: space-between; width: 100%; align-items: center;">
                                    <span class="meta-label"><i class="fa-solid fa-users"></i> Slots Booked</span>
                                    <span class="meta-val slot-highlight"> <%= match.teams.length %> / <%= match.slots %> </span>
                                </div>
                                <% const filledPercentage = Math.min(100, Math.round((approvedTeams.length / (match.slots || 1)) * 100)); %>
                                <div class="progress-bar-container" style="width: 100%; height: 8px; background: rgba(255, 255, 255, 0.08); border-radius: 999px; overflow: hidden; border: 1px solid rgba(255, 255, 255, 0.04);">
                                    <div class="progress-bar-fill" style="width: <%= filledPercentage %>%; height: 100%; background: <%= match.teams.length >= match.slots ? '#ff0000' : 'linear-gradient(90deg, #4ade80, #22c55e)' %>; border-radius: 999px; transition: width 0.3s ease;"></div>
                                </div>
                            </div>
                            <div class="meta-item">
                                <span class="meta-label"><i class="fa-solid fa-rupee-sign"></i> Entry Fee</span>
                                <span class="meta-val slot-highlight"> ₹<%= match.entryFee %> </span>
                            </div>
                        </div>
                        <div class="idp-timing">
                            <span class="meta-label"><i class="fa-regular fa-clock"></i> IDP Timing</span>
                            <div class="timings">
                                <% const timings = match.idpTimings.split(","); %>
                                <% for (const time of timings) { %>
                                    <span><%= time %></span>
                                <% } %>
                            </div>
                        </div>
                        <% if (match.maps) { %>
                        <div class="idp-timing" style="margin-top: 10px;">
                            <span class="meta-label"><i class="fa-solid fa-map"></i> Maps</span>
                            <div class="timings">
                                <% const mapsList = match.maps.split(","); %>
                                <% for (const mapName of mapsList) { %>
                                    <span><%= mapName.trim() %></span>
                                <% } %>
                            </div>
                        </div>
                        <% } %>
                       
                        <div class="card-actions-grid" style="display: flex; flex-direction: column; gap: 0.75rem; margin-top: 1rem; width: 100%;">
                              <% if (isJoined) { %>
                                  <% if (match.whatsappGroupLink) { %>
                                      <div style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%;">
                                          <a href="<%= match.whatsappGroupLink %>" target="_blank" class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: #25d366; color: white; text-decoration: none; font-weight: 800; border-radius: 8px; box-shadow: 0 4px 14px rgba(37, 211, 102, 0.35); transition: background-color 0.2s;" onmouseover="this.style.backgroundColor='#128c7e'" onmouseout="this.style.backgroundColor='#25d366'">
                                              <i class="fa-brands fa-whatsapp" style="margin-right: 0.5rem; font-size: 1.1rem;"></i> TAP TO JOIN IDP GROUP
                                          </a>
                                          <button type="button" class="slot-btn" onclick="copyWhatsAppLink('<%= match.whatsappGroupLink %>', this)" title="Copy WhatsApp Group Link" style="width: 100%; min-height: 40px; margin: 0; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; background: rgba(37, 211, 102, 0.12); border: 1px solid rgba(37, 211, 102, 0.5); color: #25d366; border-radius: 8px; cursor: pointer; transition: all 0.2s; font-weight: 700; font-size: 0.88rem;" onmouseover="this.style.backgroundColor='rgba(37, 211, 102, 0.22)'" onmouseout="this.style.backgroundColor='rgba(37, 211, 102, 0.12)'">
                                              <i class="fa-regular fa-copy"></i> <span>Copy WhatsApp Link</span>
                                          </button>
                                          <% if (isFull) { %>
                                              <button class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: #6c757d; color: white;" disabled>
                                                  <i class="fa-solid fa-ban"></i> Slots Full
                                              </button>
                                          <% } else { %>
                                              <button type="button" class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: #D41B23; color: white; font-weight: 800;" onclick="initiateBooking({ type: 'scrim', id: '<%= id %>', matchid: '<%= match._id %>', title: '<%= match.title %>', entryFee: '<%= match.entryFee %>' })">
                                                  <i class="fa-solid fa-plus-circle"></i> Book More Slot
                                              </button>
                                          <% } %>
                                          <div style="text-align: center; margin-top: 0.35rem; width: 100%;">
                                              <button type="button" class="user-registered-teams-link" data-teams="<%- encodeURIComponent(JSON.stringify(userRegTeams.map(t => ({ _id: t._id, teamName: t.teamName, teamLogo: t.teamLogo, whatsappNumber: t.whatsappNumber })))) %>" onclick="showUserRegisteredTeams(this, event)" style="background: transparent; border: none; color: #38bdf8; font-size: 0.86rem; font-weight: 700; text-decoration: underline; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.35rem 0.6rem; transition: color 0.2s;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#38bdf8'">
                                                  <i class="fa-solid fa-shield-halved"></i> See your registered teams
                                                  <span class="user-reg-data" style="display: none;"><%- JSON.stringify(userRegTeams) %></span>
                                              </button>
                                          </div>
                                      </div>
                                  <% } else { %>
                                     <div style="display: flex; flex-direction: column; gap: 0.5rem; width: 100%;">
                                         <button class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: #28a745; color: white;" disabled>
                                             <i class="fa-solid fa-circle-check"></i> Booked Successfully
                                         </button>
                                         <% if (isFull) { %>
                                             <button class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: #6c757d; color: white;" disabled>
                                                 <i class="fa-solid fa-ban"></i> Slots Full
                                             </button>
                                         <% } else { %>
                                             <button type="button" class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: #D41B23; color: white; font-weight: 800;" onclick="initiateBooking({ type: 'scrim', id: '<%= id %>', matchid: '<%= match._id %>', title: '<%= match.title %>', entryFee: '<%= match.entryFee %>' })">
                                                 <i class="fa-solid fa-plus-circle"></i> Book More Slot
                                             </button>
                                         <% } %>
                                         <div style="text-align: center; margin-top: 0.35rem; width: 100%;">
                                             <button type="button" class="user-registered-teams-link" data-teams="<%- encodeURIComponent(JSON.stringify(userRegTeams.map(t => ({ _id: t._id, teamName: t.teamName, teamLogo: t.teamLogo, whatsappNumber: t.whatsappNumber })))) %>" onclick="showUserRegisteredTeams(this, event)" style="background: transparent; border: none; color: #38bdf8; font-size: 0.86rem; font-weight: 700; text-decoration: underline; cursor: pointer; display: inline-flex; align-items: center; justify-content: center; gap: 0.4rem; padding: 0.35rem 0.6rem; transition: color 0.2s;" onmouseover="this.style.color='#ffffff'" onmouseout="this.style.color='#38bdf8'">
                                                 <i class="fa-solid fa-shield-halved"></i> See your registered teams
                                                 <span class="user-reg-data" style="display: none;"><%- JSON.stringify(userRegTeams) %></span>
                                             </button>
                                         </div>
                                     </div>
                                  <% } %>
                             <% } else { %>
                                 <% if (match.teams && match.teams.length >= match.slots) { %>
                                     <button class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center; background: #6c757d; color: white;" disabled>
                                         <i class="fa-solid fa-ban"></i> Slots Full
                                     </button>
                                 <% } else { %>
                                     <button class="slot-btn" style="width: 100%; margin: 0; min-height: 44px; display: inline-flex; align-items: center; justify-content: center;" onclick="initiateBooking({ type: 'scrim', id: '<%= id %>', matchid: '<%= match._id %>', title: '<%= match.title %>', entryFee: '<%= match.entryFee %>' })"><i class="fa-solid fa-ticket"></i> Book Slot</button>
                                 <% } %>
                             <% } %>
                             <div class="secondary-actions" style="display: grid; grid-template-columns: 1fr 1fr; gap: 0.5rem; width: 100%;">
                                 <button type="button" class="pay-btn" style="min-height: 38px; padding: 0.5rem; font-size: 0.85rem; width: 100%;" data-booked="<%= isJoined %>" onclick="showTeams(this)">
                                     <i class="fa-solid fa-users"></i> View Teams
                                     <span class="teams-data" style="display: none;"><%- isJoined ? JSON.stringify(approvedTeams) : '[]' %></span>
                                 </button>
                                 <button type="button" class="pay-btn" style="min-height: 38px; padding: 0.5rem; font-size: 0.85rem; width: 100%;" onclick="showDetails(this)">
                                     <i class="fa-solid fa-circle-info"></i> View Details
                                     <span class="match-data" style="display: none;" 
                                           data-title="<%= match.title %>"
                                           data-date="<%= match.date %>"
                                           data-prize="<%= match.prizePool %>"
                                           data-slots="<%= match.slots %>"
                                           data-registered="<%= approvedTeams.length %>"
                                           data-fee="<%= match.entryFee %>"
                                           data-timings="<%= match.idpTimings %>"
                                           data-maps="<%= match.maps || '' %>"
                                           data-details="<%= match.details || '' %>"></span>
                                 </button>
                             </div>
                        </div>
                    </article>
                <% } %>
            <% } %>

            <!-- Empty State if no scrims match selected date -->
            <div class="no-scrims-card" id="noScrimsMsg" style="display: none;">
                <div class="empty-icon"><i class="fa-regular fa-calendar-xmark"></i></div>
                <h3>No Scrims Found on this Date</h3>
                <p>There are no matches scheduled for the selected date. Choose another date or view all upcoming scrims.</p>
                <button type="button" class="reset-filter-btn" id="resetDateFilter">
                    <i class="fa-solid fa-rotate-left"></i> View All Dates
                </button>
            </div>
        </main>

        <%- include("../partials/footer") %>
        <%- include("../partials/bottomNav") %>
    </div>

    <!-- Date Filter Script -->
    <script>
        const baseurl = "<%= baseurl %>";

        (function() {
            const datePills = document.querySelectorAll('.date-pill');
            const customDatePicker = document.getElementById('customDatePicker');
            const scrimCards = document.querySelectorAll('.scrim-card');
            const countDisplay = document.getElementById('scrimCount');
            const emptyMsg = document.getElementById('noScrimsMsg');
            const resetBtn = document.getElementById('resetDateFilter');

            function applyFilter(filterType, customDateValue = null) {
                let visibleCount = 0;

                scrimCards.forEach(card => {
                    const cardDate = card.getAttribute('data-date');
                    const cardPeriod = card.getAttribute('data-period');
                    let isMatch = false;

                    if (customDateValue) {
                        isMatch = (cardDate === customDateValue);
                    } else if (filterType === 'all') {
                        isMatch = true;
                    } else if (filterType === 'today') {
                        isMatch = (cardPeriod === 'today' || cardDate === '2026-08-11');
                    } else if (filterType === 'tomorrow') {
                        isMatch = (cardPeriod === 'tomorrow' || cardDate === '2026-08-12');
                    } else if (filterType === 'weekend') {
                        isMatch = (cardPeriod === 'weekend' || cardDate === '2026-08-15' || cardDate === '2026-08-16');
                    } else if (filterType === 'week') {
                        isMatch = (cardDate >= '2026-08-11' && cardDate <= '2026-08-17');
                    }

                    if (isMatch) {
                        card.style.display = 'flex';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                // Update counter and empty state
                if (countDisplay) {
                    countDisplay.textContent = `Showing ${visibleCount} of ${scrimCards.length} Scrims`;
                }
                if (visibleCount === 0) {
                    emptyMsg.style.display = 'block';
                } else {
                    emptyMsg.style.display = 'none';
                }

                // Update selected date display banner
                const dateDisplay = document.getElementById('selectedDateDisplay');
                if (dateDisplay) {
                    if (customDateValue) {
                        try {
                            const dateParts = customDateValue.split('-');
                            const formattedDate = new Date(dateParts[0], dateParts[1] - 1, dateParts[2]);
                            const options = { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' };
                            dateDisplay.textContent = formattedDate.toLocaleDateString('en-US', options);
                        } catch(e) {
                            dateDisplay.textContent = customDateValue;
                        }
                    } else if (filterType === 'all') {
                        dateDisplay.textContent = "All Upcoming Matches";
                    } else {
                        dateDisplay.textContent = filterType.charAt(0).toUpperCase() + filterType.slice(1) + "'s Matches";
                    }
                }
            }

            // Quick Pill Clicks
            datePills.forEach(pill => {
                pill.addEventListener('click', function() {
                    datePills.forEach(p => p.classList.remove('active'));
                    this.classList.add('active');
                    if (customDatePicker) customDatePicker.value = '';
                    const filter = this.getAttribute('data-filter');
                    applyFilter(filter);
                });
            });

            // Date Picker Change
            if (customDatePicker) {
                customDatePicker.addEventListener('change', function() {
                    if (this.value) {
                        datePills.forEach(p => p.classList.remove('active'));
                        applyFilter('custom', this.value);
                    }
                });
            }

            // Reset Button
            if (resetBtn) {
                resetBtn.addEventListener('click', function() {
                    datePills.forEach(p => p.classList.remove('active'));
                    const allPill = document.querySelector('.date-pill[data-filter="all"]');
                    if (allPill) allPill.classList.add('active');
                    if (customDatePicker) customDatePicker.value = '';
                    applyFilter('all');
                });
            }

            // Pre-fill current date (today) in YYYY-MM-DD format and apply filter
            const today = new Date();
            const year = today.getFullYear();
            const month = String(today.getMonth() + 1).padStart(2, '0');
            const day = String(today.getDate()).padStart(2, '0');
            const todayString = `${year}-${month}-${day}`;
            
            if (customDatePicker) {
                customDatePicker.value = todayString;
                applyFilter('custom', todayString);
            }
        })();


        let currentBookingParams = null;

        function initiateBooking(params) {
            currentBookingParams = params;
            const fee = Number(params.entryFee) || 0;

            const queryUrl = `/checksignin?categoryId=${encodeURIComponent(params.id)}&matchId=${encodeURIComponent(params.matchid)}&matchTitle=${encodeURIComponent(params.title || '')}`;

            fetch(queryUrl)
                .then(res => res.json())
                .then(data => {
                    if (!data.authenticated) {
                        window.location.href = '/signin';
                        return;
                    }

                    if (!data.hasTeam) {
                        openTeamSettingsModal();
                        return;
                    }

                    if (!data.hasDrop) {
                        openDropDetailsModal();
                        return;
                    }

                    const totalBalance = Number(data.totalBalance) || 0;
                    if (fee > 0 && totalBalance < fee) {
                        alert(`Insufficient balance in your wallet. Required: ₹${fee}, Available: ₹${totalBalance}. Please add cash to book slot.`);
                        return;
                    }

                    const availableTeams = data.availableTeams || [];
                    if (availableTeams.length === 0) {
                        alert("All of your squads are already registered for this scrim! You can manage or create up to 4 teams in Team Settings.");
                        return;
                    }

                    openSelectTeamModal(params, availableTeams, totalBalance);
                })
                .catch(err => {
                    console.error("Auth check error:", err);
                    window.location.href = '/signin';
                });
        }

        function bookSlotDirectly(btn, id, title, entryFee, matchid) {
            initiateBooking({ type: 'scrim', id, matchid, title, entryFee });
        }

