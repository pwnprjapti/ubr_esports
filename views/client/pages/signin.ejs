<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Sign In | UBR Esports</title>
    <link rel="icon" type="image/png" href="/images/ubrLogo.png">
    <meta name="description" content="Sign in to your UBR Esports account with Google to join BGMI scrims, access daily scrims, and manage your wallet.">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css" />
    <link rel="stylesheet" href="/css/home.css">
    <link rel="stylesheet" href="/css/nav.css">
    <link rel="stylesheet" href="/css/footer.css">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        .auth-page {
            min-height: calc(100vh - 160px);
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 2.5rem 1.25rem 3.5rem;
            width: 100%;
            position: relative;
        }

        .auth-container {
            width: 100%;
            max-width: 460px;
            margin: 0 auto;
            position: relative;
        }

        /* Ambient Glow behind card */
        .auth-container::before {
            content: "";
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 90%;
            height: 90%;
            background: radial-gradient(circle, rgba(215, 38, 61, 0.22) 0%, transparent 70%);
            filter: blur(40px);
            pointer-events: none;
            z-index: 0;
        }

        .auth-card {
            position: relative;
            z-index: 1;
            width: 100%;
            background: var(--panel-card, #151720);
            border: 1px solid var(--border, rgba(255, 255, 255, 0.08));
            border-radius: 22px;
            padding: 2.5rem 2rem;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.45);
            text-align: center;
            overflow: hidden;
        }

        .auth-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.45rem;
            padding: 0.35rem 0.85rem;
            border-radius: 999px;
            background: rgba(215, 38, 61, 0.12);
            border: 1px solid rgba(215, 38, 61, 0.25);
            color: var(--accent-2, #ff455e);
            font-size: 0.78rem;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.06em;
            margin-bottom: 1.25rem;
        }

        .auth-card-icon {
            width: 64px;
            height: 64px;
            margin: 0 auto 1.25rem;
            border-radius: 50%;
            background: linear-gradient(135deg, rgba(215, 38, 61, 0.2), rgba(255, 69, 94, 0.1));
            border: 1px solid rgba(215, 38, 61, 0.35);
            display: grid;
            place-items: center;
            color: var(--accent-2, #ff455e);
            font-size: 1.75rem;
            box-shadow: 0 0 24px rgba(215, 38, 61, 0.3);
        }

        .auth-card h1 {
            margin: 0 0 0.5rem;
            font-size: clamp(1.45rem, 4vw, 1.85rem);
            font-weight: 900;
            color: #ffffff;
            letter-spacing: -0.01em;
        }

        .auth-card p.subtitle {
            color: var(--muted, #9e9ea7);
            line-height: 1.6;
            font-size: 0.92rem;
            margin: 0 auto 1.75rem;
            max-width: 360px;
        }

        /* Perks list */
        .auth-perks {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 0.5rem;
            margin-bottom: 1.75rem;
            text-align: center;
        }

        .perk-item {
            background: rgba(255, 255, 255, 0.03);
            border: 1px solid rgba(255, 255, 255, 0.05);
            padding: 0.6rem 0.4rem;
            border-radius: 12px;
        }

        .perk-item i {
            color: #ff9da8;
            font-size: 0.95rem;
            margin-bottom: 0.25rem;
            display: block;
        }

        .perk-item span {
            font-size: 0.72rem;
            font-weight: 700;
            color: #d1d1d6;
            display: block;
            line-height: 1.2;
        }

        /* Google Button - Fixed outflow with box-sizing */
        .google-btn-wrapper {
            width: 100%;
            margin-bottom: 1.25rem;
        }

        .google-btn {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 0.75rem;
            width: 100%;
            max-width: 100%;
            box-sizing: border-box;
            padding: 0.85rem 1.25rem;
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 999px;
            background: #ffffff;
            color: #1a1a1a;
            font-weight: 800;
            font-size: 0.95rem;
            text-decoration: none;
            cursor: pointer;
            box-shadow: 0 4px 18px rgba(0, 0, 0, 0.35);
            transition: all 0.2s ease;
            min-height: 48px;
            user-select: none;
        }

        .google-btn:hover,
        .google-btn:active {
            background: #f4f4f6;
            transform: translateY(-2px);
            box-shadow: 0 8px 24px rgba(255, 255, 255, 0.2);
            border-color: #ffffff;
        }

        .google-icon-svg {
            width: 20px;
            height: 20px;
            min-width: 20px;
            display: block;
        }

        .auth-footer-note {
            font-size: 0.8rem;
            color: var(--muted, #9e9ea7);
            line-height: 1.5;
            margin: 0;
        }

        .auth-footer-note a {
            color: var(--accent-2, #ff455e);
            text-decoration: underline;
            text-underline-offset: 2px;
        }

        .auth-footer-note a:hover {
            color: #ffffff;
        }

        .security-badge {
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            margin-top: 1.25rem;
            font-size: 0.76rem;
            color: #8e8e93;
        }

        .security-badge i {
            color: #22c55e;
        }

        /* Responsive Breakpoints */
        @media (max-width: 480px) {
            .auth-page {
                padding: 1.25rem 1rem 2.5rem;
            }

            .auth-card {
                padding: 1.75rem 1.25rem;
                border-radius: 18px;
            }

            .auth-card h1 {
                font-size: 1.45rem;
            }

            .auth-perks {
                gap: 0.35rem;
            }

            .perk-item {
                padding: 0.5rem 0.25rem;
            }

            .perk-item span {
                font-size: 0.68rem;
            }

            .google-btn {
                padding: 0.75rem 1rem;
                font-size: 0.9rem;
                gap: 0.6rem;
            }
        }

        @media (max-width: 340px) {
            .auth-perks {
                grid-template-columns: 1fr;
            }

            .perk-item {
                display: flex;
                align-items: center;
                gap: 0.5rem;
                padding: 0.4rem 0.6rem;
                text-align: left;
            }

            .perk-item i {
                margin-bottom: 0;
            }
        }
    </style>
</head>
<body>
    <div class="page-shell">
        <%- include("../partials/nav") %>

        <main class="auth-page">
            <div class="auth-container">
                <div class="auth-card">
                    <!-- <div class="auth-badge">
                        <i class="fa-solid fa-gamepad"></i>
                        <span>Gamer Portal</span>
                    </div>

                    <div class="auth-card-icon">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div> -->

                    <h1>Sign In to UBR</h1>
                    <p class="subtitle">Join competitive BGMI scrims, enter paid scrims, and receive instant wallet cashouts.</p>

                    <!-- Feature perks -->
                    <!-- <div class="auth-perks">
                        <div class="perk-item">
                            <i class="fa-solid fa-bolt"></i>
                            <span>Instant UPI Payouts</span>
                        </div>
                        <div class="perk-item">
                            <i class="fa-solid fa-trophy"></i>
                            <span>Daily Cash Scrims</span>
                        </div>
                        <div class="perk-item">
                            <i class="fa-solid fa-shield-check"></i>
                            <span>Anti-Cheat Protected</span>
                        </div>
                    </div> -->

                    <!-- Google OAuth CTA Button -->
                    <div class="google-btn-wrapper">
                        <% const authLink = (typeof googleAuthUrl !== 'undefined' && googleAuthUrl) ? googleAuthUrl : '/auth/google'; %>
                        <a class="google-btn" href="<%= authLink %>" role="button" aria-label="Sign in with Google">
                            <svg class="google-icon-svg" viewBox="0 0 48 48">
                                <path fill="#EA4335" d="M24 9.5c3.54 0 6.71 1.22 9.21 3.6l6.85-6.85C35.9 2.38 30.47 0 24 0 14.62 0 6.51 5.38 2.56 13.22l7.98 6.19C12.43 13.72 17.74 9.5 24 9.5z"/>
                                <path fill="#4285F4" d="M46.98 24.55c0-1.57-.15-3.09-.38-4.55H24v9.02h12.94c-.58 2.96-2.26 5.48-4.78 7.18l7.73 6c4.51-4.18 7.09-10.36 7.09-17.65z"/>
                                <path fill="#FBBC05" d="M10.53 28.59c-.48-1.45-.76-2.99-.76-4.59s.27-3.14.76-4.59l-7.98-6.19C.92 16.46 0 20.12 0 24c0 3.88.92 7.54 2.56 10.78l7.97-6.19z"/>
                                <path fill="#34A853" d="M24 48c6.48 0 11.93-2.13 15.89-5.81l-7.73-6c-2.15 1.45-4.92 2.3-8.16 2.3-6.26 0-11.57-4.22-13.47-9.91l-7.98 6.19C6.51 42.62 14.62 48 24 48z"/>
                            </svg>
                            <span>Continue with Google</span>
                        </a>
                    </div>

                    <p class="auth-footer-note">
                        By continuing, you agree to our 
                        <a href="/terms">Terms</a> and 
                        <a href="/privacy-policy">Privacy Policy</a>.
                    </p>

                    <div class="security-badge">
                        <i class="fa-solid fa-lock"></i>
                        <span>End-to-End Secure OAuth 2.0</span>
                    </div>
                </div>
            </div>
        </main>

        <%- include("../partials/footer") %>
    </div>
</body>
</html>
