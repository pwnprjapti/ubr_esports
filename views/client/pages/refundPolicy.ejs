<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Refund and Cancellation Policy | UBR Esports</title>
    <link rel="icon" type="image/jpeg" href="/images/photo.jpg.jpeg">
    <meta name="description" content="UBR Esports refund and cancellation policy regarding slot bookings, matches, and refunds.">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/terms.css">
