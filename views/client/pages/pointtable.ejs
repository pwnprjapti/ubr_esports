<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Point Tables | UBR Esports</title>
    <link rel="icon" type="image/jpeg" href="/images/photo.jpg.jpeg">
    <meta name="description" content="Check upcoming and completed BGMI tournament standing point tables on UBR Esports.">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/terms.css">
    <link rel="stylesheet" href="/css/nav.css">
    <link rel="stylesheet" href="/css/footer.css">
    <style>
        .pt-grid {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            width: 100%;
            margin-top: 1.5rem;
        }

        .pt-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #151720;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 1.25rem 1.5rem;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .pt-card:hover {
            transform: translateY(-2px);
            border-color: rgba(215, 38, 61, 0.4);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.35);
        }

        .pt-card h3 {
            margin: 0 !important;
            font-size: 1.2rem !important;
            font-weight: 800;
            color: #ffffff;
        }

        .pt-card p {
            margin: 0.25rem 0 0 0 !important;
            font-size: 0.88rem !important;
            color: #a0a0aa !important;
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(8px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 1rem;
            box-sizing: border-box;
        }

        .modal-close-btn {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            background: transparent;
            border: none;
            font-size: 2.5rem;
            color: #ffffff;
            cursor: pointer;
            line-height: 1;
            transition: color 0.2s ease;
        }

        .modal-close-btn:hover {
            color: #ff455e;
        }

        .lightbox-img {
            max-width: 90%;
            max-height: 90vh;
            object-fit: contain;
            border-radius: 12px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
            animation: modalFadeIn 0.3s ease;
        }

        @keyframes modalFadeIn {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
    </style>
</head>
<body>
    <div class="page-shell">
        <%- include("../partials/nav") %>

        <main class="terms-page">
            <div class="card">
                <h1>Tournament Point Tables</h1>
                <p class="meta">View standings of all recent scrims and matches</p>

                <% if (pointTables.length === 0) { %>
                    <div style="text-align: center; padding: 3rem 1rem; color: #a0a0aa;">
                        <i class="fa-solid fa-table-list" style="font-size: 3.5rem; color: #ff455e; margin-bottom: 1.5rem; display: block;"></i>
                        <h3 style="margin: 0; color: #ffffff; font-size: 1.25rem;">No Point Tables Available</h3>
                        <p style="margin: 0.5rem 0 0 0; font-size: 0.95rem;">Standings will be updated as soon as matches finish.</p>
                    </div>
                <% } else { %>
                    <div class="pt-grid">
                        <% pointTables.forEach(pt => { %>
                            <div class="pt-card" onclick="openPtModal('/images/<%= pt.pointTableImage %>')">
                                <div style="display: flex; align-items: center; gap: 1rem; text-align: left;">
                                    <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(215, 38, 61, 0.15); display: flex; align-items: center; justify-content: center; color: #ff455e;">
                                        <i class="fa-solid fa-ranking-star" style="font-size: 1.25rem;"></i>
                                    </div>
                                    <div>
                                        <h3><%= pt.matchTitle %></h3>
                                        <p><%= pt.categoryTitle %></p>
                                    </div>
                                </div>
                                <i class="fa-solid fa-chevron-right" style="color: #a0a0aa; font-size: 1.1rem; margin-right: 0.5rem;"></i>
                            </div>
                        <% }) %>
                    </div>
                <% } %>
            </div>
        </main>

        <%- include("../partials/footer") %>
    </div>

    <!-- Image Lightbox Modal -->
    <div id="ptModal" class="modal-overlay" onclick="closePtModal()">
        <button class="modal-close-btn" onclick="closePtModal()">&times;</button>
        <img id="ptLightboxImg" class="lightbox-img" src="" alt="Point Table Standings" onclick="event.stopPropagation()">
    </div>

    <script>
        function openPtModal(src) {
            const modal = document.getElementById('ptModal');
            const img = document.getElementById('ptLightboxImg');
            img.src = src;
            modal.style.display = 'flex';
        }

        function closePtModal() {
            document.getElementById('ptModal').style.display = 'none';
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closePtModal();
            }
        });
    </script>
</body>
</html>
