<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Point Tables | UBR Esports</title>
    <link rel="icon" type="image/jpeg" href="/images/photo.jpg.jpeg">
    <meta name="description" content="Check upcoming and completed BGMI tournament standing point tables on UBR Esports.">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/terms.css">
    <link rel="stylesheet" href="/css/nav.css">
    <link rel="stylesheet" href="/css/footer.css">
    <style>
        .pt-grid {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            width: 100%;
            margin-top: 1.5rem;
        }

        .pt-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #151720;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 1.25rem 1.5rem;
            cursor: pointer;
            transition: all 0.25s ease;
        }

        .pt-card:hover {
            transform: translateY(-2px);
            border-color: rgba(215, 38, 61, 0.4);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.35);
        }

        .pt-card h3 {
            margin: 0 !important;
            font-size: 1.2rem !important;
            font-weight: 800;
            color: #ffffff;
        }

        .pt-card p {
            margin: 0.25rem 0 0 0 !important;
            font-size: 0.88rem !important;
            color: #a0a0aa !important;
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(8px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 1rem;
            box-sizing: border-box;
        }

        .modal-close-btn {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            background: transparent;
            border: none;
            font-size: 2.5rem;
            color: #ffffff;
            cursor: pointer;
            line-height: 1;
            transition: color 0.2s ease;
        }

        .modal-close-btn:hover {
            color: #ff455e;
        }

        .lightbox-img {
            max-width: 90%;
            max-height: 90vh;
            object-fit: contain;
            border-radius: 12px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
            animation: modalFadeIn 0.3s ease;
        }

        @keyframes modalFadeIn {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }
    </style>
</head>
<body>
    <div class="page-shell">
        <%- include("../partials/nav") %>

        <main class="terms-page">
            <div class="card">
                <h1>Tournament Point Tables</h1>
                <p class="meta">View standings of all recent scrims and matches</p>

                <% if (pointTables.length === 0) { %>
                    <div style="text-align: center; padding: 3rem 1rem; color: #a0a0aa;">
                        <i class="fa-solid fa-table-list" style="font-size: 3.5rem; color: #ff455e; margin-bottom: 1.5rem; display: block;"></i>
                        <h3 style="margin: 0; color: #ffffff; font-size: 1.25rem;">No Point Tables Available</h3>
                        <p style="margin: 0.5rem 0 0 0; font-size: 0.95rem;">Standings will be updated as soon as matches finish.</p>
                    </div>
                <% } else { %>
                    <!-- Date Filter Control -->
                    <div class="date-filter-section" style="margin-top: 1.25rem; margin-bottom: 1.5rem; display: flex; flex-wrap: wrap; gap: 0.75rem; align-items: center; justify-content: flex-start; background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.06); padding: 0.75rem 1rem; border-radius: 10px;">
                        <div style="display: flex; align-items: center; gap: 0.5rem; flex: 1; min-width: 250px;">
                            <label for="ptDatePicker" style="color: #9e9ea7; font-size: 0.85rem; font-weight: 700; white-space: nowrap;"><i class="fa-regular fa-calendar" style="margin-right: 0.35rem;"></i> Filter by Date:</label>
                            <input type="date" id="ptDatePicker" style="background-color: #1a1c26; color: #fff; border: 1px solid rgba(255,255,255,0.08); padding: 0.4rem 0.75rem; border-radius: 6px; font-size: 0.88rem; width: 100%; box-sizing: border-box; cursor: pointer;">
                        </div>
                        <button type="button" id="resetPtFilter" style="background: rgba(255,255,255,0.06); border: 1px solid rgba(255,255,255,0.1); color: #fff; padding: 0.4rem 0.85rem; border-radius: 6px; font-size: 0.85rem; font-weight: 600; cursor: pointer; display: flex; align-items: center; gap: 0.35rem; transition: background 0.2s;" onmouseover="this.style.background='rgba(255,255,255,0.1)'" onmouseout="this.style.background='rgba(255,255,255,0.06)'">
                            <i class="fa-solid fa-rotate-left"></i> Reset
                        </button>
                    </div>

                    <div class="pt-grid">
                        <% pointTables.forEach(pt => { %>
                            <div class="pt-card" data-date="<%= pt.date || '' %>" onclick="openPtModal('<%= imageUrl(pt.pointTableImage) %>')">
                                <div style="display: flex; align-items: center; gap: 1rem; text-align: left;">
                                    <div style="width: 44px; height: 44px; border-radius: 10px; background: rgba(215, 38, 61, 0.15); display: flex; align-items: center; justify-content: center; color: #ff455e;">
                                        <i class="fa-solid fa-ranking-star" style="font-size: 1.25rem;"></i>
                                    </div>
                                    <div>
                                        <h3><%= pt.matchTitle %></h3>
                                        <p><%= pt.categoryTitle %><% if (pt.date) { %> • <%= pt.date %><% } %></p>
                                    </div>
                                </div>
                                <i class="fa-solid fa-chevron-right" style="color: #a0a0aa; font-size: 1.1rem; margin-right: 0.5rem;"></i>
                            </div>
                        <% }) %>
                        
                        <!-- Empty State for Date Filter -->
                        <div id="noPtMsg" style="display: none; text-align: center; padding: 3rem 1rem; color: #a0a0aa; width: 100%;">
                            <i class="fa-regular fa-calendar-xmark" style="font-size: 3rem; color: #ff455e; margin-bottom: 1.25rem; display: block;"></i>
                            <h3 style="margin: 0; color: #ffffff; font-size: 1.2rem;">No Point Tables for this Date</h3>
                            <p style="margin: 0.5rem 0 0 0; font-size: 0.9rem;">There are no tournament standings matching the selected date.</p>
                        </div>
                    </div>
                <% } %>
            </div>
        </main>

        <%- include("../partials/footer") %>
    </div>

    <!-- Image Lightbox Modal -->
    <div id="ptModal" class="modal-overlay" onclick="closePtModal()">
        <button class="modal-close-btn" onclick="closePtModal()">&times;</button>
        <img id="ptLightboxImg" class="lightbox-img" src="" alt="Point Table Standings" onclick="event.stopPropagation()">
    </div>

    <script>
        function openPtModal(src) {
            const modal = document.getElementById('ptModal');
            const img = document.getElementById('ptLightboxImg');
            img.src = src;
            modal.style.display = 'flex';
        }

        function closePtModal() {
            document.getElementById('ptModal').style.display = 'none';
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closePtModal();
            }
        });

        document.addEventListener("DOMContentLoaded", function() {
            const ptDatePicker = document.getElementById('ptDatePicker');
            const resetPtFilter = document.getElementById('resetPtFilter');
            const ptCards = document.querySelectorAll('.pt-card');
            const noPtMsg = document.getElementById('noPtMsg');

            function filterPt(dateVal) {
                let visibleCount = 0;
                ptCards.forEach(card => {
                    const cardDate = card.getAttribute('data-date');
                    if (!dateVal || cardDate === dateVal) {
                        card.style.display = 'flex';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (noPtMsg) {
                    noPtMsg.style.display = visibleCount === 0 ? 'block' : 'none';
                }
            }

            if (ptDatePicker) {
                ptDatePicker.addEventListener('change', function() {
                    filterPt(this.value);
                });
            }

            if (resetPtFilter) {
                resetPtFilter.addEventListener('click', function() {
                    if (ptDatePicker) ptDatePicker.value = '';
                    filterPt(null);
                });
            }
        });
    </script>
</body>
</html>
