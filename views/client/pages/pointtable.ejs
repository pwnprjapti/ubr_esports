<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=5.0">
    <title>Point Tables | UBR Esports</title>
    <link rel="icon" type="image/png" href="/images/ubrLogo.png">
    <meta name="description" content="Check upcoming and completed BGMI scrim standing point tables on UBR Esports.">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
    <link rel="stylesheet" href="/css/terms.css?v=restore">
    <link rel="stylesheet" href="/css/nav.css?v=restore">
    <link rel="stylesheet" href="/css/footer.css?v=restore">
    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        html, body {
            max-width: 100vw;
            width: 100%;
            margin: 0;
            padding: 0;
        }

        body {
            overflow-x: clip;
        }

        .page-shell {
            width: 100% !important;
            max-width: 100vw !important;
            box-sizing: border-box !important;
            position: relative;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .navbar-wrapper {
            position: sticky !important;
            top: 0 !important;
            left: 0 !important;
            right: 0 !important;
            z-index: 1000 !important;
            width: 100% !important;
            max-width: 100vw !important;
            box-sizing: border-box !important;
        }

        .navbar {
            width: 100% !important;
            box-sizing: border-box !important;
        }

        h1, h2, h3, h4, h5, h6 {
            font-weight: 500;
        }

        .terms-page {
            width: 100% !important;
            max-width: 900px !important;
            box-sizing: border-box !important;
        }

        .terms-page .card {
            width: 100% !important;
            max-width: 100% !important;
            box-sizing: border-box !important;
        }

        /* Date Filter Control */
        .pt-date-filter {
            margin-top: 1.25rem;
            margin-bottom: 1.5rem;
            display: flex;
            flex-wrap: wrap;
            gap: 0.75rem;
            align-items: center;
            justify-content: flex-start;
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid rgba(255, 255, 255, 0.06);
            padding: 0.75rem 1rem;
            border-radius: 10px;
            width: 100%;
            max-width: 100%;
            box-sizing: border-box;
        }

        .pt-filter-input-wrap {
            display: flex;
            align-items: center;
            gap: 0.6rem;
            flex: 1;
            min-width: 220px;
            box-sizing: border-box;
        }

        .pt-filter-label {
            color: #9e9ea7;
            font-size: 0.85rem;
            font-weight: 700;
            white-space: nowrap;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
        }

        .pt-filter-date-input {
            background-color: #1a1c26;
            color: #ffffff;
            border: 1px solid rgba(255, 255, 255, 0.08);
            padding: 0.45rem 0.75rem;
            border-radius: 6px;
            font-size: 0.88rem;
            width: 100%;
            min-width: 0;
            box-sizing: border-box;
            cursor: pointer;
            transition: border-color 0.2s;
        }

        .pt-filter-date-input:focus {
            outline: none;
            border-color: #D41B23;
        }

        .pt-filter-reset-btn {
            background: rgba(255, 255, 255, 0.06);
            border: 1px solid rgba(255, 255, 255, 0.1);
            color: #ffffff;
            padding: 0.45rem 0.85rem;
            border-radius: 6px;
            font-size: 0.85rem;
            font-weight: 600;
            cursor: pointer;
            display: inline-flex;
            align-items: center;
            gap: 0.35rem;
            transition: background-color 0.2s;
            box-sizing: border-box;
            white-space: nowrap;
        }

        .pt-filter-reset-btn:hover {
            background: rgba(255, 255, 255, 0.12);
        }

        /* Point Table Grid & Cards */
        .pt-grid {
            display: flex;
            flex-direction: column;
            gap: 0.85rem;
            width: 100%;
            max-width: 100%;
            box-sizing: border-box;
            margin-top: 1.25rem;
        }

        .pt-card {
            display: flex;
            align-items: center;
            justify-content: space-between;
            background: #151720;
            border: 1px solid rgba(255, 255, 255, 0.08);
            border-radius: 12px;
            padding: 1.15rem 1.35rem;
            cursor: pointer;
            transition: all 0.25s ease;
            width: 100%;
            max-width: 100%;
            box-sizing: border-box;
            gap: 0.85rem;
        }

        .pt-card:hover {
            transform: translateY(-2px);
            border-color: rgba(155, 7, 7, 0.4);
            box-shadow: 0 8px 25px rgba(0, 0, 0, 0.35);
        }

        .pt-card-left {
            display: flex;
            align-items: center;
            gap: 0.9rem;
            text-align: left;
            flex: 1;
            min-width: 0;
        }

        .pt-card-icon {
            width: 42px;
            height: 42px;
            min-width: 42px;
            border-radius: 10px;
            background: rgba(155, 7, 7, 0.15);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #D41B23;
            flex-shrink: 0;
        }

        .pt-card-info {
            flex: 1;
            min-width: 0;
        }

        .pt-card h3 {
            margin: 0 !important;
            font-size: 1.12rem !important;
            font-weight: 500;
            color: #ffffff;
            word-break: break-word;
            overflow-wrap: break-word;
            line-height: 1.35;
        }

        .pt-card p {
            margin: 0.2rem 0 0 0 !important;
            font-size: 0.84rem !important;
            color: #a0a0aa !important;
            word-break: break-word;
            overflow-wrap: break-word;
        }

        .pt-chevron {
            color: #a0a0aa;
            font-size: 1rem;
            flex-shrink: 0;
            margin-right: 0.25rem;
        }

        .modal-overlay {
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background-color: rgba(0, 0, 0, 0.9);
            backdrop-filter: blur(8px);
            display: none;
            align-items: center;
            justify-content: center;
            z-index: 9999;
            padding: 1rem;
            box-sizing: border-box;
        }

        .modal-close-btn {
            position: absolute;
            top: 1.5rem;
            right: 1.5rem;
            background: transparent;
            border: none;
            font-size: 2.5rem;
            color: #ffffff;
            cursor: pointer;
            line-height: 1;
            transition: color 0.2s ease;
        }

        .modal-close-btn:hover {
            color: #D41B23;
        }

        .lightbox-img {
            max-width: 90%;
            max-height: 90vh;
            object-fit: contain;
            border-radius: 12px;
            box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
            border: 1px solid rgba(255, 255, 255, 0.08);
            animation: modalFadeIn 0.3s ease;
        }

        @keyframes modalFadeIn {
            from { transform: translateY(20px); opacity: 0; }
            to { transform: translateY(0); opacity: 1; }
        }

        /* Mobile Responsive Adjustments */
        @media (max-width: 640px) {
            .terms-page {
                padding: 1rem 0.75rem 2rem !important;
            }

            .terms-page .card {
                padding: 1.15rem 0.85rem !important;
                border-radius: 14px !important;
            }

            .pt-date-filter {
                flex-direction: column !important;
                align-items: stretch !important;
                gap: 0.65rem !important;
                padding: 0.75rem !important;
            }

            .pt-filter-input-wrap {
                flex-direction: column !important;
                align-items: flex-start !important;
                gap: 0.35rem !important;
                min-width: 0 !important;
                width: 100% !important;
            }

            .pt-filter-input-wrap input[type="date"] {
                width: 100% !important;
            }

            .pt-filter-reset-btn {
                width: 100% !important;
                justify-content: center !important;
                padding: 0.5rem 1rem !important;
            }

            .pt-card {
                padding: 0.85rem 0.85rem !important;
                gap: 0.6rem !important;
            }

            .pt-card-left {
                gap: 0.65rem !important;
            }

            .pt-card-icon {
                width: 36px !important;
                height: 36px !important;
                min-width: 36px !important;
                font-size: 0.95rem !important;
            }

            .pt-card h3 {
                font-size: 0.96rem !important;
            }

            .pt-card p {
                font-size: 0.78rem !important;
            }
        }
    </style>
</head>
<body>
    <div class="page-shell">
        <%- include("../partials/nav") %>

        <main class="terms-page">
            <div class="card">
                <h1>Scrim Point Tables</h1>
                <p class="meta">View standings of all recent scrims and matches</p>

                <% if (pointTables.length === 0) { %>
                    <div style="text-align: center; padding: 3rem 1rem; color: #a0a0aa;">
                        <i class="fa-solid fa-table-list" style="font-size: 3.5rem; color: #D41B23; margin-bottom: 1.5rem; display: block;"></i>
                        <h3 style="margin: 0; color: #ffffff; font-size: 1.25rem;">No Point Tables Available</h3>
                        <p style="margin: 0.5rem 0 0 0; font-size: 0.95rem;">Standings will be updated as soon as matches finish.</p>
                    </div>
                <% } else { %>
                    <!-- Date Filter Control -->
                    <div class="pt-date-filter">
                        <div class="pt-filter-input-wrap">
                            <label for="ptDatePicker" class="pt-filter-label"><i class="fa-regular fa-calendar"></i> Filter by Date:</label>
                            <input type="date" id="ptDatePicker" class="pt-filter-date-input">
                        </div>
                        <button type="button" id="resetPtFilter" class="pt-filter-reset-btn">
                            <i class="fa-solid fa-rotate-left"></i> Reset
                        </button>
                    </div>

                    <div class="pt-grid">
                        <% pointTables.forEach(pt => { %>
                            <div class="pt-card" data-date="<%= pt.date || '' %>" onclick="openPtModal('<%= imageUrl(pt.pointTableImage) %>')">
                                <div class="pt-card-left">
                                    <div class="pt-card-icon">
                                        <i class="fa-solid fa-ranking-star"></i>
                                    </div>
                                    <div class="pt-card-info">
                                        <h3><%= pt.matchTitle %></h3>
                                        <p><%= pt.categoryTitle %><% if (pt.date) { %> • <%= pt.date %><% } %></p>
                                    </div>
                                </div>
                                <i class="fa-solid fa-chevron-right pt-chevron"></i>
                            </div>
                        <% }) %>
                        
                        <!-- Empty State for Date Filter -->
                        <div id="noPtMsg" style="display: none; text-align: center; padding: 3rem 1rem; color: #a0a0aa; width: 100%;">
                            <i class="fa-regular fa-calendar-xmark" style="font-size: 3rem; color: #D41B23; margin-bottom: 1.25rem; display: block;"></i>
                            <h3 style="margin: 0; color: #ffffff; font-size: 1.2rem;">No Point Tables for this Date</h3>
                            <p style="margin: 0.5rem 0 0 0; font-size: 0.9rem;">There are no scrim standings matching the selected date.</p>
                        </div>
                    </div>
                <% } %>
            </div>
        </main>

        <%- include("../partials/footer") %>
        <%- include("../partials/bottomNav") %>
    </div>

    <!-- Image Lightbox Modal -->
    <div id="ptModal" class="modal-overlay" onclick="closePtModal()">
        <button class="modal-close-btn" onclick="closePtModal()">&times;</button>
        <img id="ptLightboxImg" class="lightbox-img" src="" alt="Point Table Standings" onclick="event.stopPropagation()">
    </div>

    <script>
        function openPtModal(src) {
            const modal = document.getElementById('ptModal');
            const img = document.getElementById('ptLightboxImg');
            img.src = src;
            modal.style.display = 'flex';
        }

        function closePtModal() {
            document.getElementById('ptModal').style.display = 'none';
        }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closePtModal();
            }
        });

        document.addEventListener("DOMContentLoaded", function() {
            const ptDatePicker = document.getElementById('ptDatePicker');
            const resetPtFilter = document.getElementById('resetPtFilter');
            const ptCards = document.querySelectorAll('.pt-card');
            const noPtMsg = document.getElementById('noPtMsg');

            function filterPt(dateVal) {
                let visibleCount = 0;
                ptCards.forEach(card => {
                    const cardDate = card.getAttribute('data-date');
                    if (!dateVal || cardDate === dateVal) {
                        card.style.display = 'flex';
                        visibleCount++;
                    } else {
                        card.style.display = 'none';
                    }
                });

                if (noPtMsg) {
                    noPtMsg.style.display = visibleCount === 0 ? 'block' : 'none';
                }
            }

            if (ptDatePicker) {
                ptDatePicker.addEventListener('change', function() {
                    filterPt(this.value);
                });
            }

            if (resetPtFilter) {
                resetPtFilter.addEventListener('click', function() {
                    if (ptDatePicker) ptDatePicker.value = '';
                    filterPt(null);
                });
            }
        });
    </script>
</body>
</html>
